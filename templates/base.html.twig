<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SocietyApp{% endblock %}</title>
    
    <!-- Professional Typography: Inter for UI, Lexend for Headings -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@400;600;700&display=swap" rel="stylesheet">
    
    <link href="{{ basePath }}assets/dist/output.css" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, h4, .font-heading { font-family: 'Lexend', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.3); }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 selection:bg-indigo-100 selection:text-indigo-700">
    <!-- Sophisticated Navbar -->
    <header class="fixed top-0 left-0 right-0 z-[100] transition-all duration-300">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="glass rounded-2xl px-6 py-3 flex items-center justify-between shadow-sm border border-slate-200/60">
                <div class="flex items-center gap-2">
                    <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center shadow-indigo-200 shadow-lg">
                        <i data-lucide="building-2" class="w-6 h-6 text-white"></i>
                    </div>
                    <a href="{{ basePath }}index.php" class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-slate-900 to-slate-700 tracking-tight">SocietyApp</a>
                </div>
                
                <div class="hidden md:flex items-center gap-8">
                    <a href="{{ basePath }}index.php#features" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">Features</a>
                    <a href="{{ basePath }}index.php#about" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">About</a>
                    <div class="h-4 w-[1px] bg-slate-200"></div>
                    <a href="{{ basePath }}auth/login.php" class="text-sm font-semibold text-slate-700 hover:text-indigo-600 transition-colors">Login</a>
                    <a href="{{ basePath }}auth/register.php" class="bg-slate-900 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-slate-800 hover:shadow-lg active:scale-95 transition-all">Get Started</a>
                </div>
                
                <button class="md:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
            </div>
        </nav>
    </header>

    <main class="pt-24">
        {% block content %}{% endblock %}
    </main>

    <!-- Professional Footer -->
    <footer class="bg-white border-t border-slate-200 pt-20 pb-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
                <div class="col-span-1 md:col-span-1">
                    <div class="flex items-center gap-2 mb-6">
                        <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                            <i data-lucide="building-2" class="w-5 h-5 text-white"></i>
                        </div>
                        <span class="text-xl font-bold text-slate-900">SocietyApp</span>
                    </div>
                    <p class="text-slate-500 text-sm leading-relaxed mb-6">
                        Streamlining residential management with high-end digital solutions for modern communities.
                    </p>
                    <div class="flex gap-4">
                        <a href="#" class="p-2 bg-slate-50 hover:bg-indigo-50 hover:text-indigo-600 rounded-lg transition-all text-slate-400"><i data-lucide="twitter" class="w-5 h-5"></i></a>
                        <a href="#" class="p-2 bg-slate-50 hover:bg-indigo-50 hover:text-indigo-600 rounded-lg transition-all text-slate-400"><i data-lucide="facebook" class="w-5 h-5"></i></a>
                        <a href="#" class="p-2 bg-slate-50 hover:bg-indigo-50 hover:text-indigo-600 rounded-lg transition-all text-slate-400"><i data-lucide="linkedin" class="w-5 h-5"></i></a>
                    </div>
                </div>
                
                <div>
                    <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-6">Product</h4>
                    <ul class="space-y-4">
                        <li><a href="#features" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">Features</a></li>
                        <li><a href="#" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">Security</a></li>
                        <li><a href="#" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">PWA Guide</a></li>
                    </ul>
                </div>
                
                <div>
                    <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-6">Company</h4>
                    <ul class="space-y-4">
                        <li><a href="#" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">About Us</a></li>
                        <li><a href="#" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">Privacy Policy</a></li>
                        <li><a href="#" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">Terms</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-6">Support</h4>
                    <ul class="space-y-4">
                        <li><a href="#" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">Help Center</a></li>
                        <li><a href="#" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">Contact Sales</a></li>
                        <li><a href="#" class="text-sm text-slate-500 hover:text-indigo-600 transition-colors">API Status</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="pt-8 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-xs text-slate-400">&copy; {{ "now"|date("Y") }} SocietyApp. All rights reserved.</p>
                <div class="flex gap-6 text-xs text-slate-400">
                    <a href="#" class="hover:text-slate-600 transition-colors">Privacy</a>
                    <a href="#" class="hover:text-slate-600 transition-colors">Terms</a>
                    <a href="#" class="hover:text-slate-600 transition-colors">Cookies</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        lucide.createIcons();
        
        // Sticky Header Effect
        window.addEventListener('scroll', function() {
            const header = document.querySelector('header');
            if (window.scrollY > 20) {
                header.classList.add('py-2');
                header.querySelector('nav').classList.remove('py-4');
            } else {
                header.classList.remove('py-2');
                header.querySelector('nav').classList.add('py-4');
            }
        });
    </script>
</body>
</html>
