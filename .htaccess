RewriteEngine On

# Deny access to sensitive directories
RewriteRule ^(app|config|vendor|docs|\.git|\.ddev) - [F,L]

# Rewrite /assets/* to /public/assets/* (when DocumentRoot = project root)
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# Rewrite public root files when DocumentRoot = project root
RewriteRule ^(favicon\.ico)$ public/assets/icons/logo.svg [L]
RewriteRule ^(manifest\.json|sw\.js|offline\.html)$ public/$1 [L]

# Serve existing files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve existing directories directly
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else to public/index.php
RewriteRule ^ public/index.php [L,QSA]
