{
  "name": "societyapp",
  "version": "1.0.0",
  "description": "A modern, responsive, and PWA-ready management system for housing societies. This application is a rebuild of the original SocietyApp, modernized with Plain PHP, Tailwind CSS, and offline capabilities.",
  "main": "tailwind.config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tailwindcss -i ./public/assets/src/input.css -o ./public/assets/dist/output.css",
    "build:vite": "vite build",
    "watch": "tailwindcss -i ./public/assets/src/input.css -o ./public/assets/dist/output.css --watch",
    "test": "vite build --mode test",
    "screenshots": "node scripts/capture-all-screenshots.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahankals/societyapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mahankals/societyapp/issues"
  },
  "homepage": "https://github.com/mahankals/societyapp#readme",
  "devDependencies": {
    "@parcel/watcher-linux-x64-glibc": "^2.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
