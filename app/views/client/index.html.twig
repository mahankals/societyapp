{% extends "layouts/base.html.twig" %}

{% block title %}Dashboard | SocietyApp{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="min-h-screen pt-20">
    <nav class="glass-panel mx-4 mt-4 rounded-2xl px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center">
                <i data-lucide="building-2" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-white">Welcome, {{ user.name }}</h1>
                <p class="text-sm text-surface-200/40">Resident Dashboard</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button class="flex items-center gap-2 px-4 py-2 text-sm text-surface-200/60 hover:text-white hover:bg-white/5 rounded-lg transition-all">
                <i data-lucide="bell" class="w-4 h-4"></i>
            </button>
            <a href="{{ basePath }}auth/logout" class="flex items-center gap-2 px-4 py-2 text-sm text-surface-200/60 hover:text-white hover:bg-white/5 rounded-lg transition-all">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                Sign out
            </a>
        </div>
    </nav>

    {% if flash %}
    <div class="mx-4 mt-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all cursor-pointer group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center">
                    <i data-lucide="receipt" class="w-6 h-6 text-blue-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Maintenance</h3>
            <p class="text-sm text-surface-200/40 mb-4">View and pay your monthly maintenance bills</p>
            <div class="flex items-center gap-2 text-sm text-brand-400">
                <span>View Bills</span>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all cursor-pointer group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-purple-500/20 flex items-center justify-center">
                    <i data-lucide="users" class="w-6 h-6 text-purple-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Society Directory</h3>
            <p class="text-sm text-surface-200/40 mb-4">Find contact information for residents and committees</p>
            <div class="flex items-center gap-2 text-sm text-brand-400">
                <span>Browse Directory</span>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all cursor-pointer group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-orange-500/20 flex items-center justify-center">
                    <i data-lucide="wrench" class="w-6 h-6 text-orange-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Service Requests</h3>
            <p class="text-sm text-surface-200/40 mb-4">Submit and track maintenance service requests</p>
            <div class="flex items-center gap-2 text-sm text-brand-400">
                <span>New Request</span>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all cursor-pointer group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center">
                    <i data-lucide="calendar" class="w-6 h-6 text-green-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Events</h3>
            <p class="text-sm text-surface-200/40 mb-4">View upcoming society events and meetings</p>
            <div class="flex items-center gap-2 text-sm text-brand-400">
                <span>View Calendar</span>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all cursor-pointer group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center">
                    <i data-lucide="alert-triangle" class="w-6 h-6 text-red-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Complaints</h3>
            <p class="text-sm text-surface-200/40 mb-4">Report issues and track complaint resolution</p>
            <div class="flex items-center gap-2 text-sm text-brand-400">
                <span>File Complaint</span>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all cursor-pointer group">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-cyan-500/20 flex items-center justify-center">
                    <i data-lucide="message-square" class="w-6 h-6 text-cyan-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Notices</h3>
            <p class="text-sm text-surface-200/40 mb-4">Stay updated with society announcements</p>
            <div class="flex items-center gap-2 text-sm text-brand-400">
                <span>Read Notices</span>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
