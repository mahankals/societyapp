{% extends "layouts/base.html.twig" %}

{% block title %}Notifications | SocietyApp{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="min-h-screen pt-20 px-4">
    <nav class="glass-panel mx-4 mt-4 rounded-2xl px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <a href="/client" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
            </a>
            <div>
                <h1 class="text-lg font-bold text-white">Notifications</h1>
                <p class="text-sm text-surface-200/40">{{ notifications|length }} notifications</p>
            </div>
        </div>
        <form method="POST" action="/client/notifications/mark-read">
            <input type="hidden" name="csrf_token" value="{{ csrfToken() }}">
            <button type="submit" class="flex items-center gap-2 px-4 py-2 text-sm text-surface-200/60 hover:text-white hover:bg-white/5 rounded-lg transition-all">
                <i data-lucide="check-check" class="w-4 h-4"></i>
                Mark all read
            </button>
        </form>
    </nav>

    {% if flash %}
    <div class="mx-4 mt-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="mt-4 space-y-2">
        {% for notification in notifications %}
        <div class="glass-panel rounded-2xl p-4 flex items-start gap-4 {% if not notification.is_read %}border-l-4 border-l-brand-500{% endif %}">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0
                {% if notification.type == 'warning' %}bg-yellow-500/20 text-yellow-400
                {% elseif notification.type == 'success' %}bg-green-500/20 text-green-400
                {% elseif notification.type == 'error' %}bg-red-500/20 text-red-400
                {% elseif notification.type == 'announcement' %}bg-purple-500/20 text-purple-400
                {% else %}bg-blue-500/20 text-blue-400{% endif %}">
                <i data-lucide="{% if notification.type == 'warning' %}alert-triangle{% elseif notification.type == 'success' %}check-circle{% elseif notification.type == 'error' %}x-circle{% elseif notification.type == 'announcement' %}megaphone{% else %}info{% endif %}" class="w-5 h-5"></i>
            </div>
            <div class="flex-1 min-w-0">
                <h3 class="text-white font-medium">{{ notification.title }}</h3>
                <p class="text-sm text-surface-200/50 mt-1">{{ notification.message }}</p>
                <p class="text-xs text-surface-200/30 mt-2">{{ notification.created_at|date('M d, Y h:i A') }}</p>
            </div>
            {% if not notification.is_read %}
            <div class="w-2 h-2 rounded-full bg-brand-500 flex-shrink-0 mt-2"></div>
            {% endif %}
        </div>
        {% else %}
        <div class="glass-panel rounded-2xl p-8 text-center">
            <div class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="bell-off" class="w-8 h-8 text-surface-200/30"></i>
            </div>
            <h3 class="text-white font-medium mb-2">No notifications</h3>
            <p class="text-sm text-surface-200/50">You're all caught up!</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
