{% extends "layouts/base.html.twig" %}

{% block title %}My Documents | SocietyApp{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="min-h-screen pt-20 px-4">
    <nav class="glass-panel mx-4 mt-4 rounded-2xl px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <a href="/client" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
            </a>
            <div>
                <h1 class="text-lg font-bold text-white">Documents</h1>
                <p class="text-sm text-surface-200/40">Upload and manage your documents</p>
            </div>
        </div>
    </nav>

    {% if flash %}
    <div class="mx-4 mt-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for doc in documents %}
        <div class="glass-panel rounded-2xl p-4">
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="file-text" class="w-5 h-5 text-surface-200/60"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-white font-medium truncate">{{ doc.name }}</h3>
                    <p class="text-xs text-surface-200/40 mt-1">{{ (doc.file_size / 1024)|round(1) }} KB</p>
                </div>
            </div>
            <div class="flex items-center gap-2 mt-4">
                <span class="px-2 py-1 rounded-lg text-xs font-medium {% if doc.is_verified %}bg-green-500/20 text-green-400{% else %}bg-yellow-500/20 text-yellow-400{% endif %}">
                    {% if doc.is_verified %}Verified{% else %}Pending{% endif %}
                </span>
                <span class="text-xs text-surface-200/30 ml-auto">{{ doc.created_at|date('M d, Y') }}</span>
            </div>
        </div>
        {% else %}
        <div class="col-span-full glass-panel rounded-2xl p-8 text-center">
            <div class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="folder-open" class="w-8 h-8 text-surface-200/30"></i>
            </div>
            <h3 class="text-white font-medium mb-2">No documents</h3>
            <p class="text-sm text-surface-200/50">Upload your first document</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
