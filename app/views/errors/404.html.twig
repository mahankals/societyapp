{% extends "layouts/error.html.twig" %}

{% block title %}404 - Page Not Found | SocietyApp{% endblock %}

{% block content %}
<style>
    .error-gradient {
        background: radial-gradient(ellipse at 50% 0%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
                    radial-gradient(ellipse at 80% 50%, rgba(139, 92, 246, 0.1) 0%, transparent 40%),
                    radial-gradient(ellipse at 20% 80%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
    }
</style>

<div class="min-h-screen flex items-center justify-center error-gradient px-4">
    <div class="text-center max-w-lg">
        <div class="relative mb-8">
            <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-48 h-48 rounded-full bg-brand-500/10 blur-3xl"></div>
            </div>
            <div class="relative">
                <div class="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/20 mb-6">
                    <i data-lucide="search-x" class="w-12 h-12 text-brand-400"></i>
                </div>
            </div>
        </div>

        <div class="relative mb-8">
            <span class="text-[8rem] sm:text-[10rem] font-extrabold gradient-text leading-none select-none">404</span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-bold text-white mb-3">Page not found</h1>
        <p class="text-white/50 text-lg mb-8 max-w-md mx-auto">
            The page you're looking for doesn't exist or has been moved. Let's get you back on track.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/" class="btn-primary !py-3.5 !px-8 !rounded-xl">
                <i data-lucide="home" class="w-5 h-5"></i>
                Go Home
            </a>
            <a href="javascript:history.back()" class="inline-flex items-center justify-center gap-2 h-14 px-8 bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.08] rounded-xl text-white font-medium transition-all hover:border-white/[0.15]">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
                Go Back
            </a>
        </div>

        <div class="mt-12 pt-8 border-t border-white/5">
            <p class="text-sm text-white/30">Need help?</p>
            <a href="mailto:support@societyapp.com" class="text-sm text-brand-400 hover:text-brand-300 transition-colors">
                Contact Support
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
