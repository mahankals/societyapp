{% extends "layouts/mobile.html.twig" %}

{% block title %}Members Directory | {{ society.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/comitee" class="text-xs text-brand-400 hover:underline">← Committee Dashboard</a>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Society Members & Roles</h1>
            <p class="text-xs text-surface-200/60">{{ society.name }} &middot; {{ members|length }} Registered Members</p>
        </div>

        <button type="button" onclick="document.getElementById('assignModal').classList.remove('hidden')" class="btn-primary !px-4 !py-2.5 flex items-center gap-2 text-xs font-semibold">
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            <span>Assign Member to Flat</span>
        </button>
    </div>

    {% if flash.success %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}
    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <!-- Members Table -->
    <div class="glass-panel rounded-2xl overflow-hidden border border-white/10">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-surface-200/80">
                <thead class="text-xs uppercase bg-white/[0.03] text-surface-200/60 border-b border-white/5">
                    <tr>
                        <th class="py-3.5 px-4 font-semibold">Member Name</th>
                        <th class="py-3.5 px-4 font-semibold">Assigned Flat</th>
                        <th class="py-3.5 px-4 font-semibold">Contact Info</th>
                        <th class="py-3.5 px-4 font-semibold">Role & Designation</th>
                        <th class="py-3.5 px-4 font-semibold">Status</th>
                        <th class="py-3.5 px-4 text-right font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {% for m in members %}
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="py-3.5 px-4">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500/30 to-brand-700/20 text-brand-300 flex items-center justify-center font-bold text-xs">
                                    {{ m.member_name|first|upper }}
                                </div>
                                <span class="font-medium text-white">{{ m.member_name }}</span>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 font-mono font-semibold text-white">
                            {% if m.flat_no %}
                            {{ m.wing }}-{{ m.flat_no }}
                            {% else %}
                            <span class="text-xs text-surface-200/40 italic">Not Assigned</span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-xs">
                            <p class="text-white">{{ m.member_phone ?: '-' }}</p>
                            <p class="text-surface-200/50">{{ m.member_email }}</p>
                        </td>
                        <td class="py-3.5 px-4">
                            {% if m.role in ['chairman', 'secretary', 'treasurer', 'committee'] %}
                            <span class="text-xs px-2.5 py-0.5 rounded-full bg-brand-500/20 text-brand-400 border border-brand-500/30 font-medium capitalize">
                                {{ m.role }} (Committee)
                            </span>
                            {% elseif m.role == 'tenant' %}
                            <span class="text-xs px-2.5 py-0.5 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30 font-medium">
                                Tenant
                            </span>
                            {% else %}
                            <span class="text-xs px-2.5 py-0.5 rounded-full bg-white/10 text-surface-200 border border-white/10 font-medium">
                                Flat Owner
                            </span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="text-[11px] px-2 py-0.5 rounded-full {{ m.status == 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20' }}">
                                {{ m.status|capitalize }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <form action="/comitee/members/{{ m.id }}/unlink" method="POST" onsubmit="return confirm('Unlink {{ m.member_name }} from flat?')">
                                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                <button type="submit" class="px-2.5 py-1 rounded-lg border border-rose-500/20 hover:bg-rose-500/10 text-rose-400 text-xs transition-colors">
                                    Unlink
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="py-8 text-center text-surface-200/50">No members registered in this society yet.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Assign Member Modal -->
<div id="assignModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="glass-panel rounded-2xl max-w-md w-full p-6 border border-white/10 bg-surface-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
            <h3 class="text-base font-bold text-white">Assign Member to Flat</h3>
            <button type="button" onclick="document.getElementById('assignModal').classList.add('hidden')" class="text-surface-200/50 hover:text-white">✕</button>
        </div>

        <form action="/comitee/members/assign" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">User Email or Mobile Number</label>
                    <input type="text" name="user_identifier" placeholder="e.g. resident@societyapp.com or +91 98765 43210" required class="input-glass w-full text-sm">
                    <p class="text-[11px] text-surface-200/40 mt-1">User must already have an account on SocietyApp.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Select Flat</label>
                    <select name="flat_id" required class="input-glass w-full text-sm font-mono">
                        <option value="">-- Choose Flat --</option>
                        {% for f in vacantFlats %}
                        <option value="{{ f.id }}">Flat {{ f.wing }}-{{ f.flat_no }} ({{ f.flat_type }}, {{ f.area_sqft }} sqft)</option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Role / Designation</label>
                    <select name="role" class="input-glass w-full text-sm">
                        <option value="owner" selected>Flat Owner / Resident</option>
                        <option value="tenant">Tenant</option>
                        <option value="secretary">Secretary (Committee)</option>
                        <option value="chairman">Chairman (Committee)</option>
                        <option value="treasurer">Treasurer (Committee)</option>
                        <option value="committee">Managing Committee Member</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('assignModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-white/10 hover:bg-white/5 text-xs text-surface-200/80">Cancel</button>
                <button type="submit" class="btn-primary !px-5 !py-2 text-xs font-semibold">Assign Member</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
