{% extends "layouts/mobile.html.twig" %}

{% block title %}Members Directory | {{ society.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">

    <!-- Pending Requests Alert Banner at Top -->
    {% if pendingRequestsCount > 0 %}
    <div class="mb-6 p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold shrink-0">
                <i data-lucide="user-check" class="w-5 h-5"></i>
            </div>
            <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">{{ pendingRequestsCount }} Pending Resident Join Request{{ pendingRequestsCount > 1 ? 's' : '' }}</h3>
                <p class="text-xs text-slate-500 dark:text-surface-200/60">Residents have requested to link flats in {{ society.name }}. Please review and approve their access.</p>
            </div>
        </div>
        <a href="/comitee/requests" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm shrink-0">
            <span>Review Requests ({{ pendingRequestsCount }})</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
    </div>
    {% endif %}

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/comitee" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">&larr; Committee Dashboard</a>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Society Members &amp; Roles</h1>
            <p class="text-xs text-slate-500 dark:text-surface-200/60">{{ society.name }} &middot; {{ members|length }} Registered Members</p>
        </div>

        <button type="button" onclick="document.getElementById('assignModal').classList.remove('hidden')" class="btn-primary !px-4 !py-2.5 flex items-center gap-2 text-xs font-semibold">
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            <span>Assign Member to Flat</span>
        </button>
    </div>

    {% if flash.success or (flash.type == 'success') %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-sm flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4"></i>
        <span>{{ flash.success ?: flash.message }}</span>
    </div>
    {% endif %}
    {% if flash.error or (flash.type == 'error') %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>{{ flash.error ?: flash.message }}</span>
    </div>
    {% endif %}

    <!-- Search Filter Bar -->
    <div class="mb-4 flex items-center justify-between gap-4">
        <div class="relative max-w-sm w-full">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-surface-200/40 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input type="text" id="memberSearchInput" placeholder="Search members by name, flat, phone, or role..." class="input-glass w-full !pl-10 !py-2 text-xs" oninput="filterMembersTable()">
        </div>
    </div>

    <!-- Members Table -->
    <div class="bg-white dark:bg-surface-900 rounded-2xl overflow-hidden border border-slate-200 dark:border-white/10 shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700 dark:text-surface-200/80">
                <thead class="text-xs uppercase bg-slate-50 dark:bg-white/[0.03] text-slate-500 dark:text-surface-200/60 border-b border-slate-200 dark:border-white/5">
                    <tr>
                        <th class="py-3.5 px-4 font-semibold">Member Name</th>
                        <th class="py-3.5 px-4 font-semibold">Assigned Flat</th>
                        <th class="py-3.5 px-4 font-semibold">Contact Info</th>
                        <th class="py-3.5 px-4 font-semibold">Role &amp; Designation</th>
                        <th class="py-3.5 px-4 font-semibold">Status</th>
                        <th class="py-3.5 px-4 text-right font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody id="membersTableBody" class="divide-y divide-slate-100 dark:divide-white/5">
                    <tr id="membersEmptySearchRow" style="display: none;">
                        <td colspan="6" class="py-8 text-center text-xs text-slate-400 dark:text-surface-200/40">
                            No matching members found.
                        </td>
                    </tr>
                    {% for m in members %}
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02] transition-colors">
                        <td class="py-3.5 px-4">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-brand-500/15 text-brand-600 dark:text-brand-300 flex items-center justify-center font-bold text-xs">
                                    {{ m.member_name|first|upper }}
                                </div>
                                <span class="font-semibold text-slate-900 dark:text-white">{{ m.member_name }}</span>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 font-mono font-semibold text-slate-900 dark:text-white">
                            {% if m.flat_no %}
                            {{ m.wing ? m.wing ~ '-' : '' }}{{ m.flat_no }}
                            {% else %}
                            <span class="text-xs text-slate-400 dark:text-surface-200/40 italic">Not Assigned</span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-xs">
                            <p class="text-slate-900 dark:text-white font-medium">{{ m.member_phone ?: '-' }}</p>
                            <p class="text-slate-500 dark:text-surface-200/50">{{ m.member_email }}</p>
                        </td>
                        <td class="py-3.5 px-4">
                            {% if m.role in ['chairman', 'secretary', 'treasurer', 'committee'] %}
                            <span class="text-xs px-2.5 py-0.5 rounded-full bg-brand-500/15 text-brand-700 dark:text-brand-300 border border-brand-500/30 font-semibold capitalize">
                                {{ m.role }} (Committee)
                            </span>
                            {% elseif m.role == 'tenant' or m.ownership_type == 'tenant' %}
                            <span class="text-xs px-2.5 py-0.5 rounded-full bg-blue-500/15 text-blue-700 dark:text-blue-300 border border-blue-500/30 font-medium">
                                Tenant
                            </span>
                            {% else %}
                            <span class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-surface-200 border border-slate-200 dark:border-white/10 font-medium">
                                Flat Owner
                            </span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="text-[11px] px-2 py-0.5 rounded-full {{ m.status == 'active' ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20' : 'bg-amber-500/15 text-amber-700 dark:text-amber-400 border border-amber-500/20' }}">
                                {{ m.status|capitalize }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <button type="button" 
                                    onclick='openEditRoleModal({{ {
                                        id: m.id,
                                        member_name: m.member_name,
                                        flat_id: m.flat_id,
                                        role: m.role,
                                        ownership_type: m.ownership_type|default(m.role == "tenant" ? "tenant" : "owner")
                                    }|json_encode|raw }})'
                                    class="px-2.5 py-1 rounded-lg border border-brand-500/30 hover:bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-semibold transition-colors">
                                    Edit
                                </button>
                                <form action="/comitee/members/{{ m.id }}/unlink" method="POST" data-confirm="Are you sure you want to unlink {{ m.member_name }} from flat?">
                                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                    <button type="submit" class="px-2.5 py-1 rounded-lg border border-rose-500/20 hover:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs transition-colors">
                                        Unlink
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="py-8 text-center text-slate-400 dark:text-surface-200/50">No members registered in this society yet.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Edit Member Modal (Flat & Role) -->
<div id="editRoleModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm overflow-y-auto">
    <div class="bg-white dark:bg-surface-900 rounded-2xl max-w-md w-full p-6 border border-slate-200 dark:border-white/10 shadow-2xl max-h-[calc(100vh-2rem)] flex flex-col my-auto overflow-hidden">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-white/10 shrink-0">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="edit-3" class="w-4 h-4 text-brand-500"></i>
                <span>Edit Member &amp; Flat</span>
            </h3>
            <button type="button" onclick="document.getElementById('editRoleModal').classList.add('hidden')" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:text-surface-200/50 dark:hover:text-white transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form id="editRoleForm" action="" method="POST" class="mt-4 space-y-4 flex flex-col flex-1 overflow-hidden">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div>
                <p class="text-xs text-slate-500 dark:text-surface-200/60">Member:</p>
                <p id="editRoleMemberName" class="text-sm font-bold text-slate-900 dark:text-white"></p>
            </div>

            <!-- Assigned Flat Dropdown -->
            <div>
                <label for="edit_flat_select" class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Assigned Flat / Unit</label>
                <select name="flat_id" id="edit_flat_select" class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                    <option value="">-- Unassigned / No Flat --</option>
                    {% for f in allFlats %}
                    <option value="{{ f.id }}">{{ f.wing ? f.wing ~ '-' : '' }}{{ f.flat_no }} (Floor {{ f.floor|default('G') }}{% if f.flat_type %}, {{ f.flat_type }}{% endif %})</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Designation Dropdown -->
            <div>
                <label for="edit_role_select" class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Role / Designation</label>
                <select name="role" id="edit_role_select" class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                    <option value="owner">Flat Owner / Resident</option>
                    <option value="secretary">Secretary (Committee)</option>
                    <option value="chairman">Chairman (Committee)</option>
                    <option value="treasurer">Treasurer (Committee)</option>
                    <option value="committee">Managing Committee Member</option>
                    <option value="tenant" id="optRoleTenant">Tenant</option>
                </select>
                <p id="tenantRoleNote" class="hidden mt-2 text-[11px] text-amber-600 dark:text-amber-400 leading-relaxed">
                    Note: Tenants cannot hold committee roles (Chairman, Secretary, Treasurer). Only flat owners are eligible for committee positions.
                </p>
            </div>

            <div class="flex justify-end gap-2 pt-4 border-t border-slate-100 dark:border-white/10 mt-auto shrink-0">
                <button type="button" onclick="document.getElementById('editRoleModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/5 text-xs text-slate-700 dark:text-surface-200/80">Cancel</button>
                <button type="submit" class="btn-primary !px-5 !py-2 text-xs font-semibold">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Assign Member Modal -->
<div id="assignModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm overflow-y-auto">
    <div class="bg-white dark:bg-surface-900 rounded-2xl max-w-md w-full p-6 border border-slate-200 dark:border-white/10 shadow-2xl max-h-[calc(100vh-2rem)] flex flex-col my-auto overflow-hidden">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-white/10 shrink-0">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Assign Member to Flat</h3>
            <button type="button" onclick="document.getElementById('assignModal').classList.add('hidden')" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:text-surface-200/50 dark:hover:text-white transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form action="/comitee/members/assign" method="POST" class="overflow-y-auto flex-1 py-4 space-y-4">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Select Member / User</label>
                <select name="user_id" id="assign_user_id" class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                    <option value="">-- Choose Registered User --</option>
                    {% for u in availableUsers %}
                    <option value="{{ u.id }}">
                        {{ u.name }} ({{ u.email }}{% if u.phone %} &middot; {{ u.phone }}{% endif %})
                    </option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Select Vacant Flat</label>
                <select name="flat_id" required class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                    <option value="">-- Choose Flat --</option>
                    {% for f in vacantFlats %}
                    <option value="{{ f.id }}">{{ f.wing }}-{{ f.flat_no }} ({{ f.flat_type|default('Flat') }})</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Ownership Type</label>
                <select name="ownership_type" class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                    <option value="owner">Flat Owner</option>
                    <option value="tenant">Tenant</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Role / Designation</label>
                <select name="role" class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                    <option value="owner">Member</option>
                    <option value="committee">Committee Member</option>
                    <option value="treasurer">Treasurer</option>
                    <option value="secretary">Secretary</option>
                    <option value="chairman">Chairman</option>
                </select>
            </div>

            <div class="flex justify-end gap-2 pt-4 border-t border-slate-100 dark:border-white/10 mt-auto shrink-0">
                <button type="button" onclick="document.getElementById('assignModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/5 text-xs text-slate-700 dark:text-surface-200/80">Cancel</button>
                <button type="submit" class="btn-primary !px-5 !py-2 text-xs font-semibold">Assign Flat</button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
function openEditRoleModal(m) {
    if (!m) return;
    const form = document.getElementById('editRoleForm');
    form.action = '/comitee/members/' + m.id + '/role';
    document.getElementById('editRoleMemberName').textContent = m.member_name;

    const flatSelect = document.getElementById('edit_flat_select');
    if (flatSelect) {
        flatSelect.value = m.flat_id ? String(m.flat_id) : '';
    }

    const select = document.getElementById('edit_role_select');
    select.value = m.role || 'owner';

    const isTenant = (m.ownership_type === 'tenant' || m.role === 'tenant');
    const note = document.getElementById('tenantRoleNote');

    // If tenant, disable committee options
    Array.from(select.options).forEach(opt => {
        if (['chairman', 'secretary', 'treasurer', 'committee'].includes(opt.value)) {
            opt.disabled = isTenant;
        }
    });

    if (isTenant) {
        note.classList.remove('hidden');
    } else {
        note.classList.add('hidden');
    }

    document.getElementById('editRoleModal').classList.remove('hidden');
    if (window.lucide) { lucide.createIcons(); }
}

if (window.lucide) { lucide.createIcons(); }

function filterMembersTable() {
    const q = (document.getElementById('memberSearchInput').value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('#membersTableBody tr');
    let visible = 0;
    rows.forEach(r => {
        if (r.id === 'membersEmptySearchRow') return;
        const text = r.textContent.toLowerCase();
        if (!q || text.includes(q)) {
            r.style.display = '';
            visible++;
        } else {
            r.style.display = 'none';
        }
    });
    const emptyRow = document.getElementById('membersEmptySearchRow');
    if (emptyRow) {
        emptyRow.style.display = (visible === 0) ? '' : 'none';
    }
}
</script>
{% endblock %}
