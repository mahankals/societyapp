{% extends "layouts/mobile.html.twig" %}

{% block title %}Flats Management | {{ society.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/comitee" class="text-xs text-brand-400 hover:underline">← Committee Dashboard</a>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Flats Management</h1>
            <p class="text-xs text-surface-200/60">{{ society.name }} &middot; {{ flats|length }} Total Registered Flats</p>
        </div>

        <button type="button" onclick="document.getElementById('addFlatModal').classList.remove('hidden')" class="btn-primary !px-4 !py-2.5 flex items-center gap-2 text-xs font-semibold">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Add New Flat</span>
        </button>
    </div>

    {% if flash.success %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}
    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <!-- Real-time Search Filter Bar -->
    <div class="mb-4 flex items-center justify-between gap-4">
        <div class="relative max-w-sm w-full">
            <i data-lucide="search" class="w-4 h-4 text-surface-200/40 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input type="text" id="flatSearchInput" placeholder="Search flats by unit, wing, occupant, or type..." class="input-glass w-full !pl-10 !py-2 text-xs" oninput="filterFlatsTable()">
        </div>
    </div>

    <!-- Flats Table -->
    <div class="glass-panel rounded-2xl overflow-hidden border border-white/10">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-surface-200/80">
                <thead class="text-xs uppercase bg-white/[0.03] text-surface-200/60 border-b border-white/5">
                    <tr>
                        <th class="py-3.5 px-4 font-semibold">Unit Number</th>
                        <th class="py-3.5 px-4 font-semibold">Wing / Floor</th>
                        <th class="py-3.5 px-4 font-semibold">Area & Type</th>
                        <th class="py-3.5 px-4 font-semibold">Occupant / Resident</th>
                        <th class="py-3.5 px-4 font-semibold">Status</th>
                        <th class="py-3.5 px-4 text-right font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody id="flatsTableBody" class="divide-y divide-white/5">
                    <tr id="flatsEmptySearchRow" style="display: none;">
                        <td colspan="6" class="py-8 text-center text-xs text-surface-200/40">
                            No matching flats found.
                        </td>
                    </tr>
                    {% for flat in flats %}
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="py-3.5 px-4 font-mono font-bold text-white">
                            {{ flat.wing }}-{{ flat.flat_no }}
                        </td>
                        <td class="py-3.5 px-4 text-xs">
                            Wing {{ flat.wing }} &middot; Floor {{ flat.floor ?: '-' }}
                        </td>
                        <td class="py-3.5 px-4 text-xs font-mono">
                            {{ flat.area_sqft }} sqft &middot; {{ flat.flat_type }}
                        </td>
                        <td class="py-3.5 px-4">
                            {% if flat.member_name %}
                            <div class="text-xs">
                                <p class="font-medium text-white">{{ flat.member_name }}</p>
                                <p class="text-surface-200/50">{{ flat.member_phone ?: flat.member_email }}</p>
                            </div>
                            {% else %}
                            <span class="text-xs text-surface-200/40 italic">Vacant</span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="text-[11px] px-2 py-0.5 rounded-full {{ flat.member_name ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-surface-700/50 text-surface-300' }}">
                                {{ flat.member_name ? 'Occupied' : 'Vacant' }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <button type="button" 
                                    onclick='openEditFlatModal({{ {
                                        id: flat.id,
                                        wing: flat.wing,
                                        flat_no: flat.flat_no,
                                        floor: flat.floor,
                                        area_sqft: flat.area_sqft,
                                        flat_type: flat.flat_type
                                    }|json_encode|raw }})' 
                                    class="p-1.5 rounded-lg hover:bg-brand-500/15 text-surface-200/50 hover:text-brand-300 transition-colors" 
                                    title="Edit Flat">
                                    <i data-lucide="edit-2" class="w-4 h-4"></i>
                                </button>
                                <form action="/comitee/flats/{{ flat.id }}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete flat {{ flat.wing }}-{{ flat.flat_no }}?')">
                                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                    <button type="submit" class="p-1.5 rounded-lg hover:bg-rose-500/10 text-surface-200/50 hover:text-rose-400 transition-colors" title="Delete Flat">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="py-8 text-center text-surface-200/50">No flats found in this society yet. Click "Add New Flat" above to get started.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Add Flat Modal -->
<div id="addFlatModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="glass-panel rounded-2xl max-w-md w-full p-6 border border-white/10 bg-surface-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4 text-brand-400"></i>
                <span>Add New Flat</span>
            </h3>
            <button type="button" onclick="document.getElementById('addFlatModal').classList.add('hidden')" class="text-surface-200/50 hover:text-white">✕</button>
        </div>

        <form action="/comitee/flats" method="POST" id="addFlatForm">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div class="space-y-4 mb-6">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Wing</label>
                        <input type="text" id="add_wing" name="wing" value="A" required class="input-glass w-full text-sm font-mono uppercase">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Flat Number</label>
                        <input type="text" id="add_flat_no" name="flat_no" placeholder="101" required class="input-glass w-full text-sm font-mono">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Floor</label>
                        <input type="text" id="add_floor" name="floor" placeholder="1" class="input-glass w-full text-sm font-mono">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Area (sq. ft.)</label>
                        <input type="number" step="0.01" id="add_area_sqft" name="area_sqft" value="850.00" class="input-glass w-full text-sm font-mono">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Flat Type</label>
                    <select id="add_flat_type" name="flat_type" class="input-glass w-full text-sm">
                        <option value="1BHK">1 BHK</option>
                        <option value="2BHK" selected>2 BHK</option>
                        <option value="3BHK">3 BHK</option>
                        <option value="4BHK">4 BHK / Penthouse</option>
                        <option value="Shop">Commercial Shop</option>
                        <option value="Office">Office Unit</option>
                    </select>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-2 pt-2 border-t border-white/5">
                <button type="button" onclick="document.getElementById('addFlatModal').classList.add('hidden')" class="px-3.5 py-2 rounded-xl border border-white/10 hover:bg-white/5 text-xs text-surface-200/80">Cancel</button>
                <button type="submit" name="action" value="save_and_add_more" class="px-3.5 py-2 rounded-xl bg-brand-500/20 hover:bg-brand-500/30 text-xs font-semibold text-brand-300 hover:text-white border border-brand-500/40 transition-all flex items-center gap-1.5 shadow-sm">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>Save &amp; Add More</span>
                </button>
                <button type="submit" name="action" value="save" class="btn-primary !px-4 !py-2 text-xs font-semibold">Save Flat</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Flat Modal -->
<div id="editFlatModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="glass-panel rounded-2xl max-w-md w-full p-6 border border-white/10 bg-surface-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
            <h3 id="editFlatModalTitle" class="text-base font-bold text-white flex items-center gap-2">
                <i data-lucide="edit-2" class="w-4 h-4 text-brand-400"></i>
                <span>Edit Flat</span>
            </h3>
            <button type="button" onclick="document.getElementById('editFlatModal').classList.add('hidden')" class="text-surface-200/50 hover:text-white">✕</button>
        </div>

        <form id="editFlatForm" action="" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <input type="hidden" id="edit_flat_id" name="flat_id" value="">

            <div class="space-y-4 mb-6">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Wing</label>
                        <input type="text" id="edit_wing" name="wing" required class="input-glass w-full text-sm font-mono uppercase">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Flat Number</label>
                        <input type="text" id="edit_flat_no" name="flat_no" required class="input-glass w-full text-sm font-mono">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Floor</label>
                        <input type="text" id="edit_floor" name="floor" class="input-glass w-full text-sm font-mono">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Area (sq. ft.)</label>
                        <input type="number" step="0.01" id="edit_area_sqft" name="area_sqft" class="input-glass w-full text-sm font-mono">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Flat Type</label>
                    <select id="edit_flat_type" name="flat_type" class="input-glass w-full text-sm">
                        <option value="1BHK">1 BHK</option>
                        <option value="2BHK">2 BHK</option>
                        <option value="3BHK">3 BHK</option>
                        <option value="4BHK">4 BHK / Penthouse</option>
                        <option value="Shop">Commercial Shop</option>
                        <option value="Office">Office Unit</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2 border-t border-white/5">
                <button type="button" onclick="document.getElementById('editFlatModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-white/10 hover:bg-white/5 text-xs text-surface-200/80">Cancel</button>
                <button type="submit" class="btn-primary !px-5 !py-2 text-xs font-semibold flex items-center gap-1.5">
                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                    <span>Update Flat</span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    function openEditFlatModal(flat) {
        if (!flat) return;
        document.getElementById('edit_flat_id').value = flat.id;
        document.getElementById('edit_wing').value = flat.wing;
        document.getElementById('edit_flat_no').value = flat.flat_no;
        document.getElementById('edit_floor').value = flat.floor || '';
        document.getElementById('edit_area_sqft').value = flat.area_sqft || '';
        document.getElementById('edit_flat_type').value = flat.flat_type || '2BHK';
        document.getElementById('editFlatForm').action = '/comitee/flats/' + flat.id + '/update';
        document.getElementById('editFlatModalTitle').innerHTML = '<i data-lucide="edit-2" class="w-4 h-4 text-brand-400"></i><span>Edit Flat ' + flat.wing + '-' + flat.flat_no + '</span>';
        document.getElementById('editFlatModal').classList.remove('hidden');
        if (window.lucide) { lucide.createIcons(); }
    }

    // Auto-open Add Flat modal if redirected with add_more query parameter
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('add_more') === '1') {
            const addModal = document.getElementById('addFlatModal');
            if (addModal) {
                addModal.classList.remove('hidden');
                if (urlParams.get('wing')) {
                    document.getElementById('add_wing').value = urlParams.get('wing');
                }
                if (urlParams.get('floor')) {
                    document.getElementById('add_floor').value = urlParams.get('floor');
                }
                if (urlParams.get('area_sqft')) {
                    document.getElementById('add_area_sqft').value = urlParams.get('area_sqft');
                }
                if (urlParams.get('flat_type')) {
                    document.getElementById('add_flat_type').value = urlParams.get('flat_type');
                }
                const flatInput = document.getElementById('add_flat_no');
                if (flatInput) {
                    flatInput.value = '';
                    flatInput.focus();
                }
            }
        }
    });

    function filterFlatsTable() {
        const q = (document.getElementById('flatSearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#flatsTableBody tr');
        let visible = 0;
        rows.forEach(r => {
            if (r.id === 'flatsEmptySearchRow') return;
            const text = r.textContent.toLowerCase();
            if (!q || text.includes(q)) {
                r.style.display = '';
                visible++;
            } else {
                r.style.display = 'none';
            }
        });
        const emptyRow = document.getElementById('flatsEmptySearchRow');
        if (emptyRow) {
            emptyRow.style.display = (visible === 0) ? '' : 'none';
        }
    }
</script>
{% endblock %}
