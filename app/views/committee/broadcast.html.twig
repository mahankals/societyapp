{% extends "layouts/mobile.html.twig" %}

{% block title %}Broadcast Notices | {{ society.name }}{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto px-4 sm:px-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/comitee" class="text-xs text-brand-400 hover:underline">← Committee Dashboard</a>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Society Notices & Broadcast</h1>
            <p class="text-xs text-surface-200/60">{{ society.name }} &middot; Send circulars, alerts and updates to all active residents</p>
        </div>

        <div class="flex items-center gap-3">
            <div class="px-3.5 py-2 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2 text-xs text-surface-200/80">
                <i data-lucide="users" class="w-4 h-4 text-brand-400"></i>
                <span>Reach: <strong class="text-white">{{ totalResidents }} active resident{{ totalResidents == 1 ? '' : 's' }}</strong></span>
            </div>
        </div>
    </div>

    {% if flash.success %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4 flex-shrink-0"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}
    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Send Broadcast Column -->
        <div class="lg:col-span-5">
            <div class="glass-panel rounded-2xl p-6 border border-white/10 sticky top-24">
                <div class="flex items-center gap-2.5 mb-4 pb-4 border-b border-white/10">
                    <div class="w-9 h-9 rounded-xl bg-brand-500/15 flex items-center justify-center text-brand-400">
                        <i data-lucide="megaphone" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="text-base font-semibold text-white">Create New Notice</h2>
                        <p class="text-[11px] text-surface-200/50">Dispatched directly to residents' notification center</p>
                    </div>
                </div>

                <form method="POST" action="/comitee/broadcast" class="space-y-4">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                    <div>
                        <label for="type" class="block text-xs font-semibold text-surface-200/70 uppercase tracking-wider mb-1.5">Notice Category</label>
                        <select id="type" name="type" required
                            class="w-full h-11 bg-surface-900 border border-white/10 rounded-xl px-3.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all">
                            <option value="announcement" class="bg-surface-900 text-white">📢 Announcement (General Update)</option>
                            <option value="info" class="bg-surface-900 text-white">ℹ️ Informational (Maintenance, Timings)</option>
                            <option value="warning" class="bg-surface-900 text-white">⚠️ Urgent Alert (Water/Power cuts, Safety)</option>
                            <option value="success" class="bg-surface-900 text-white">🎉 Event / Celebration</option>
                        </select>
                    </div>

                    <div>
                        <label for="title" class="block text-xs font-semibold text-surface-200/70 uppercase tracking-wider mb-1.5">Notice Subject / Title</label>
                        <input type="text" id="title" name="title" required
                            class="w-full h-11 bg-white/[0.04] border border-white/10 rounded-xl px-3.5 text-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                            placeholder="e.g. Annual General Body Meeting on Sunday">
                    </div>

                    <div>
                        <label for="message" class="block text-xs font-semibold text-surface-200/70 uppercase tracking-wider mb-1.5">Notice Message</label>
                        <textarea id="message" name="message" rows="5" required
                            class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-3.5 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all leading-relaxed"
                            placeholder="Provide details about date, time, agenda, or guidelines for members..."></textarea>
                    </div>

                    <div class="p-3 rounded-xl bg-brand-500/10 border border-brand-500/20 text-xs text-brand-300/90 flex items-start gap-2.5">
                        <i data-lucide="info" class="w-4 h-4 flex-shrink-0 mt-0.5 text-brand-400"></i>
                        <span>This notification will instantly appear for all <strong>{{ totalResidents }} active resident{{ totalResidents == 1 ? '' : 's' }}</strong> in {{ society.name }}.</span>
                    </div>

                    <button type="submit" class="btn-primary w-full !h-12 !text-sm !rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-brand-500/20">
                        <i data-lucide="send" class="w-4 h-4"></i>
                        <span>Broadcast Notice</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Broadcast History Column -->
        <div class="lg:col-span-7">
            <div class="glass-panel rounded-2xl p-6 border border-white/10">
                <div class="flex items-center justify-between mb-4 pb-4 border-b border-white/10">
                    <div>
                        <h2 class="text-base font-semibold text-white">Broadcast History</h2>
                        <p class="text-[11px] text-surface-200/50">Recent notices issued by the managing committee</p>
                    </div>
                    <span class="text-xs text-surface-200/60 font-medium">{{ recentBroadcasts|length }} recent</span>
                </div>

                {% if recentBroadcasts|length > 0 %}
                <div class="space-y-3.5">
                    {% for b in recentBroadcasts %}
                    <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.08] hover:border-white/20 transition-all">
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wider
                                    {% if b.type == 'warning' %}bg-amber-500/20 text-amber-300 border border-amber-500/30
                                    {% elseif b.type == 'info' %}bg-cyan-500/20 text-cyan-300 border border-cyan-500/30
                                    {% elseif b.type == 'success' %}bg-emerald-500/20 text-emerald-300 border border-emerald-500/30
                                    {% else %}bg-purple-500/20 text-purple-300 border border-purple-500/30{% endif %}">
                                    {{ b.type }}
                                </span>
                                <span class="text-xs text-surface-200/50">{{ b.created_at|date('d M Y, h:i A') }}</span>
                            </div>
                            <span class="text-[11px] text-brand-300/90 font-medium flex items-center gap-1">
                                <i data-lucide="check" class="w-3 h-3 text-brand-400"></i>
                                Sent to {{ b.sent_count }}
                            </span>
                        </div>
                        <h3 class="text-sm font-semibold text-white mb-1.5">{{ b.title }}</h3>
                        <p class="text-xs text-surface-200/70 whitespace-pre-line leading-relaxed">{{ b.message }}</p>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="text-center py-12">
                    <div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center mx-auto mb-3 text-surface-200/40">
                        <i data-lucide="inbox" class="w-6 h-6"></i>
                    </div>
                    <p class="text-sm font-medium text-white mb-1">No broadcasts sent yet</p>
                    <p class="text-xs text-surface-200/50 max-w-sm mx-auto">Use the form on the left to issue your first society-wide notice or circular to members.</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
