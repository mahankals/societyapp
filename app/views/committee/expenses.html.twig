{% extends "layouts/mobile.html.twig" %}

{% block title %}Expenses & Outflows | {{ society.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6">

    <!-- Header & Action Buttons -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/comitee" class="text-xs text-amber-400 hover:underline">← Committee Dashboard</a>
                <span class="text-xs text-surface-200/40">&middot;</span>
                <a href="/comitee/accounting" class="text-xs text-emerald-400 hover:underline">Accounting Statements →</a>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Society Expenses & Outflows</h1>
            <p class="text-xs text-surface-200/60">{{ society.name }} &middot; Track vouchers, manage expense heads, and monitor community funds.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button" onclick="document.getElementById('expenseHeadModal').classList.remove('hidden')" class="px-3.5 py-2 rounded-xl border border-amber-500/30 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 flex items-center gap-2 text-xs font-semibold transition-all">
                <i data-lucide="tag" class="w-4 h-4"></i>
                <span>+ Add Expense Head</span>
            </button>
            <button type="button" onclick="document.getElementById('expenseModal').classList.remove('hidden')" class="btn-primary !px-4 !py-2 flex items-center gap-2 text-xs font-semibold">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>Record Expense</span>
            </button>
        </div>
    </div>

    {% if flash.success or (flash.type == 'success') %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4"></i>
        <span>{{ flash.success ?: flash.message }}</span>
    </div>
    {% endif %}
    {% if flash.error or (flash.type == 'error') %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>{{ flash.error ?: flash.message }}</span>
    </div>
    {% endif %}

    <!-- Top Financial Summary Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
        <div class="glass-panel rounded-xl p-4 border border-rose-500/20 bg-rose-500/[0.03]">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-surface-200/60">Total Expenses</span>
                <i data-lucide="receipt" class="w-4 h-4 text-rose-400"></i>
            </div>
            <p class="text-xl sm:text-2xl font-bold text-white">₹{{ balanceSummary.totalExpenses|number_format(0) }}</p>
            <p class="text-[11px] text-surface-200/50 mt-1">{{ expenses|length }} recorded vouchers</p>
        </div>

        <div class="glass-panel rounded-xl p-4 border border-emerald-500/20 bg-emerald-500/[0.03]">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-surface-200/60">Society Balance</span>
                <i data-lucide="wallet" class="w-4 h-4 text-emerald-400"></i>
            </div>
            <p class="text-xl sm:text-2xl font-bold text-white">₹{{ balanceSummary.totalBalance|number_format(0) }}</p>
            <p class="text-[11px] text-emerald-400 mt-1">Available in fund</p>
        </div>

        <div class="glass-panel rounded-xl p-4">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-surface-200/60">Paid via In Hand (Cash)</span>
                <i data-lucide="banknote" class="w-4 h-4 text-amber-400"></i>
            </div>
            <p class="text-xl sm:text-2xl font-bold text-white">₹{{ balanceSummary.cashExpenses|number_format(0) }}</p>
            <p class="text-[11px] text-amber-400 mt-1">Cash in hand outflows</p>
        </div>

        <div class="glass-panel rounded-xl p-4">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-surface-200/60">Paid via Bank / UPI</span>
                <i data-lucide="landmark" class="w-4 h-4 text-cyan-400"></i>
            </div>
            <p class="text-xl sm:text-2xl font-bold text-white">₹{{ balanceSummary.bankExpenses|number_format(0) }}</p>
            <p class="text-[11px] text-cyan-400 mt-1">Deposit account outflows</p>
        </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="glass-panel rounded-2xl p-4 mb-6 border border-white/10">
        <form action="/comitee/expenses" method="GET" class="flex flex-col sm:flex-row items-center gap-3">
            <div class="w-full sm:w-48">
                <select name="month" class="input-glass w-full text-xs" onchange="this.form.submit()">
                    <option value="">All Months</option>
                    {% for m in availableMonths %}
                    <option value="{{ m.month_str }}" {{ selectedMonth == m.month_str ? 'selected' : '' }}>
                        {{ m.month_str|date('F Y') }}
                    </option>
                    {% endfor %}
                </select>
            </div>

            <div class="w-full sm:flex-1">
                <select name="expense_head_id" class="input-glass w-full text-xs" onchange="this.form.submit()">
                    <option value="">All Expense Heads</option>
                    {% for eh in expenseHeads %}
                    <option value="{{ eh.id }}" {{ selectedHead == eh.id ? 'selected' : '' }}>
                        {{ eh.name }} (A/C: {{ eh.account_head_name }})
                    </option>
                    {% endfor %}
                </select>
            </div>

            {% if selectedMonth or selectedHead %}
            <a href="/comitee/expenses" class="px-3 py-2 rounded-xl border border-white/10 text-xs text-surface-200/60 hover:text-white transition-colors shrink-0">
                Clear Filters
            </a>
            {% endif %}
        </form>
    </div>

    <!-- Expenses Vouchers Table -->
    <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 mb-8">
        <div class="p-4 border-b border-white/5 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i data-lucide="list-ordered" class="w-4 h-4 text-amber-400"></i>
                <h3 class="text-sm font-semibold text-white">Expense Vouchers</h3>
                <span class="text-xs text-surface-200/50">({{ expenses|length }} entries)</span>
            </div>
            <a href="/comitee/accounting" class="text-xs text-brand-400 hover:text-brand-300 font-medium flex items-center gap-1">
                <span>View P&L Statement</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-surface-200/80">
                <thead class="text-xs uppercase bg-white/[0.03] text-surface-200/60 border-b border-white/5">
                    <tr>
                        <th class="py-3 px-4 font-semibold">Voucher / Date</th>
                        <th class="py-3 px-4 font-semibold">Expense Head & A/C Head</th>
                        <th class="py-3 px-4 font-semibold">Paid To / Payee</th>
                        <th class="py-3 px-4 font-semibold">Payment Mode</th>
                        <th class="py-3 px-4 font-semibold">Reference / Notes</th>
                        <th class="py-3 px-4 text-right font-semibold">Amount</th>
                        <th class="py-3 px-4 text-right font-semibold">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {% for exp in expenses %}
                    <tr class="hover:bg-white/[0.02] transition-colors">
                        <td class="py-3.5 px-4">
                            <span class="font-mono text-xs font-semibold text-white block">{{ exp.voucher_no }}</span>
                            <span class="text-[11px] text-surface-200/50">{{ exp.expense_date|date('d M Y') }}</span>
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="font-medium text-white block text-xs">{{ exp.expense_head_name }}</span>
                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-amber-500/10 text-amber-300 border border-amber-500/20 mt-0.5">
                                A/C: {{ exp.account_head_name }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="text-xs font-semibold text-white">{{ exp.paid_to }}</span>
                            {% if exp.recorder_name %}
                            <span class="block text-[10px] text-surface-200/40">By: {{ exp.recorder_name }}</span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4">
                            {% if exp.payment_mode == 'cash' %}
                            <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30">
                                <i data-lucide="banknote" class="w-3 h-3"></i>
                                Cash (In Hand)
                            </span>
                            {% else %}
                            <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
                                <i data-lucide="landmark" class="w-3 h-3"></i>
                                {{ exp.payment_mode|upper }} (Deposits)
                            </span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-xs">
                            {% if exp.reference_no %}
                            <span class="font-mono text-[11px] text-surface-200/70 block">Ref: {{ exp.reference_no }}</span>
                            {% endif %}
                            <span class="text-[11px] text-surface-200/50 line-clamp-1">{{ exp.notes ?: '-' }}</span>
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <span class="font-mono font-bold text-rose-400 text-sm">
                                -₹{{ exp.amount|number_format(2) }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <form action="/comitee/expenses/{{ exp.id }}/delete" method="POST" onsubmit="return confirm('Delete expense voucher {{ exp.voucher_no }}?')">
                                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                <button type="submit" class="p-1.5 rounded-lg text-rose-400 hover:bg-rose-500/10 transition-colors" title="Delete Voucher">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="py-10 text-center text-surface-200/40">
                            <i data-lucide="receipt" class="w-8 h-8 mx-auto mb-2 opacity-40"></i>
                            <p class="text-xs">No expenses recorded for this selection.</p>
                            <button type="button" onclick="document.getElementById('expenseModal').classList.remove('hidden')" class="mt-2 text-xs text-brand-400 hover:underline">
                                + Record your first expense voucher
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Modal: Record Expense -->
<div id="expenseModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm">
    <div class="glass-panel rounded-2xl max-w-lg w-full p-6 border border-white/10 bg-surface-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
            <div class="flex items-center gap-2">
                <i data-lucide="receipt" class="w-5 h-5 text-brand-400"></i>
                <h3 class="text-base font-bold text-white">Record Expense Voucher</h3>
            </div>
            <button type="button" onclick="document.getElementById('expenseModal').classList.add('hidden')" class="text-surface-200/50 hover:text-white">✕</button>
        </div>

        <form action="/comitee/expenses/create" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Expense Head *</label>
                    <select name="expense_head_id" required class="input-glass w-full text-xs" data-placeholder="-- Select Expense Head --">
                        <option value="">-- Select Expense Head --</option>
                        {% for eh in expenseHeads %}
                        <option value="{{ eh.id }}">
                            {{ eh.name }} (A/C: {{ eh.account_head_name }})
                        </option>
                        {% endfor %}
                    </select>
                    <p class="text-[10px] text-surface-200/40 mt-1">Need a new head? Click "+ Add Expense Head" to create one.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Amount (₹) *</label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-surface-200/40 text-xs">₹</span>
                            <input type="number" step="0.01" min="0.01" name="amount" required placeholder="0.00" class="input-glass w-full !pl-7 text-sm font-semibold">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Expense Date *</label>
                        <input type="date" name="expense_date" required value="{{ 'now'|date('Y-m-d') }}" class="input-glass w-full text-xs">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Paid To / Payee Name *</label>
                        <input type="text" name="paid_to" required placeholder="e.g. Apex Security Agency, Electrician" class="input-glass w-full text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-surface-200/70 mb-1">Payment Mode *</label>
                        <select name="payment_mode" required class="input-glass w-full text-xs">
                            <option value="upi" selected>UPI / Online (From Bank Deposits)</option>
                            <option value="bank_transfer">Bank Transfer / NEFT (From Bank Deposits)</option>
                            <option value="cash">Cash (From In Hand Balance)</option>
                            <option value="cheque">Cheque (From Bank Deposits)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Invoice / Ref / Cheque No.</label>
                    <input type="text" name="reference_no" placeholder="e.g. INV-9823 or UPI-Txn-30291" class="input-glass w-full text-xs">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Description / Particulars</label>
                    <textarea name="notes" rows="2" placeholder="Additional details, monthly bill cycle, etc." class="input-glass w-full text-xs"></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('expenseModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-white/10 hover:bg-white/5 text-xs text-surface-200/80">Cancel</button>
                <button type="submit" class="btn-primary !px-5 !py-2 text-xs font-semibold">Save Voucher</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Add Expense Head Connecting with A/C Head -->
<div id="expenseHeadModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm">
    <div class="glass-panel rounded-2xl max-w-md w-full p-6 border border-white/10 bg-surface-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
            <div class="flex items-center gap-2">
                <i data-lucide="tag" class="w-5 h-5 text-amber-400"></i>
                <h3 class="text-base font-bold text-white">Add Expense Head</h3>
            </div>
            <button type="button" onclick="document.getElementById('expenseHeadModal').classList.add('hidden')" class="text-surface-200/50 hover:text-white">✕</button>
        </div>

        <form action="/comitee/expenses/heads/create" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Expense Head Name *</label>
                    <input type="text" name="name" required placeholder="e.g. CCTV Annual AMC, Swimming Pool Chemical" class="input-glass w-full text-xs">
                    <p class="text-[10px] text-surface-200/40 mt-1">Specific expense item used when recording vouchers.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Connected Account Head (A/C Head) *</label>
                    <select name="account_head_id" required class="input-glass w-full text-xs" data-placeholder="-- Choose Account Head --">
                        <option value="">-- Choose Account Head --</option>
                        {% for ah in accountHeads %}
                        <option value="{{ ah.id }}">
                            [{{ ah.code }}] {{ ah.name }}
                        </option>
                        {% endfor %}
                    </select>
                    <p class="text-[10px] text-amber-400/80 mt-1">Connects this expense head to the society Balance Sheet & P&L Chart of Accounts.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Monthly Budget (₹)</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2.5 text-surface-200/40 text-xs">₹</span>
                        <input type="number" step="100" min="0" name="budget_monthly" placeholder="0.00" class="input-glass w-full !pl-7 text-xs">
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('expenseHeadModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-white/10 hover:bg-white/5 text-xs text-surface-200/80">Cancel</button>
                <button type="submit" class="btn-primary !px-5 !py-2 text-xs font-semibold">Connect & Save Head</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
