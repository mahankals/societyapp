<!-- Bulk Generate Bills Modal -->
<div id="bulkBillModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm overflow-y-auto">
    <div class="bg-white dark:bg-surface-900 rounded-2xl max-w-lg w-full border border-slate-200 dark:border-white/10 shadow-2xl max-h-[calc(100vh-2rem)] flex flex-col my-auto overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b border-slate-200 dark:border-white/10 shrink-0">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="layers" class="w-4 h-4 text-brand-500"></i>
                <span>Bulk Generate Monthly Bills</span>
            </h3>
            <button type="button" onclick="document.getElementById('bulkBillModal').classList.add('hidden')" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:text-surface-200/50 dark:hover:text-white transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form action="/comitee/bills/bulk-generate" method="POST" id="bulkBillForm" class="flex flex-col flex-1 min-h-0 overflow-hidden">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div class="p-6 overflow-y-auto flex-1 space-y-4">
                <!-- Applicable For: All vs Occupied -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1.5">Applicable For</label>
                    <div class="grid grid-cols-2 gap-1.5 p-1.5 bg-slate-100 dark:bg-black/40 rounded-xl border border-slate-200 dark:border-white/10">
                        <label id="bulkTargetOccupiedBtn" class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-brand-500/20 text-brand-700 dark:text-brand-300 border border-slate-300/80 dark:border-brand-500/30 shadow-sm">
                            <input type="radio" name="target_flats" value="occupied" checked class="hidden" onchange="setBulkTargetMode('occupied')">
                            <i data-lucide="user-check" class="w-3.5 h-3.5"></i>
                            <span>Occupied ({{ occupiedFlats|length }})</span>
                        </label>
                        <label id="bulkTargetAllBtn" class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-semibold cursor-pointer transition-all text-slate-600 dark:text-surface-200/60 hover:text-slate-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-white/5 border border-transparent">
                            <input type="radio" name="target_flats" value="all" class="hidden" onchange="setBulkTargetMode('all')">
                            <i data-lucide="building" class="w-3.5 h-3.5"></i>
                            <span>All Flats ({{ totalFlatsCount }})</span>
                        </label>
                    </div>
                </div>

                <!-- Bulk Calculation Mode Selector -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1.5">Calculation Method</label>
                    <div class="grid grid-cols-2 gap-1.5 p-1.5 bg-slate-100 dark:bg-black/40 rounded-xl border border-slate-200 dark:border-white/10">
                        <label id="bulkModeFixedBtn" class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-brand-500/20 text-brand-700 dark:text-brand-300 border border-slate-300/80 dark:border-brand-500/30 shadow-sm">
                            <input type="radio" name="billing_type" value="fixed" checked class="hidden" onchange="setBulkBillMode('fixed')">
                            <i data-lucide="equal" class="w-3.5 h-3.5"></i>
                            <span>Fixed Amount per Flat</span>
                        </label>
                        <label id="bulkModeSqftBtn" class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-semibold cursor-pointer transition-all text-slate-600 dark:text-surface-200/60 hover:text-slate-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-white/5 border border-transparent">
                            <input type="radio" name="billing_type" value="per_sqft" class="hidden" onchange="setBulkBillMode('per_sqft')">
                            <i data-lucide="calculator" class="w-3.5 h-3.5"></i>
                            <span>Multiply with Sq. Ft</span>
                        </label>
                    </div>
                </div>

                <!-- Bulk Fixed Mode Fields -->
                <div id="bulkFixedContainer">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Standard Amount per Flat (₹) <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-2.5 text-slate-400 text-sm">₹</span>
                        <input type="number" step="0.01" min="1" id="bulkFixedAmountInput" name="amount" placeholder="2500.00" class="block w-full pl-8 pr-4 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono" oninput="calculateBulkTotals()">
                    </div>
                    <p class="text-[11px] text-slate-500 dark:text-surface-200/50 mt-1">Every selected flat receives this exact fixed charge.</p>
                </div>

                <!-- Bulk Sq. Ft Mode Fields -->
                <div id="bulkSqftContainer" class="hidden space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Rate per Sq. Ft (₹) <span class="text-rose-500">*</span></label>
                            <div class="relative">
                                <span class="absolute left-3 top-2.5 text-slate-400 text-sm">₹</span>
                                <input type="number" step="0.01" min="0.01" id="bulkRateSqftInput" name="rate_per_sqft" placeholder="3.50" class="block w-full pl-7 pr-3 py-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono" oninput="calculateBulkTotals()">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Fallback Minimum (₹)</label>
                            <div class="relative">
                                <span class="absolute left-3 top-2.5 text-slate-400 text-sm">₹</span>
                                <input type="number" step="0.01" min="0" id="bulkMinAmountInput" name="min_amount" placeholder="1000.00" class="block w-full pl-7 pr-3 py-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono" oninput="calculateBulkTotals()">
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Live Calculation Banner -->
                    <div class="p-3 rounded-xl bg-brand-500/10 border border-brand-500/20 text-xs">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-slate-700 dark:text-surface-200/70">Estimated Collection:</span>
                            <span class="text-brand-600 dark:text-brand-300 font-mono text-sm font-bold" id="bulkLiveTotalText">₹0.00</span>
                        </div>
                        <p class="text-[10px] text-slate-500 dark:text-surface-200/50 leading-relaxed">
                            Formula: <code>Flat Area &times; Rate/sq.ft</code>. If a flat has 0 sq.ft, it uses the fallback minimum.
                        </p>
                    </div>
                </div>

                <!-- Month & Due Date -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Month <span class="text-rose-500">*</span></label>
                        <input type="month" name="month" value="{{ date()|date('Y-m') }}" required class="block w-full px-3 py-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Payment Due Date <span class="text-rose-500">*</span></label>
                        <input type="date" name="due_date" value="{{ date('+15 days')|date('Y-m-d') }}" required class="block w-full px-3 py-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Title</label>
                    <input type="text" name="title" value="Monthly Maintenance" class="block w-full px-3 py-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl">
                </div>
            </div>

            <div class="flex justify-end gap-2.5 p-4 border-t border-slate-200 dark:border-white/10 shrink-0 bg-slate-50 dark:bg-surface-900">
                <button type="button" onclick="document.getElementById('bulkBillModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-white/5 text-xs font-semibold text-slate-700 dark:text-surface-200/80">Cancel</button>
                <button type="submit" class="btn-primary !px-6 !py-2 text-xs font-semibold">Generate</button>
            </div>
        </form>
    </div>
</div>

