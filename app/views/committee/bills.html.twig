{% extends "layouts/mobile.html.twig" %}

{% block title %}Maintenance Bills | {{ society.name }}{% endblock %}

{% block content %}
{% set totalOccupiedArea = 0 %}
{% for of in occupiedFlats %}
    {% set totalOccupiedArea = totalOccupiedArea + (of.area_sqft|default(0)) %}
{% endfor %}

<div class="max-w-7xl mx-auto px-4 sm:px-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/comitee" class="text-xs text-brand-400 hover:underline">← Committee Dashboard</a>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Maintenance Bills & Dues</h1>
            <p class="text-xs text-surface-200/60">{{ society.name }} &middot; Billing, Collections & Invoicing</p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <button type="button" onclick="openUpiSettingsModal()" class="px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-white/10 hover:bg-slate-200 dark:hover:bg-white/15 text-xs font-semibold text-slate-700 dark:text-white border border-slate-300 dark:border-white/10 transition-all flex items-center gap-1.5 shadow-sm">
                <i data-lucide="qr-code" class="w-4 h-4 text-emerald-500"></i>
                <span>UPI Settings</span>
            </button>
            <button type="button" onclick="openBulkBillModal()" class="px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-white/10 hover:bg-slate-200 dark:hover:bg-white/15 text-xs font-semibold text-slate-700 dark:text-brand-300 hover:text-slate-900 dark:hover:text-white border border-slate-300 dark:border-brand-500/30 transition-all flex items-center gap-1.5 shadow-sm">
                <i data-lucide="layers" class="w-4 h-4 text-brand-500"></i>
                <span>Bulk Generate Bills</span>
            </button>
            <button type="button" onclick="openCreateBillModal()" class="btn-primary !px-4 !py-2.5 flex items-center gap-1.5 text-xs font-semibold">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Create Bill</span>
            </button>
        </div>
    </div>

    {% if flash.success %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}
    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <!-- Financial Stats for this Society -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="glass-panel rounded-2xl p-5 border border-white/10">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-surface-200/60 uppercase">Collected (Paid)</span>
                <div class="w-8 h-8 rounded-lg bg-emerald-500/15 flex items-center justify-center text-emerald-400">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                </div>
            </div>
            <p class="text-2xl font-bold text-white">₹{{ (stats.paidAmount|default(0))|number_format(2) }}</p>
            <p class="text-[11px] text-emerald-400 mt-1">{{ stats.paidCount|default(0) }} bills settled</p>
        </div>

        <div class="glass-panel rounded-2xl p-5 border border-white/10">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-surface-200/60 uppercase">Pending / Overdue</span>
                <div class="w-8 h-8 rounded-lg bg-rose-500/15 flex items-center justify-center text-rose-400">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                </div>
            </div>
            <p class="text-2xl font-bold text-rose-400">₹{{ (stats.pendingAmount|default(0))|number_format(2) }}</p>
            <p class="text-[11px] text-surface-200/50 mt-1">{{ stats.pendingCount|default(0) }} unpaid bills</p>
        </div>

        <div class="glass-panel rounded-2xl p-5 border border-white/10">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-surface-200/60 uppercase">Total Billed</span>
                <div class="w-8 h-8 rounded-lg bg-brand-500/15 flex items-center justify-center text-brand-400">
                    <i data-lucide="receipt" class="w-4 h-4"></i>
                </div>
            </div>
            <p class="text-2xl font-bold text-white">₹{{ (stats.totalAmount|default(0))|number_format(2) }}</p>
            <p class="text-[11px] text-surface-200/50 mt-1">{{ stats.total|default(0) }} total generated</p>
        </div>
    </div>

    {% if pendingConfirmationsCount|default(0) > 0 %}
    <!-- Pending Payment Confirmations Waiting for Approval -->
    <div class="mb-8 glass-panel rounded-2xl border border-amber-500/30 bg-amber-500/[0.03] p-5 sm:p-6 shadow-xl">
        <div class="flex items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                </div>
                <div>
                    <h2 class="text-base font-bold text-slate-900 dark:text-white">Pending Payment Confirmations ({{ pendingConfirmationsCount }})</h2>
                    <p class="text-xs text-amber-800 dark:text-amber-200 font-medium">Residents have submitted UPI payment references awaiting your verification.</p>
                </div>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-800 dark:text-amber-300 font-semibold border border-amber-500/30">
                Action Required
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700 dark:text-surface-200/80">
                <thead class="text-xs uppercase bg-white/[0.03] text-slate-500 dark:text-surface-200/60 border-b border-slate-200 dark:border-white/5">
                    <tr>
                        <th class="py-3 px-3 font-semibold">Resident & Unit</th>
                        <th class="py-3 px-3 font-semibold">Bill Info</th>
                        <th class="py-3 px-3 font-semibold">UPI Reference / UTR</th>
                        <th class="py-3 px-3 font-semibold">Amount</th>
                        <th class="py-3 px-3 font-semibold">Submitted On</th>
                        <th class="py-3 px-3 text-right font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                    {% for pc in pendingConfirmations %}
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02]">
                        <td class="py-3 px-3">
                            <p class="font-bold text-slate-900 dark:text-white text-xs">{{ pc.user_name }}</p>
                            <p class="text-[11px] text-slate-500 dark:text-surface-200/60 font-mono">Unit {{ pc.wing ? pc.wing ~ '-' : '' }}{{ pc.flat_no ?: '-' }}</p>
                            {% if pc.user_phone %}
                            <p class="text-[10px] text-slate-400 dark:text-surface-200/40 font-mono">{{ pc.user_phone }}</p>
                            {% endif %}
                        </td>
                        <td class="py-3 px-3">
                            <p class="font-mono text-xs text-brand-600 dark:text-brand-300 font-bold">#{{ pc.bill_number ?: pc.receipt_no }}</p>
                            <p class="text-[11px] text-slate-500 dark:text-surface-200/60 truncate max-w-[150px]">{{ pc.bill_title ?: pc.particulars }}</p>
                        </td>
                        <td class="py-3 px-3">
                            <span class="font-mono text-xs font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-white/10 px-2 py-0.5 rounded">{{ pc.transaction_ref }}</span>
                            <p class="text-[10px] text-slate-500 dark:text-surface-200/40 mt-0.5 uppercase">{{ pc.payment_method }}</p>
                        </td>
                        <td class="py-3 px-3 font-mono font-extrabold text-slate-900 dark:text-white text-sm">
                            ₹{{ pc.amount|number_format(2) }}
                        </td>
                        <td class="py-3 px-3 text-xs text-slate-500 dark:text-surface-200/60 font-mono">
                            {{ pc.created_at|date('d M, h:i A') }}
                        </td>
                        <td class="py-3 px-3 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <form action="/comitee/receipts/{{ pc.id }}/approve" method="POST" onsubmit="event.preventDefault(); window.appConfirm('Approve payment of ₹{{ pc.amount|number_format(2) }} for {{ pc.user_name }}?', () => this.submit());">
                                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                    <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold flex items-center gap-1 shadow-sm transition">
                                        <i data-lucide="check" class="w-3.5 h-3.5"></i>
                                        <span>Approve</span>
                                    </button>
                                </form>
                                <button type="button" onclick="openRejectConfirmationModal('{{ pc.id }}', '{{ pc.user_name|e('js') }}', '{{ pc.amount }}')" class="px-2.5 py-1.5 rounded-lg bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 border border-rose-500/30 text-xs font-semibold flex items-center gap-1 transition">
                                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                    <span>Reject</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    <!-- Filter Pills -->
    <div class="flex items-center gap-2 mb-4 flex-wrap">
        <a href="/comitee/bills" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors {{ statusFilter == '' ? 'bg-brand-500/20 text-brand-600 dark:text-brand-300 border border-brand-500/30' : 'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-surface-200/70 hover:bg-slate-200 dark:hover:bg-white/10' }}">
            All Bills ({{ stats.total|default(0) }})
        </a>
        <a href="/comitee/bills?status=pending" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors {{ statusFilter == 'pending' ? 'bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-500/30' : 'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-surface-200/70 hover:bg-slate-200 dark:hover:bg-white/10' }}">
            Pending ({{ stats.pendingCount|default(0) }})
        </a>
        <a href="/comitee/bills?status=paid" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors {{ statusFilter == 'paid' ? 'bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30' : 'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-surface-200/70 hover:bg-slate-200 dark:hover:bg-white/10' }}">
            Paid ({{ stats.paidCount|default(0) }})
        </a>
        <a href="/comitee/bills?status=rejected" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors {{ statusFilter == 'rejected' ? 'bg-rose-500/20 text-rose-800 dark:text-rose-300 border border-rose-500/30' : 'bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-surface-200/70 hover:bg-slate-200 dark:hover:bg-white/10' }}">
            Rejected ({{ rejectedCount|default(0) }})
        </a>
    </div>

    <!-- Bills Table -->
    <div class="bg-white dark:bg-surface-900 rounded-2xl overflow-hidden border border-slate-200 dark:border-white/10 shadow-sm mb-8">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700 dark:text-surface-200/80">
                <thead class="text-xs uppercase bg-slate-50 dark:bg-white/[0.03] text-slate-500 dark:text-surface-200/60 border-b border-slate-200 dark:border-white/5">
                    <tr>
                        <th class="py-3.5 px-4 font-semibold">Bill # / Title</th>
                        <th class="py-3.5 px-4 font-semibold">Flat & Resident</th>
                        <th class="py-3.5 px-4 font-semibold">Month</th>
                        <th class="py-3.5 px-4 font-semibold">Amount</th>
                        <th class="py-3.5 px-4 font-semibold">Due Date</th>
                        <th class="py-3.5 px-4 font-semibold">Status</th>
                        <th class="py-3.5 px-4 text-right font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                    {% for b in bills %}
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02] transition-colors">
                        <td class="py-3.5 px-4">
                            <p class="font-mono text-xs font-bold text-slate-900 dark:text-white">{{ b.bill_number }}</p>
                            <p class="text-[11px] text-slate-500 dark:text-surface-200/50">{{ b.title ?: 'Monthly Maintenance' }}</p>
                            {% if b.particulars %}
                            <p class="text-[10px] text-slate-600 dark:text-brand-300 mt-0.5 line-clamp-1" title="{{ b.particulars }}">{{ b.particulars }}</p>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4">
                            <p class="font-semibold text-slate-900 dark:text-white">Flat {{ b.wing ? b.wing ~ '-' : '' }}{{ b.flat_no ?: '-' }}</p>
                            <p class="text-xs text-slate-500 dark:text-surface-200/50">
                                {% if b.user_name %}
                                    {{ b.user_name }}
                                {% else %}
                                    <span class="text-amber-600 dark:text-amber-400 italic font-medium">Vacant Unit</span>
                                {% endif %}
                                {% if b.area_sqft and b.area_sqft > 0 %}
                                &middot; <span class="text-slate-400 dark:text-surface-200/40">{{ b.area_sqft|number_format(0) }} sqft</span>
                                {% endif %}
                            </p>
                        </td>
                        <td class="py-3.5 px-4 font-mono text-xs text-slate-900 dark:text-white">
                            {{ b.month }}
                        </td>
                        <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white font-mono">
                            ₹{{ b.amount|number_format(2) }}
                        </td>
                        <td class="py-3.5 px-4 text-xs">
                            <span class="{{ b.status == 'pending' and b.due_date < date()|date('Y-m-d') ? 'text-rose-600 dark:text-rose-400 font-semibold' : 'text-slate-600 dark:text-surface-200/70' }}">
                                {{ b.due_date|date('d M Y') }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4">
                            {% if b.status == 'paid' %}
                            <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 font-semibold">
                                Paid
                            </span>
                            {% elseif b.status == 'overdue' or (b.status == 'pending' and b.due_date < date()|date('Y-m-d')) %}
                            <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-rose-500/15 text-rose-700 dark:text-rose-400 border border-rose-500/30 font-semibold">
                                Overdue
                            </span>
                            {% elseif b.status == 'rejected' %}
                            <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-rose-500/15 text-rose-700 dark:text-rose-400 border border-rose-500/30 font-semibold">
                                Rejected
                            </span>
                            {% else %}
                            <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 font-semibold">
                                Pending
                            </span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            {% if b.status != 'paid' %}
                            <button type="button" 
                                onclick='openMarkPaidModal({{ {
                                    id: b.id,
                                    bill_number: b.bill_number,
                                    user_name: b.user_name|default("Vacant Unit"),
                                    wing: b.wing,
                                    flat_no: b.flat_no,
                                    amount: b.amount
                                }|json_encode|raw }})'
                                class="px-2.5 py-1 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 text-xs font-semibold transition-colors">
                                Mark Paid
                            </button>
                            {% else %}
                            <span class="text-[11px] text-slate-400 dark:text-surface-200/40">Settled {{ b.paid_at ? b.paid_at|date('d M') : '' }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="py-8 text-center text-surface-200/50">No maintenance bills found. Click "Create Bill" or "Bulk Generate Bills" above.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Create Single Bill Modal -->
<div id="createBillModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm overflow-y-auto">
    <div class="bg-white dark:bg-surface-900 rounded-2xl max-w-lg w-full border border-slate-200 dark:border-white/10 shadow-2xl max-h-[calc(100vh-2rem)] flex flex-col my-auto overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b border-slate-200 dark:border-white/10 shrink-0">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="file-plus" class="w-4 h-4 text-brand-500"></i>
                <span>Create Maintenance Bill</span>
            </h3>
            <button type="button" onclick="document.getElementById('createBillModal').classList.add('hidden')" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:text-surface-200/50 dark:hover:text-white transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form action="/comitee/bills" method="POST" id="createBillForm" class="flex flex-col flex-1 min-h-0 overflow-hidden">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div class="p-6 overflow-y-auto flex-1 space-y-4">
                <!-- Flat Selection -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Select Flat &amp; Occupant <span class="text-rose-500">*</span></label>
                    <select name="flat_id" id="singleBillFlat" required class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50" onchange="onSingleFlatChanged()">
                        <option value="" data-area="0">-- Choose Flat --</option>
                        {% for f in occupiedFlats %}
                        <option value="{{ f.id }}" data-area="{{ f.area_sqft|default(0) }}" data-wing="{{ f.wing }}" data-flat="{{ f.flat_no }}">
                            Flat {{ f.wing ? f.wing ~ '-' : '' }}{{ f.flat_no }} &middot; {{ f.member_name }} ({{ f.area_sqft|default(0) }} sqft &middot; {{ f.flat_type }})
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Billing Calculation Mode Selector -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1.5">Calculation Method</label>
                    <div class="grid grid-cols-2 gap-1.5 p-1.5 bg-slate-100 dark:bg-black/40 rounded-xl border border-slate-200 dark:border-white/10">
                        <label id="singleModeFixedBtn" class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-brand-500/20 text-brand-700 dark:text-brand-300 border border-slate-300/80 dark:border-brand-500/30 shadow-sm">
                            <input type="radio" name="billing_type" value="fixed" checked class="hidden" onchange="setSingleBillMode('fixed')">
                            <i data-lucide="equal" class="w-3.5 h-3.5"></i>
                            <span>Fixed Amount</span>
                        </label>
                        <label id="singleModeSqftBtn" class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg text-xs font-semibold cursor-pointer transition-all text-slate-600 dark:text-surface-200/60 hover:text-slate-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-white/5 border border-transparent">
                            <input type="radio" name="billing_type" value="per_sqft" class="hidden" onchange="setSingleBillMode('per_sqft')">
                            <i data-lucide="calculator" class="w-3.5 h-3.5"></i>
                            <span>Multiply with Sq. Ft</span>
                        </label>
                    </div>
                </div>

                <!-- Fixed Amount Input Container -->
                <div id="singleFixedContainer">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Bill Amount (₹) <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-2.5 text-slate-400 text-sm">₹</span>
                        <input type="number" step="0.01" min="1" id="singleFixedAmountInput" name="amount" placeholder="2500.00" class="block w-full pl-8 pr-4 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 font-mono">
                    </div>
                    <p class="text-[11px] text-slate-500 dark:text-surface-200/50 mt-1">Direct fixed maintenance charge for this unit.</p>
                </div>

                <!-- Sq. Ft Rate Input Container -->
                <div id="singleSqftContainer" class="hidden space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Rate per Sq. Ft (₹) <span class="text-rose-500">*</span></label>
                            <div class="relative">
                                <span class="absolute left-3 top-2.5 text-slate-400 text-sm">₹</span>
                                <input type="number" step="0.01" min="0.01" id="singleRateSqftInput" name="rate_per_sqft" placeholder="2.50" class="block w-full pl-7 pr-3 py-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none font-mono" oninput="calculateSingleSqftTotal()">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/70 mb-1">Flat Area (Sq. Ft)</label>
                            <input type="text" id="singleAreaReadonly" readonly value="0 sqft" class="block w-full px-3 py-2 text-sm text-slate-500 bg-slate-100 dark:bg-white/[0.02] border border-slate-200 dark:border-white/10 rounded-xl font-mono cursor-not-allowed">
                        </div>
                    </div>

                    <!-- Dynamic Live Calculation Banner -->
                    <div class="p-3 rounded-xl bg-brand-500/10 border border-brand-500/20 text-xs flex items-center justify-between">
                        <span class="text-slate-700 dark:text-surface-200/70">Calculated Bill:</span>
                        <div class="text-right">
