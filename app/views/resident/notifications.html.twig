{% extends "layouts/mobile.html.twig" %}

{% block title %}Notifications | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-200 dark:border-white/10">
        <div class="flex items-center gap-3">
            <a href="/resident" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-white/10 text-slate-700 dark:text-white/70 hover:text-slate-900 dark:hover:text-white transition-all shadow-sm">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <h1 class="text-xl font-bold text-slate-900 dark:text-white">Notifications</h1>
                <p class="text-xs text-slate-500 dark:text-surface-200/50">{{ notifications|length }} notifications</p>
            </div>
        </div>
        <form method="POST" action="/user/notification/mark-read" class="ml-auto">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <button type="submit" class="flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-600 dark:text-surface-200/70 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 rounded-xl border border-slate-200 dark:border-white/10 transition-all">
                <i data-lucide="check-check" class="w-4 h-4"></i>
                <span>Mark all read</span>
            </button>
        </form>
    </div>

    {% if flash %}
    <div class="mb-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400{% else %}bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        <span>{{ flash.message }}</span>
    </div>
    {% endif %}

    <div class="space-y-3">
        {% for notification in notifications %}
        <div id="notif-row-{{ notification.id }}" class="bg-white dark:bg-surface-900 rounded-2xl p-4 sm:p-5 border border-slate-200 dark:border-white/10 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all hover:border-slate-300 dark:hover:border-white/20 {% if not notification.is_read %}border-l-4 border-l-brand-500 bg-brand-500/[0.02]{% endif %}">
            <div class="flex items-start gap-3.5 flex-1 min-w-0">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5
                    {% if notification.type == 'warning' %}bg-amber-500/15 text-amber-600 dark:text-amber-400
                    {% elseif notification.type == 'success' %}bg-emerald-500/15 text-emerald-600 dark:text-emerald-400
                    {% elseif notification.type == 'error' %}bg-rose-500/15 text-rose-600 dark:text-rose-400
                    {% elseif notification.type == 'announcement' %}bg-purple-500/15 text-purple-600 dark:text-purple-400
                    {% else %}bg-blue-500/15 text-blue-600 dark:text-blue-400{% endif %}">
                    <i data-lucide="{% if notification.type == 'warning' %}alert-triangle{% elseif notification.type == 'success' %}check-circle{% elseif notification.type == 'error' %}x-circle{% elseif notification.type == 'announcement' %}megaphone{% else %}info{% endif %}" class="w-5 h-5"></i>
                </div>
                
                <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white notif-title">{{ notification.title }}</h3>
                        {% if not notification.is_read %}
                        <span id="notif-unread-badge-{{ notification.id }}" class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-brand-500/15 text-brand-700 dark:text-brand-300 border border-brand-500/30">Unread</span>
                        {% endif %}
                        <span class="text-[11px] text-slate-400 dark:text-surface-200/40 ml-auto shrink-0">{{ notification.created_at|date('M d, Y h:i A') }}</span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-surface-200/60 mt-1 line-clamp-2 leading-relaxed">{{ notification.message }}</p>
                </div>
            </div>

            <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
                <!-- View Button -->
                <button type="button" onclick="viewNotification({{ notification|json_encode }})" class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-white/5 hover:bg-slate-200 dark:hover:bg-white/10 text-slate-700 dark:text-surface-200 text-xs font-semibold border border-slate-200 dark:border-white/10 flex items-center gap-1.5 transition-all">
                    <i data-lucide="eye" class="w-3.5 h-3.5 text-slate-500 dark:text-surface-200/50"></i>
                    <span>View</span>
                </button>

                <!-- Read / Unread Toggle -->
                <button type="button" id="notif-toggle-btn-{{ notification.id }}" onclick="toggleReadStatus({{ notification.id }})" title="{% if notification.is_read %}Mark as unread{% else %}Mark as read{% endif %}"
                    class="px-3 py-1.5 rounded-xl border text-xs font-semibold flex items-center gap-1.5 transition-all {% if notification.is_read %}bg-slate-50 dark:bg-white/[0.02] border-slate-200 dark:border-white/10 text-slate-500 dark:text-surface-200/60 hover:text-brand-600{% else %}bg-brand-500/10 border-brand-500/30 text-brand-700 dark:text-brand-300 hover:bg-brand-500/20{% endif %}">
                    <i data-lucide="{% if notification.is_read %}mail-check{% else %}check{% endif %}" class="w-3.5 h-3.5"></i>
                    <span id="notif-toggle-text-{{ notification.id }}">{% if notification.is_read %}Unread{% else %}Read{% endif %}</span>
                </button>
            </div>
        </div>
        {% else %}
        <div class="p-8 text-center bg-white dark:bg-surface-900 rounded-2xl border border-dashed border-slate-200 dark:border-white/10">
            <i data-lucide="bell-off" class="w-8 h-8 text-slate-300 dark:text-surface-200/30 mx-auto mb-2"></i>
            <p class="text-sm font-semibold text-slate-700 dark:text-surface-200/70">No notifications yet</p>
            <p class="text-xs text-slate-400 dark:text-surface-200/40 mt-1">You will receive notifications about maintenance bills, notices, and payment updates here.</p>
        </div>
        {% endfor %}
    </div>
</div>

<!-- Notification Detail Modal -->
<div id="notifDetailModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm">
    <div class="rounded-2xl max-w-lg w-full p-6 border border-slate-200 dark:border-white/10 bg-white dark:bg-surface-900 shadow-2xl relative animate-fade-in">
        <div class="flex items-start justify-between gap-4 pb-4 border-b border-slate-100 dark:border-white/10">
            <div class="flex items-center gap-3">
                <div id="modalNotifIcon" class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 bg-blue-500/15 text-blue-600 dark:text-blue-400">
                    <i data-lucide="info" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 id="modalNotifTitle" class="text-base font-bold text-slate-900 dark:text-white"></h3>
                    <p id="modalNotifDate" class="text-[11px] text-slate-400 dark:text-surface-200/40"></p>
                </div>
            </div>
            <button type="button" onclick="closeNotifModal()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 dark:text-surface-200/50 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 flex items-center justify-center transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div class="py-5">
            <p id="modalNotifMessage" class="text-sm text-slate-700 dark:text-surface-200/80 leading-relaxed whitespace-pre-line"></p>
        </div>

        <div class="pt-4 border-t border-slate-100 dark:border-white/10 flex items-center justify-between gap-3">
            <button type="button" onclick="closeNotifModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-surface-200/70 hover:bg-slate-100 dark:hover:bg-white/5 border border-slate-200 dark:border-white/10 transition-colors">
                Close
            </button>
            <div id="modalActionContainer"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    const csrfToken = "{{ csrfToken }}";

    function viewNotification(notif) {
        document.getElementById('modalNotifTitle').textContent = notif.title;
        document.getElementById('modalNotifDate').textContent = notif.created_at;
        document.getElementById('modalNotifMessage').textContent = notif.message;

        const actionContainer = document.getElementById('modalActionContainer');
        actionContainer.innerHTML = '';
        if (notif.action_url) {
            const btn = document.createElement('a');
            btn.href = notif.action_url;
            btn.className = 'inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold transition-all shadow-md shadow-brand-500/20';
            btn.innerHTML = '<span>Open Link</span><i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>';
            actionContainer.appendChild(btn);
        }

        // Mark as read via AJAX if not already read
        if (!notif.is_read) {
            fetch('/user/notification/' + notif.id + '/read', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'csrf_token=' + encodeURIComponent(csrfToken)
            }).then(() => {
                updateNotifReadUI(notif.id, true);
            }).catch(() => {});
        }

        document.getElementById('notifDetailModal').classList.remove('hidden');
        if (window.lucide) { lucide.createIcons(); }
    }

    function closeNotifModal() {
        document.getElementById('notifDetailModal').classList.add('hidden');
    }

    function toggleReadStatus(id) {
        fetch('/user/notification/' + id + '/toggle-read', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'csrf_token=' + encodeURIComponent(csrfToken)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                updateNotifReadUI(id, data.is_read === 1);
            }
        })
        .catch(() => {
            window.location.reload();
        });
    }

    function updateNotifReadUI(id, isRead) {
        const row = document.getElementById('notif-row-' + id);
        const badge = document.getElementById('notif-unread-badge-' + id);
        const toggleBtn = document.getElementById('notif-toggle-btn-' + id);
        const toggleText = document.getElementById('notif-toggle-text-' + id);

        if (isRead) {
            if (row) {
                row.classList.remove('border-l-4', 'border-l-brand-500', 'bg-brand-500/[0.02]');
            }
            if (badge) {
                badge.remove();
            }
            if (toggleBtn) {
                toggleBtn.className = 'px-3 py-1.5 rounded-xl border text-xs font-semibold flex items-center gap-1.5 transition-all bg-slate-50 dark:bg-white/[0.02] border-slate-200 dark:border-white/10 text-slate-500 dark:text-surface-200/60 hover:text-brand-600';
            }
            if (toggleText) {
                toggleText.textContent = 'Unread';
            }
        } else {
            if (row) {
                row.classList.add('border-l-4', 'border-l-brand-500', 'bg-brand-500/[0.02]');
            }
            if (toggleBtn) {
                toggleBtn.className = 'px-3 py-1.5 rounded-xl border text-xs font-semibold flex items-center gap-1.5 transition-all bg-brand-500/10 border-brand-500/30 text-brand-700 dark:text-brand-300 hover:bg-brand-500/20';
            }
            if (toggleText) {
                toggleText.textContent = 'Read';
            }
        }
        if (window.lucide) { lucide.createIcons(); }
    }

    if (window.lucide) { lucide.createIcons(); }
</script>
{% endblock %}
