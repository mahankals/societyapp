{% extends "layouts/mobile.html.twig" %}

{% block title %}Link Flat | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto px-4 sm:px-6">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Request Flat Linking</h1>
        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Choose your housing society and select the unit you reside in.</p>
    </div>

    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-300 text-sm flex items-center gap-2.5 font-medium">
        <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600 dark:text-rose-400 shrink-0"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-slate-200/80 dark:border-white/10 shadow-xl">
        <form action="/resident/link-flat" method="POST" id="linkFlatForm">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div class="space-y-6 mb-8">
                <!-- 1. Select Society -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Housing Society</label>
                    <select name="society_id" onchange="window.location.href='/resident/link-flat?society_id=' + this.value" class="input-glass w-full text-sm">
                        {% for s in societies %}
                        <option value="{{ s.id }}" {{ s.id == selectedSocietyId ? 'selected' : '' }}>
                            {{ s.name }} ({{ s.city }}) &middot; Code: {{ s.society_code }}
                        </option>
                        {% endfor %}
                    </select>
                    
                    <!-- Contribute Society Link -->
                    <div class="mt-2">
                        <a href="/society/contribute" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 inline-flex items-center gap-1.5 transition-colors">
                            <span>Your Society Not listed? Click here to Contribute</span>
                            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                        </a>
                    </div>
                </div>

                <!-- 2. Residency Type Selection (Moved above Unit Selection) -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Your Residency Type</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label id="roleOwnerLabel" class="p-3.5 rounded-xl border border-brand-500/40 bg-brand-500/10 dark:bg-brand-500/15 cursor-pointer flex items-center gap-2.5 transition-all shadow-sm">
                            <input type="radio" name="role" value="owner" checked class="text-brand-500 focus:ring-0" onchange="onResidencyTypeChanged('owner')">
                            <div>
                                <span class="text-xs font-bold text-slate-900 dark:text-white block">Flat Owner</span>
                                <span class="text-[10px] text-slate-500 dark:text-surface-200/60 block">Owner of an unlinked unit</span>
                            </div>
                        </label>
                        <label id="roleTenantLabel" class="p-3.5 rounded-xl border border-slate-200/80 dark:border-white/10 bg-slate-50/50 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/5 cursor-pointer flex items-center gap-2.5 transition-all">
                            <input type="radio" name="role" value="tenant" class="text-brand-500 focus:ring-0" onchange="onResidencyTypeChanged('tenant')">
                            <div>
                                <span class="text-xs font-bold text-slate-900 dark:text-white block">Tenant</span>
                                <span class="text-[10px] text-slate-500 dark:text-surface-200/60 block">Renting an available flat</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- 3. Select Available Unit / Flat -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5" id="unitSelectionLabel">
                        Select Available Unit / Flat (for Owner)
                    </label>

                    <!-- Unlinked Flats Dropdown (For Owners) -->
                    <div id="ownerFlatsWrap">
                        <select name="flat_id" id="ownerFlatSelect" required class="input-glass w-full text-sm font-mono">
                            <option value="">-- Choose Unlinked Flat --</option>
                            {% for f in unlinkedFlats %}
                            <option value="{{ f.id }}">
                                Unit {{ f.wing }}-{{ f.flat_no }} ({{ f.flat_type }}, Floor {{ f.floor ?: '-' }}, {{ f.area_sqft }} sqft)
                            </option>
                            {% endfor %}
                        </select>
                        {% if unlinkedFlats|length == 0 %}
                        <div class="mt-2 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-800 dark:text-amber-300 flex items-start gap-2">
                            <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"></i>
                            <span>No unlinked flats currently found for this society. All units may already have registered owners. Please contact your society committee.</span>
                        </div>
                        {% endif %}
                    </div>

                    <!-- Available for Rent Flats Dropdown (For Tenants) -->
                    <div id="tenantFlatsWrap" class="hidden">
                        <select id="tenantFlatSelect" class="input-glass w-full text-sm font-mono" disabled>
                            <option value="">-- Choose Flat Available for Rent --</option>
                            {% for f in rentalFlats %}
                            <option value="{{ f.id }}">
                                Unit {{ f.wing }}-{{ f.flat_no }} &middot; For Rent ({{ f.flat_type }}, Floor {{ f.floor ?: '-' }}, {{ f.area_sqft }} sqft)
                            </option>
                            {% endfor %}
                        </select>
                        {% if rentalFlats|length == 0 %}
                        <div class="mt-2 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-800 dark:text-amber-300 flex items-start gap-2">
                            <i data-lucide="info" class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"></i>
                            <span>No flats are currently marked as "Available for Rent" in this society. The flat owner or committee must enable rent availability for their unit first.</span>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Notice -->
                <div class="p-4 rounded-xl bg-blue-500/10 border border-blue-500/20 text-xs text-blue-800 dark:text-blue-300 flex items-start gap-2.5 font-medium">
                    <i data-lucide="info" class="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5"></i>
                    <span id="residencyNoticeText" class="leading-relaxed">Once submitted, your linking request will be reviewed by the managing committee. Upon approval, you will gain full access to bills, receipts, maintenance notices, and resident communication.</span>
                </div>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-slate-200/80 dark:border-white/5">
                <a href="/resident" class="px-4 py-2 rounded-xl text-xs text-slate-600 dark:text-surface-200/60 hover:text-slate-900 dark:hover:text-white transition-colors">Cancel</a>
                <button type="submit" class="btn-primary !px-6 !py-2.5 text-xs font-bold flex items-center gap-2 shadow-lg shadow-brand-500/25">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    <span>Submit Request</span>
                </button>
            </div>
        </form>
    </div>

</div>

<script>
function onResidencyTypeChanged(role) {
    const ownerWrap = document.getElementById('ownerFlatsWrap');
    const tenantWrap = document.getElementById('tenantFlatsWrap');
    const ownerSelect = document.getElementById('ownerFlatSelect');
    const tenantSelect = document.getElementById('tenantFlatSelect');
    const label = document.getElementById('unitSelectionLabel');
    const ownerLabel = document.getElementById('roleOwnerLabel');
    const tenantLabel = document.getElementById('roleTenantLabel');
    const notice = document.getElementById('residencyNoticeText');

    if (role === 'tenant') {
        ownerWrap.classList.add('hidden');
        tenantWrap.classList.remove('hidden');

        ownerSelect.removeAttribute('name');
        ownerSelect.removeAttribute('required');
        ownerSelect.disabled = true;

        tenantSelect.setAttribute('name', 'flat_id');
        tenantSelect.setAttribute('required', 'required');
        tenantSelect.disabled = false;

        label.textContent = 'Select Available Unit / Flat (Available for Rent)';
        
        tenantLabel.className = 'p-3.5 rounded-xl border border-blue-500/40 bg-blue-500/10 dark:bg-blue-500/15 cursor-pointer flex items-center gap-2.5 transition-all shadow-sm';
        ownerLabel.className = 'p-3.5 rounded-xl border border-slate-200/80 dark:border-white/10 bg-slate-50/50 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/5 cursor-pointer flex items-center gap-2.5 transition-all';
        
        if (notice) {
            notice.textContent = 'Once submitted, your tenancy linking request will be verified by the flat owner and managing committee. Upon approval, you will gain access to society announcements, maintenance bills, receipts, and resident directory communication.';
        }
    } else {
        tenantWrap.classList.add('hidden');
        ownerWrap.classList.remove('hidden');

        tenantSelect.removeAttribute('name');
        tenantSelect.removeAttribute('required');
        tenantSelect.disabled = true;

        ownerSelect.setAttribute('name', 'flat_id');
        ownerSelect.setAttribute('required', 'required');
        ownerSelect.disabled = false;

        label.textContent = 'Select Available Unit / Flat (for Owner)';

        ownerLabel.className = 'p-3.5 rounded-xl border border-brand-500/40 bg-brand-500/10 dark:bg-brand-500/15 cursor-pointer flex items-center gap-2.5 transition-all shadow-sm';
        tenantLabel.className = 'p-3.5 rounded-xl border border-slate-200/80 dark:border-white/10 bg-slate-50/50 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/5 cursor-pointer flex items-center gap-2.5 transition-all';

        if (notice) {
            notice.textContent = 'Once submitted, your linking request will be reviewed by the managing committee. Upon approval, you will gain full access to bills, receipts, maintenance notices, and resident communication.';
        }
    }

    if (window.lucide) {
        window.lucide.createIcons();
    }
}
</script>
{% endblock %}
