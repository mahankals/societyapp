{% extends "layouts/mobile.html.twig" %}

{% block title %}Link Flat | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto px-4 sm:px-6">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-white tracking-tight">Request Flat Linking</h1>
        <p class="text-xs text-surface-200/60">Choose your housing society and select the unit you reside in.</p>
    </div>

    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-white/10">
        <form action="/resident/link-flat" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <div class="space-y-5 mb-8">
                <!-- Select Society -->
                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1.5">Housing Society</label>
                    <select name="society_id" onchange="window.location.href='/resident/link-flat?society_id=' + this.value" class="input-glass w-full text-sm">
                        {% for s in societies %}
                        <option value="{{ s.id }}" {{ s.id == selectedSocietyId ? 'selected' : '' }}>
                            {{ s.name }} ({{ s.city }}) &middot; Code: {{ s.society_code }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Select Flat -->
                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1.5">Select Available Unit / Flat</label>
                    <select name="flat_id" required class="input-glass w-full text-sm font-mono">
                        <option value="">-- Choose Flat --</option>
                        {% for f in vacantFlats %}
                        <option value="{{ f.id }}">
                            Flat {{ f.wing }}-{{ f.flat_no }} ({{ f.flat_type }}, Floor {{ f.floor ?: '-' }}, {{ f.area_sqft }} sqft)
                        </option>
                        {% endfor %}
                    </select>
                    {% if vacantFlats|length == 0 %}
                    <p class="text-xs text-amber-400 mt-1">No vacant flats currently listed for this society. Contact your managing committee.</p>
                    {% endif %}
                </div>

                <!-- Role Selection -->
                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1.5">Your Residency Type</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="p-3 rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/5 cursor-pointer flex items-center gap-2">
                            <input type="radio" name="role" value="owner" checked class="text-brand-500 focus:ring-0">
                            <span class="text-xs font-medium text-white">Flat Owner</span>
                        </label>
                        <label class="p-3 rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/5 cursor-pointer flex items-center gap-2">
                            <input type="radio" name="role" value="tenant" class="text-brand-500 focus:ring-0">
                            <span class="text-xs font-medium text-white">Tenant / Tenant</span>
                        </label>
                    </div>
                </div>

                <!-- Notice -->
                <div class="p-4 rounded-xl bg-blue-500/10 border border-blue-500/20 text-xs text-blue-300 flex items-start gap-2.5">
                    <i data-lucide="info" class="w-4 h-4 shrink-0 mt-0.5"></i>
                    <span>Once submitted, your request will be reviewed by the society's managing committee. You will gain access to flat dues, notices, and receipts upon approval.</span>
                </div>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-white/5">
                <a href="/resident" class="px-4 py-2 rounded-xl text-xs text-surface-200/60 hover:text-white">Cancel</a>
                <button type="submit" class="btn-primary !px-6 !py-2.5 text-xs font-semibold flex items-center gap-2">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    <span>Submit Request</span>
                </button>
            </div>
        </form>
    </div>

</div>
{% endblock %}
