{% extends "layouts/mobile.html.twig" %}

{% block title %}Dashboard | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6">

    {% if flash.success %}
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-sm flex items-center gap-2.5 font-medium">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}
    {% if flash.info %}
    <div class="p-4 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-800 dark:text-blue-300 text-sm flex items-center gap-2.5 font-medium">
        <i data-lucide="info" class="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0"></i>
        <span>{{ flash.info }}</span>
    </div>
    {% endif %}
    {% if flash.error %}
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-800 dark:text-rose-300 text-sm flex items-center gap-2.5 font-medium">
        <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600 dark:text-rose-400 shrink-0"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <!-- Outstanding Dues Banner (Top priority, hidden for tenants) -->
    {% if not isTenant and unpaidBillsCount > 0 %}
    <div class="rounded-2xl p-6 border border-rose-500/30 bg-rose-500/10 dark:bg-rose-500/10 flex flex-col sm:flex-row sm:items-center justify-between gap-5 shadow-sm">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-600 dark:text-rose-400"></i>
                <span class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400">Outstanding Society Dues</span>
            </div>
            <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white font-mono">₹{{ unpaidBillsTotal|number_format(2) }}</p>
            <p class="text-xs text-slate-600 dark:text-surface-200/70 mt-1">{{ unpaidBillsCount }} maintenance bill{{ unpaidBillsCount > 1 ? 's' : '' }} pending payment</p>
        </div>
        <a href="/resident/bills" class="inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 transition-all shrink-0">
            <i data-lucide="qr-code" class="w-4 h-4"></i>
            <span>Pay with UPI / QR</span>
        </a>
    </div>
    {% endif %}

    <!-- 4 Quick Action Cards (2 for tenants) -->
    <div class="grid grid-cols-2 {% if not isTenant %}sm:grid-cols-4{% endif %} gap-3 sm:gap-4">
        {% if not isTenant %}
        <a href="/resident/bills" class="bg-white dark:bg-surface-900 rounded-2xl p-4 sm:p-5 text-center border border-slate-200 dark:border-white/10 hover:border-brand-500/40 hover:shadow-md transition-all group">
            <div class="w-11 h-11 rounded-xl bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center mx-auto mb-2.5 group-hover:scale-110 transition-transform">
                <i data-lucide="receipt" class="w-5 h-5"></i>
            </div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Bills &amp; Dues</p>
            <p class="text-xs text-slate-500 dark:text-surface-200/50 mt-0.5 font-medium">{{ unpaidBillsCount }} Pending</p>
        </a>

        <a href="/resident/receipts" class="bg-white dark:bg-surface-900 rounded-2xl p-4 sm:p-5 text-center border border-slate-200 dark:border-white/10 hover:border-brand-500/40 hover:shadow-md transition-all group">
            <div class="w-11 h-11 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto mb-2.5 group-hover:scale-110 transition-transform">
                <i data-lucide="file-check-2" class="w-5 h-5"></i>
            </div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Receipts</p>
            <p class="text-xs text-slate-500 dark:text-surface-200/50 mt-0.5 font-medium">Payment Ledger</p>
        </a>
        {% endif %}

        <a href="/resident/members" class="bg-white dark:bg-surface-900 rounded-2xl p-4 sm:p-5 text-center border border-slate-200 dark:border-white/10 hover:border-brand-500/40 hover:shadow-md transition-all group">
            <div class="w-11 h-11 rounded-xl bg-purple-500/15 text-purple-600 dark:text-purple-400 flex items-center justify-center mx-auto mb-2.5 group-hover:scale-110 transition-transform">
                <i data-lucide="users" class="w-5 h-5"></i>
            </div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Members</p>
            <p class="text-xs text-slate-500 dark:text-surface-200/50 mt-0.5 font-medium">Call &amp; message neighbors</p>
        </a>

        <a href="/society/contribute" class="bg-white dark:bg-surface-900 rounded-2xl p-4 sm:p-5 text-center border border-slate-200 dark:border-white/10 hover:border-brand-500/40 hover:shadow-md transition-all group">
            <div class="w-11 h-11 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center mx-auto mb-2.5 group-hover:scale-110 transition-transform">
                <i data-lucide="plus-circle" class="w-5 h-5"></i>
            </div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Add Society</p>
            <p class="text-xs text-slate-500 dark:text-surface-200/50 mt-0.5 font-medium">Contribute / Register</p>
        </a>
    </div>

    <!-- 2 Columns: Recent Maintenance Dues & Recent Receipts (Hidden for tenants) -->
    {% if not isTenant %}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Recent Maintenance Dues -->
        <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 border border-slate-200 dark:border-white/10 shadow-sm">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100 dark:border-white/5">
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Recent Maintenance Dues</h3>
                <a href="/resident/bills" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">View All &rarr;</a>
            </div>
            <div class="divide-y divide-slate-100 dark:divide-white/5">
                {% for b in recentBills %}
                <div class="py-3.5 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ b.title }}</p>
                        <p class="text-xs text-slate-500 dark:text-surface-200/50 mt-0.5">{{ b.society_name }} &middot; Due {{ b.due_date|date('M d, Y') }}</p>
                    </div>
                    <div class="text-right shrink-0">
                        <p class="text-sm font-bold font-mono text-slate-900 dark:text-white">₹{{ b.amount|number_format(2) }}</p>
                        <span class="inline-block mt-1 text-[10px] font-semibold px-2 py-0.5 rounded-full {{ b.status == 'paid' ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400' : 'bg-rose-500/15 text-rose-700 dark:text-rose-400' }}">
                            {{ b.status|capitalize }}
                        </span>
                    </div>
                </div>
                {% else %}
                <p class="py-6 text-center text-xs text-slate-400 dark:text-surface-200/40">No pending maintenance dues.</p>
                {% endfor %}
            </div>
        </div>

        <!-- Recent Payment Receipts -->
        <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 border border-slate-200 dark:border-white/10 shadow-sm">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100 dark:border-white/5">
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Recent Payment Receipts</h3>
                <a href="/resident/receipts" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">View All &rarr;</a>
            </div>
            <div class="divide-y divide-slate-100 dark:divide-white/5">
                {% for r in recentReceipts %}
                <div class="py-3.5 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-semibold font-mono text-brand-600 dark:text-brand-300">{{ r.receipt_no }}</p>
                        <p class="text-xs text-slate-500 dark:text-surface-200/50 mt-0.5">{{ r.particulars }} &middot; {{ r.payment_date|date('M d, Y') }}</p>
                    </div>
                    <div class="text-right shrink-0">
                        <p class="text-sm font-bold font-mono text-slate-900 dark:text-white">₹{{ r.amount|number_format(2) }}</p>
                        <a href="/resident/receipts/{{ r.id }}" target="_blank" class="inline-block mt-1 text-[11px] font-semibold text-brand-600 dark:text-brand-400 hover:underline">Print Voucher</a>
                    </div>
                </div>
                {% else %}
                <p class="py-6 text-center text-xs text-slate-400 dark:text-surface-200/40">No receipts issued yet.</p>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Associated Flats & Societies Section (Bottom Card) -->
    <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 border border-slate-200 dark:border-white/10 shadow-sm">
        <div class="flex items-center justify-between mb-5">
            <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="home" class="w-4 h-4 text-brand-500"></i>
                <span>My Associated Flats &amp; Societies</span>
            </h2>
            <a href="/resident/link-flat" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-500 flex items-center gap-1">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                <span>Link Flat</span>
            </a>
        </div>

        {% if myFlats|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for flat in myFlats %}
            <div class="p-5 rounded-xl border {{ flat.status == 'active' ? 'border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/[0.02]' : 'border-amber-500/20 bg-amber-500/5' }} flex flex-col justify-between gap-4">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                            <span class="font-mono font-bold text-slate-900 dark:text-white text-base">
                                {{ flat.wing ? flat.wing ~ '-' : '' }}{{ flat.flat_no ?: 'Unit Pending' }}
                            </span>
                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full {{ flat.status == 'active' ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400' : 'bg-amber-500/15 text-amber-700 dark:text-amber-400' }}">
                                {{ flat.status|capitalize }}
                            </span>
                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-200 dark:bg-white/10 text-slate-700 dark:text-surface-200/70 capitalize">
                                {{ flat.role }}
                            </span>
                        </div>
                        <p class="text-xs font-medium text-slate-700 dark:text-surface-200/80">{{ flat.society_name }}</p>
                        <p class="text-[11px] text-slate-500 dark:text-surface-200/50 mt-0.5">{{ flat.area_sqft ? flat.area_sqft ~ ' sqft &middot; ' : '' }}Code: <span class="font-mono text-brand-600 dark:text-brand-300">{{ flat.society_code }}</span></p>
                    </div>
                    {% if not isTenant %}
                    <div class="text-right">
                        <a href="/resident/bills" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">
                            <span>Dues</span>
                            <i data-lucide="chevron-right" class="w-3 h-3"></i>
                        </a>
                    </div>
                    {% endif %}
                </div>

                {% if (flat.role == 'owner' or flat.ownership_type == 'owner') and flat.flat_id and flat.status == 'active' %}
                <div class="pt-3 border-t border-slate-200 dark:border-white/5 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-[11px] text-slate-500 dark:text-surface-200/60 font-medium">Status:</span>
                        {% if flat.occupancy_status == 'available_for_rent' %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30">
                            <i data-lucide="key" class="w-3 h-3 text-amber-600 dark:text-amber-400"></i>
                            <span>Available for rent</span>
                        </span>
                        {% elseif flat.occupancy_status == 'rented' %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-purple-500/15 text-purple-700 dark:text-purple-300 border border-purple-500/30">
                            <i data-lucide="user-check" class="w-3 h-3 text-purple-600 dark:text-purple-400"></i>
                            <span>Rented</span>
                        </span>
                        {% else %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-500/15 text-blue-700 dark:text-blue-300 border border-blue-500/30">
                            <i data-lucide="home" class="w-3 h-3 text-blue-600 dark:text-blue-400"></i>
                            <span>Self occupied</span>
                        </span>
                        {% endif %}
                    </div>
                    <button type="button" 
                        onclick='openOccupancyModal({{ {
                            id: flat.flat_id,
                            flat_no: flat.flat_no,
                            wing: flat.wing,
                            occupancy_status: flat.occupancy_status|default("self_occupied"),
                            expected_rent: flat.expected_rent,
                            security_deposit: flat.security_deposit,
                            available_from: flat.available_from,
                            rental_notes: flat.rental_notes,
                            tenant_name: flat.tenant_name,
                            tenant_phone: flat.tenant_phone,
                            lease_end_date: flat.lease_end_date
                        }|json_encode|raw }})'
                        class="px-3 py-1 rounded-lg text-xs font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 hover:bg-brand-500/10 border border-brand-500/30 transition-all inline-flex items-center gap-1"
                        title="Change occupancy or rental status">
                        <i data-lucide="sliders" class="w-3 h-3"></i>
                        <span>Change</span>
                    </button>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="p-8 rounded-xl border border-dashed border-slate-300 dark:border-white/10 text-center">
            <i data-lucide="building" class="w-10 h-10 text-slate-400 dark:text-surface-200/30 mx-auto mb-2"></i>
            <p class="text-sm font-semibold text-slate-900 dark:text-white mb-1">Currently you are not mapped with any society.</p>
            <p class="text-xs text-slate-500 dark:text-surface-200/50 max-w-md mx-auto mb-4">
                Contact your society committee member / flat owner to add you, or send a linking request below.
            </p>
            <a href="/resident/link-flat" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-xs transition-all shadow-md">
                <i data-lucide="link-2" class="w-3.5 h-3.5"></i>
                <span>Request to Link Flat</span>
            </a>
        </div>
        {% endif %}
    </div>

</div>

<!-- Manage Occupancy Status Modal (High z-index z-[200] & viewport constraint) -->
<div id="occupancyModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm overflow-y-auto">
    <div class="bg-white dark:bg-surface-900 rounded-2xl max-w-lg w-full border border-slate-200 dark:border-white/10 shadow-2xl max-h-[calc(100vh-2rem)] flex flex-col my-auto overflow-hidden">
        <!-- Fixed Modal Header -->
        <div class="flex items-center justify-between p-5 border-b border-slate-200 dark:border-white/10 shrink-0">
            <h3 id="occupancyModalTitle" class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="home" class="w-4 h-4 text-brand-500"></i>
                <span>Manage Flat Occupancy</span>
            </h3>
            <button type="button" onclick="closeOccupancyModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:text-surface-200/50 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <!-- Form with scrollable body and fixed footer -->
        <form id="occupancyForm" action="" method="POST" class="flex flex-col flex-1 min-h-0 overflow-hidden">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

            <!-- Scrollable Modal Body -->
            <div class="p-6 overflow-y-auto flex-1 space-y-5">
                <!-- Status Options Selector -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-2">Select Occupancy Status</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" id="opt_self_occupied" onclick="setOccupancyType('self_occupied')" class="p-3 rounded-xl border cursor-pointer text-center transition-all flex flex-col items-center gap-1.5 border-brand-500 bg-brand-500/10">
                            <input type="radio" name="occupancy_status" value="self_occupied" checked class="hidden">
                            <i data-lucide="home" class="w-4 h-4 text-brand-500"></i>
                            <span class="text-xs font-bold text-slate-900 dark:text-white">Self occupied</span>
                        </button>
                        <button type="button" id="opt_available_for_rent" onclick="setOccupancyType('available_for_rent')" class="p-3 rounded-xl border cursor-pointer text-center transition-all flex flex-col items-center gap-1.5 border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/[0.02]">
                            <input type="radio" name="occupancy_status" value="available_for_rent" class="hidden">
                            <i data-lucide="key" class="w-4 h-4 text-amber-500"></i>
                            <span class="text-xs font-bold text-slate-900 dark:text-white">Available for rent</span>
                        </button>
                        <button type="button" id="opt_rented" onclick="setOccupancyType('rented')" class="p-3 rounded-xl border cursor-pointer text-center transition-all flex flex-col items-center gap-1.5 border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/[0.02]">
                            <input type="radio" name="occupancy_status" value="rented" class="hidden">
                            <i data-lucide="user-check" class="w-4 h-4 text-purple-500"></i>
                            <span class="text-xs font-bold text-slate-900 dark:text-white">Rented</span>
                        </button>
                    </div>
                </div>

                <!-- 1. Self Occupied Details -->
                <div id="panel_self_occupied" class="p-4 rounded-xl bg-blue-500/10 border border-blue-500/20 text-xs text-blue-900 dark:text-blue-300 flex items-start gap-2.5">
                    <i data-lucide="info" class="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5"></i>
                    <span class="leading-relaxed">This unit is currently occupied by the owner/family. It will remain private and won't appear as available for tenants to select.</span>
                </div>

                <!-- 2. Available For Rent Details -->
                <div id="panel_available_for_rent" class="hidden space-y-4">
                    <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-900 dark:text-amber-300 flex items-start gap-2">
                        <i data-lucide="info" class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"></i>
                        <span>Marking this unit available for rent will allow prospective tenants of your society to select it when submitting their linking requests.</span>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="relative">
                            <input type="number" step="100" id="occ_expected_rent" name="expected_rent" placeholder=" " class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 font-mono">
                            <label for="occ_expected_rent" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Expected Rent (₹ / month)
                            </label>
                        </div>
                        <div class="relative">
                            <input type="number" step="1000" id="occ_security_deposit" name="security_deposit" placeholder=" " class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 font-mono">
                            <label for="occ_security_deposit" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Security Deposit (₹)
                            </label>
                        </div>
                    </div>

                    <div class="relative">
                        <input type="date" id="occ_available_from" name="available_from" placeholder=" " class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500">
                        <label for="occ_available_from" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                            Available From Date
                        </label>
                    </div>

                    <div class="relative">
                        <textarea id="occ_rental_notes" name="rental_notes" rows="2" placeholder=" " class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 resize-none"></textarea>
                        <label for="occ_rental_notes" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                            Rental Notes &amp; Preferences (Optional)
                        </label>
                    </div>
                </div>

                <!-- 3. Rented Details -->
                <div id="panel_rented" class="hidden space-y-4">
                    <div class="p-3.5 rounded-xl bg-purple-500/10 border border-purple-500/20 text-xs text-purple-900 dark:text-purple-300 flex items-start gap-2">
                        <i data-lucide="info" class="w-4 h-4 text-purple-600 dark:text-purple-400 shrink-0 mt-0.5"></i>
                        <span>Link an already registered tenant account or fill their contact details for society records.</span>
                    </div>

                    <!-- Registered Tenant Selector -->
                    <div>
                        <label for="occ_tenant_user_id" class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">
                            Link Registered User (Tenant)
                        </label>
                        <select id="occ_tenant_user_id" name="tenant_user_id" onchange="onTenantUserSelect(this)"
                            class="block w-full px-3 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <option value="">-- Choose registered tenant or enter details manually --</option>
                            {% for t in registeredTenants %}
                            <option value="{{ t.id }}" data-name="{{ t.name }}" data-phone="{{ t.phone }}">{{ t.name }} ({{ t.phone ?: t.email }})</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="relative">
                            <input type="text" id="occ_tenant_name" name="tenant_name" placeholder=" " class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500">
                            <label for="occ_tenant_name" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Tenant Full Name
                            </label>
                        </div>
                        <div class="relative">
                            <input type="tel" id="occ_tenant_phone" name="tenant_phone" placeholder=" " class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 font-mono">
                            <label for="occ_tenant_phone" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Tenant Phone Number
                            </label>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="relative">
                            <input type="number" step="100" id="occ_rented_rent" name="expected_rent_rented" placeholder=" " class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 font-mono">
                            <label for="occ_rented_rent" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Current Monthly Rent (₹)
                            </label>
                        </div>
                        <div class="relative">
                            <input type="date" id="occ_lease_end_date" name="lease_end_date" placeholder=" " class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500">
                            <label for="occ_lease_end_date" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Lease End Date
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fixed Modal Footer -->
            <div class="flex justify-end gap-2.5 p-4 border-t border-slate-200 dark:border-white/10 shrink-0 bg-slate-50 dark:bg-surface-900">
                <button type="button" onclick="closeOccupancyModal()" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-white/5 text-xs font-semibold text-slate-700 dark:text-surface-200/80 transition-colors">Cancel</button>
                <button type="submit" id="saveOccupancyBtn" disabled class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold shadow-md shadow-brand-500/20 transition-all flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed">
                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                    <span>Save Occupancy Status</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let currentOccupancyType = 'self_occupied';

    function setOccupancyType(type) {
        currentOccupancyType = type;
        const types = ['self_occupied', 'available_for_rent', 'rented'];
        
        types.forEach(t => {
            const opt = document.getElementById('opt_' + t);
            const panel = document.getElementById('panel_' + t);
            const radio = opt.querySelector('input[type="radio"]');
            
            if (t === type) {
                radio.checked = true;
                opt.className = 'p-3 rounded-xl border cursor-pointer text-center transition-all flex flex-col items-center gap-1.5 border-brand-500 bg-brand-500/15 shadow-sm';
                panel.classList.remove('hidden');
            } else {
                radio.checked = false;
                opt.className = 'p-3 rounded-xl border cursor-pointer text-center transition-all flex flex-col items-center gap-1.5 border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/5';
                panel.classList.add('hidden');
            }
        });

        // Trigger change for submit button watcher
        const btn = document.getElementById('saveOccupancyBtn');
        if (btn) btn.disabled = false;
    }

    function onTenantUserSelect(select) {
        const option = select.options[select.selectedIndex];
        if (option && option.value) {
            const name = option.getAttribute('data-name');
            const phone = option.getAttribute('data-phone');
            if (name) document.getElementById('occ_tenant_name').value = name;
            if (phone) document.getElementById('occ_tenant_phone').value = phone;
        }
        const btn = document.getElementById('saveOccupancyBtn');
        if (btn) btn.disabled = false;
    }

    function openOccupancyModal(flat) {
        if (!flat) return;
        const form = document.getElementById('occupancyForm');
        form.action = '/resident/flats/' + flat.id + '/occupancy';

        document.getElementById('occupancyModalTitle').innerHTML = '<i data-lucide="home" class="w-4 h-4 text-brand-500"></i><span>Manage Flat ' + (flat.wing ? flat.wing + '-' : '') + flat.flat_no + ' Occupancy</span>';

        // Prepopulate values
        document.getElementById('occ_expected_rent').value = flat.expected_rent || '';
        document.getElementById('occ_security_deposit').value = flat.security_deposit || '';
        document.getElementById('occ_available_from').value = flat.available_from || '';
        document.getElementById('occ_rental_notes').value = flat.rental_notes || '';
        document.getElementById('occ_tenant_name').value = flat.tenant_name || '';
        document.getElementById('occ_tenant_phone').value = flat.tenant_phone || '';
        document.getElementById('occ_lease_end_date').value = flat.lease_end_date || '';
        document.getElementById('occ_rented_rent').value = flat.expected_rent || '';

        setOccupancyType(flat.occupancy_status || 'self_occupied');
        document.getElementById('saveOccupancyBtn').disabled = true;

        document.getElementById('occupancyModal').classList.remove('hidden');
        if (window.lucide) { lucide.createIcons(); }
    }

    function closeOccupancyModal() {
        document.getElementById('occupancyModal').classList.add('hidden');
    }

    document.getElementById('occupancyForm').addEventListener('input', function() {
        document.getElementById('saveOccupancyBtn').disabled = false;
    });

    document.getElementById('occupancyForm').addEventListener('change', function() {
        document.getElementById('saveOccupancyBtn').disabled = false;
    });

    document.getElementById('occupancyForm').addEventListener('submit', function() {
        if (currentOccupancyType === 'rented') {
            const rentedRent = document.getElementById('occ_rented_rent').value;
            if (rentedRent) {
                document.getElementById('occ_expected_rent').value = rentedRent;
            }
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        if (window.lucide) { lucide.createIcons(); }
    });
</script>
{% endblock %}
