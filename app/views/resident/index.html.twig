{% extends "layouts/mobile.html.twig" %}

{% block title %}Dashboard | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6">

    {% if flash.success %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-sm flex items-center gap-2.5 font-medium">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}
    {% if flash.info %}
    <div class="mb-6 p-4 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-800 dark:text-blue-300 text-sm flex items-center gap-2.5 font-medium">
        <i data-lucide="info" class="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0"></i>
        <span>{{ flash.info }}</span>
    </div>
    {% endif %}

    <!-- Welcome & Profile Banner (Society Mitra Member Header) -->
    <div class="mb-6 glass-panel rounded-2xl p-5 sm:p-6 border border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="relative">
                {% if profile.profile_photo %}
                <img src="{{ profile.profile_photo }}" alt="{{ user.name }}" class="w-14 h-14 rounded-2xl object-cover border-2 border-brand-500/30">
                {% else %}
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center font-bold text-xl shadow-lg shadow-brand-500/25">
                    {{ user.name|first|upper }}
                </div>
                {% endif %}
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-xl font-bold text-white">{{ user.name }}</h1>
                    {% if isCommittee %}
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-brand-500/20 text-brand-300 border border-brand-500/30">
                        Committee
                    </span>
                    {% endif %}
                </div>
                <p class="text-xs text-surface-200/50 mt-0.5">{{ user.email }} &middot; {{ user.phone ?: 'No phone added' }}</p>
                <p class="text-[11px] text-surface-200/40 mt-1">Updated at {{ 'now'|date('h:i A, d M Y') }}</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            {% if isCommittee %}
            <a href="/comitee" class="btn-primary !px-4 !py-2 text-xs font-semibold flex items-center gap-2 shadow-lg shadow-brand-500/20">
                <i data-lucide="shield" class="w-4 h-4"></i>
                <span>Committee Dashboard</span>
            </a>
            {% endif %}
            <a href="/resident/profile" class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-white flex items-center gap-1.5 transition-colors">
                <i data-lucide="edit-3" class="w-3.5 h-3.5 text-surface-200/60"></i>
                <span>Edit Profile</span>
            </a>
        </div>
    </div>

    <!-- My Flats & Societies (Society Mitra Multi-Flat Card) -->
    <div class="mb-6 glass-panel rounded-2xl p-6 border border-white/10">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
                <i data-lucide="home" class="w-4 h-4 text-brand-400"></i>
                <span>My Associated Flats & Societies</span>
            </h2>
            <a href="/resident/link-flat" class="text-xs font-medium text-brand-400 hover:text-brand-300 flex items-center gap-1">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                <span>Link Flat</span>
            </a>
        </div>

        {% if myFlats|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {% for flat in myFlats %}
            <div class="p-4 rounded-xl border {{ flat.status == 'active' ? 'border-white/10 bg-white/[0.02]' : 'border-amber-500/20 bg-amber-500/5' }} flex items-start justify-between gap-3">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="font-mono font-bold text-white text-base">
                            {{ flat.wing ? flat.wing ~ '-' : '' }}{{ flat.flat_no ?: 'Unit Pending' }}
                        </span>
                        <span class="text-[10px] px-2 py-0.5 rounded-full {{ flat.status == 'active' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300' }}">
                            {{ flat.status|capitalize }}
                        </span>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-surface-200/70 capitalize">
                            {{ flat.role }}
                        </span>
                    </div>
                    <p class="text-xs font-medium text-surface-200/80">{{ flat.society_name }}</p>
                    <p class="text-[11px] text-surface-200/50 mt-0.5">{{ flat.area_sqft ? flat.area_sqft ~ ' sqft' : '' }} &middot; Code: <span class="font-mono text-brand-300">{{ flat.society_code }}</span></p>
                </div>
                <div class="text-right">
                    <a href="/resident/bills" class="inline-flex items-center gap-1 text-xs text-brand-400 hover:underline mt-2">
                        <span>Dues</span>
                        <i data-lucide="chevron-right" class="w-3 h-3"></i>
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <!-- Empty State matching Society Mitra -->
        <div class="p-6 rounded-xl border border-dashed border-white/10 text-center">
            <i data-lucide="building" class="w-8 h-8 text-surface-200/30 mx-auto mb-2"></i>
            <p class="text-sm font-medium text-white mb-1">Currently you are not mapped with any society.</p>
            <p class="text-xs text-surface-200/50 max-w-md mx-auto mb-4">
                Contact your society committee member / flat owner to add you, or send a linking request below.
            </p>
            <a href="/resident/link-flat" class="btn-primary !px-5 !py-2 text-xs font-semibold inline-flex items-center gap-2">
                <i data-lucide="link-2" class="w-3.5 h-3.5"></i>
                <span>Request to Link Flat</span>
            </a>
        </div>
        {% endif %}
    </div>

    <!-- Outstanding Dues Banner (if any) -->
    {% if unpaidBillsCount > 0 %}
    <div class="mb-6 glass-panel rounded-2xl p-5 border border-red-500/30 bg-red-500/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <i data-lucide="alert-triangle" class="w-4 h-4 text-red-400"></i>
                <span class="text-xs font-semibold uppercase tracking-wider text-red-400">Outstanding Society Dues</span>
            </div>
            <p class="text-3xl font-extrabold text-white font-mono">₹{{ unpaidBillsTotal|number_format(2) }}</p>
            <p class="text-xs text-surface-200/60 mt-1">{{ unpaidBillsCount }} maintenance bill{{ unpaidBillsCount > 1 ? 's' : '' }} pending payment</p>
        </div>
        <a href="/resident/bills" class="btn-primary !py-2.5 !px-6 text-sm font-semibold flex items-center justify-center gap-2 shrink-0">
            <i data-lucide="qr-code" class="w-4 h-4"></i>
            <span>Pay with UPI / QR</span>
        </a>
    </div>
    {% endif %}

    <!-- Core App Features Grid (Society Mitra Navigation) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-8">
        <a href="/resident/bills" class="glass-panel rounded-xl p-4 text-center hover:bg-white/5 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
                <i data-lucide="receipt" class="w-5 h-5"></i>
            </div>
            <p class="text-sm font-bold text-white">Bills & Dues</p>
            <p class="text-[11px] text-surface-200/50 mt-0.5">{{ unpaidBillsCount }} Pending</p>
        </a>

        <a href="/resident/receipts" class="glass-panel rounded-xl p-4 text-center hover:bg-white/5 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
                <i data-lucide="file-check-2" class="w-5 h-5"></i>
            </div>
            <p class="text-sm font-bold text-white">Receipts</p>
            <p class="text-[11px] text-surface-200/50 mt-0.5">Payment Ledger</p>
        </a>

        <a href="/resident/directory" class="glass-panel rounded-xl p-4 text-center hover:bg-white/5 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
                <i data-lucide="users" class="w-5 h-5"></i>
            </div>
            <p class="text-sm font-bold text-white">Directory</p>
            <p class="text-[11px] text-surface-200/50 mt-0.5">Call & SMS Neighbors</p>
        </a>

        <a href="/society/contribute" class="glass-panel rounded-xl p-4 text-center hover:bg-white/5 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
                <i data-lucide="plus-circle" class="w-5 h-5"></i>
            </div>
            <p class="text-sm font-bold text-white">Add Society</p>
            <p class="text-[11px] text-surface-200/50 mt-0.5">Contribute / Register</p>
        </a>
    </div>

    <!-- Recent Maintenance Bills & Receipts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Recent Bills -->
        <div class="glass-panel rounded-2xl p-6 border border-white/10">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-white">Recent Maintenance Dues</h3>
                <a href="/resident/bills" class="text-xs text-brand-400 hover:underline">View All →</a>
            </div>
            <div class="divide-y divide-white/5">
                {% for b in recentBills %}
                <div class="py-3 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-white">{{ b.title }}</p>
                        <p class="text-xs text-surface-200/50">{{ b.society_name }} &middot; Due {{ b.due_date|date('M d, Y') }}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-bold font-mono text-white">₹{{ b.amount|number_format(2) }}</p>
                        <span class="text-[10px] px-2 py-0.5 rounded-full {{ b.status == 'paid' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-red-500/20 text-red-300' }}">
                            {{ b.status|capitalize }}
                        </span>
                    </div>
                </div>
                {% else %}
                <p class="py-4 text-center text-xs text-surface-200/40">No recent maintenance bills.</p>
                {% endfor %}
            </div>
        </div>

        <!-- Recent Receipts -->
        <div class="glass-panel rounded-2xl p-6 border border-white/10">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-white">Recent Payment Receipts</h3>
                <a href="/resident/receipts" class="text-xs text-brand-400 hover:underline">View All →</a>
            </div>
            <div class="divide-y divide-white/5">
                {% for r in recentReceipts %}
                <div class="py-3 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-white font-mono text-brand-300">{{ r.receipt_no }}</p>
                        <p class="text-xs text-surface-200/50">{{ r.particulars }} &middot; {{ r.payment_date|date('M d, Y') }}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-bold font-mono text-white">₹{{ r.amount|number_format(2) }}</p>
                        <a href="/resident/receipts/{{ r.id }}" target="_blank" class="text-[11px] text-brand-400 hover:underline">Print Voucher</a>
                    </div>
                </div>
                {% else %}
                <p class="py-4 text-center text-xs text-surface-200/40">No receipts issued yet.</p>
                {% endfor %}
            </div>
        </div>
    </div>

</div>
{% endblock %}
