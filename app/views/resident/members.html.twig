{% extends "layouts/mobile.html.twig" %}

{% block title %}Resident Members{% if society %} | {{ society.name }}{% endif %} | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6">

    <!-- Header & Search -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Resident Members</h1>
            <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">
                {% if society %}
                {{ society.name }}{% if society.city %} &middot; {{ society.city }}{% endif %} &middot; Call &amp; message neighbors
                {% else %}
                Housing Society Directory &middot; Call &amp; message neighbors
                {% endif %}
            </p>
        </div>

        {% if not unlinked and linkedSocieties|length > 0 %}
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 max-w-lg w-full sm:w-auto">
            {% if linkedSocieties|length > 1 %}
            <select onchange="window.location.href='/resident/members?society_id=' + this.value" class="input-glass !py-2 text-xs">
                {% for ls in linkedSocieties %}
                <option value="{{ ls.id }}" {{ ls.id == selectedSocietyId ? 'selected' : '' }}>
                    {{ ls.name }} ({{ ls.city }})
                </option>
                {% endfor %}
            </select>
            {% endif %}

            <form action="/resident/members" method="GET" class="relative flex-1 sm:w-72">
                {% if selectedSocietyId %}
                <input type="hidden" name="society_id" value="{{ selectedSocietyId }}">
                {% endif %}
                <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-surface-200/40 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" name="q" value="{{ search }}" placeholder="Search by name, flat, phone..." class="input-glass w-full !pl-10 !py-2 text-xs">
                {% if search %}
                <a href="/resident/members{% if selectedSocietyId %}?society_id={{ selectedSocietyId }}{% endif %}" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 dark:text-surface-200/40 hover:text-slate-900 dark:hover:text-white">✕</a>
                {% endif %}
            </form>
        </div>
        {% endif %}
    </div>

    {% if unlinked %}
    <!-- Unlinked Resident Empty State -->
    <div class="glass-panel rounded-2xl border border-slate-200/80 dark:border-white/10 p-8 sm:p-12 text-center max-w-lg mx-auto shadow-sm my-8">
        <div class="w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="shield-alert" class="w-8 h-8"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Flat Not Linked Yet</h3>
        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-2 leading-relaxed">
            You are not currently linked to an active housing society. Society members and contact details are private and only visible to verified residents.
        </p>
        <div class="mt-6">
            <a href="/resident/link-flat" class="btn-primary !px-5 !py-2.5 text-xs font-bold inline-flex items-center gap-2 shadow-lg shadow-brand-500/25">
                <i data-lucide="link-2" class="w-4 h-4"></i>
                <span>Link Your Flat</span>
            </a>
        </div>
    </div>
    {% else %}
    <!-- Members Grid (Matching Reference Screenshot) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {% for m in members %}
        <div class="glass-panel rounded-2xl p-5 border border-slate-200/80 dark:border-white/10 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-3.5">
            <!-- Row 1: Avatar + Name + Flat/Society + Residency Badge -->
            <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0 flex-1">
                    {% if m.profile_photo %}
                    <img src="{{ m.profile_photo }}" alt="{{ m.name }}" class="w-12 h-12 rounded-xl object-cover border border-slate-200 dark:border-white/10 shrink-0">
                    {% else %}
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-700/30 text-brand-700 dark:text-brand-300 border border-brand-500/20 flex items-center justify-center font-bold text-base shrink-0">
                        {{ m.name|first|upper }}
                    </div>
                    {% endif %}
                    <div class="min-w-0 flex-1">
                        <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-tight truncate">{{ m.name }}</h3>
                        <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-surface-200/60 mt-1 truncate">
                            <i data-lucide="building" class="w-3.5 h-3.5 text-slate-400 dark:text-surface-200/50 shrink-0"></i>
                            <span class="truncate">
                                <strong class="text-slate-800 dark:text-white font-semibold">{{ m.wing ? m.wing ~ '-' : '' }}{{ m.flat_no ?: '-' }}</strong>
                                &middot; {{ m.society_name|default(society.name) }}{% if m.society_city or society.city %}, {{ m.society_city|default(society.city) }}{% endif %}
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Residency Type Badge -->
                {% if m.member_role in ['chairman', 'secretary', 'treasurer', 'committee'] %}
                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 uppercase tracking-wide shrink-0">
                    {{ m.member_role }}
                </span>
                {% elseif m.member_role == 'tenant' or m.ownership_type == 'tenant' %}
                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-blue-500/15 text-blue-700 dark:text-blue-300 border border-blue-500/30 shrink-0">
                    Tenant
                </span>
                {% else %}
                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 shrink-0">
                    Owner
                </span>
                {% endif %}
            </div>

            <!-- Row 2: Phone Container with Call, SMS, WhatsApp Icons (As in Screenshot) -->
            <div class="rounded-xl bg-slate-100/90 dark:bg-white/[0.04] border border-slate-200/80 dark:border-white/10 px-3.5 py-2 flex items-center justify-between">
                <span class="text-xs font-mono font-medium text-slate-700 dark:text-surface-200/90 tracking-tight">
                    {{ m.phone ?: 'No phone number' }}
                </span>
                {% if m.phone %}
                <div class="flex items-center gap-1">
                    <a href="tel:{{ m.phone }}" class="p-1.5 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/10 rounded-lg transition-colors" title="Call {{ m.name }}">
                        <i data-lucide="phone" class="w-4 h-4"></i>
                    </a>
                    <a href="sms:{{ m.phone }}" class="p-1.5 text-blue-600 dark:text-blue-400 hover:bg-blue-500/10 rounded-lg transition-colors" title="SMS {{ m.name }}">
                        <i data-lucide="message-square" class="w-4 h-4"></i>
                    </a>
                    <a href="https://api.whatsapp.com/send?phone={{ m.phone|replace({' ': '', '+': '', '-': ''}) }}" target="_blank" class="w-6 h-6 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-sm hover:opacity-90 transition-opacity ml-0.5" title="WhatsApp {{ m.name }}">
                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                        </svg>
                    </a>
                </div>
                {% endif %}
            </div>

            <!-- Row 3: Email Container with Mail Icon (As in Screenshot) -->
            <div class="rounded-xl bg-slate-100/90 dark:bg-white/[0.04] border border-slate-200/80 dark:border-white/10 px-3.5 py-2 flex items-center justify-between">
                <span class="text-xs font-medium text-slate-700 dark:text-surface-200/90 truncate mr-2">
                    {{ m.email ?: 'No email listed' }}
                </span>
                {% if m.email %}
                <a href="mailto:{{ m.email }}" class="p-1.5 text-slate-400 hover:text-slate-700 dark:text-surface-200/50 dark:hover:text-white rounded-lg transition-colors shrink-0" title="Email {{ m.name }}">
                    <i data-lucide="mail" class="w-4 h-4"></i>
                </a>
                {% else %}
                <span class="p-1.5 text-slate-300 dark:text-white/10 shrink-0">
                    <i data-lucide="mail" class="w-4 h-4"></i>
                </span>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="col-span-full py-16 text-center text-slate-400 dark:text-surface-200/50">
            <i data-lucide="users" class="w-10 h-10 mx-auto mb-2 opacity-40"></i>
            <p class="font-bold text-slate-800 dark:text-white text-base">No resident members found</p>
            <p class="text-xs mt-1">Try searching for a different name, flat number, or check another society.</p>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>
{% endblock %}
