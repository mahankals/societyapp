{% extends "layouts/mobile.html.twig" %}

{% block title %}Resident Members | {{ society.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6">

    <!-- Header & Search -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Resident Members</h1>
            <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">
                {{ society.name }}{% if society.city %} &middot; {{ society.city }}{% endif %} &middot; Call &amp; message neighbors
            </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 max-w-lg w-full sm:w-auto">
            {% if linkedSocieties|length > 1 %}
            <select onchange="window.location.href='/resident/members?society_id=' + this.value" class="input-glass !py-2 text-xs">
                {% for ls in linkedSocieties %}
                <option value="{{ ls.id }}" {{ ls.id == selectedSocietyId ? 'selected' : '' }}>
                    {{ ls.name }} ({{ ls.city }})
                </option>
                {% endfor %}
            </select>
            {% endif %}

            <form action="/resident/members" method="GET" class="relative flex-1 sm:w-72">
                {% if selectedSocietyId %}
                <input type="hidden" name="society_id" value="{{ selectedSocietyId }}">
                {% endif %}
                <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-surface-200/40 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" name="q" value="{{ search }}" placeholder="Search by name, flat, phone..." class="input-glass w-full !pl-10 !py-2 text-xs">
                {% if search %}
                <a href="/resident/members{% if selectedSocietyId %}?society_id={{ selectedSocietyId }}{% endif %}" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 dark:text-surface-200/40 hover:text-slate-900 dark:hover:text-white">✕</a>
                {% endif %}
            </form>
        </div>
    </div>

    <!-- Members Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for m in members %}
        <div class="glass-panel rounded-2xl p-5 border border-slate-200/80 dark:border-white/10 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-start justify-between gap-3 mb-3">
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                        {% if m.profile_photo %}
                        <img src="{{ m.profile_photo }}" alt="{{ m.name }}" class="w-12 h-12 rounded-xl object-cover border border-slate-200 dark:border-white/10 shrink-0">
                        {% else %}
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-700/30 text-brand-700 dark:text-brand-300 border border-brand-500/20 flex items-center justify-center font-bold text-base shrink-0">
                            {{ m.name|first|upper }}
                        </div>
                        {% endif %}
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-tight truncate">{{ m.name }}</h3>
                            <p class="text-xs font-mono font-bold text-brand-600 dark:text-brand-400 mt-0.5">
                                Unit {{ m.wing ? m.wing ~ '-' : '' }}{{ m.flat_no ?: 'Pending' }}
                            </p>
                        </div>
                    </div>

                    <!-- Residency Type Badge -->
                    {% if m.member_role in ['chairman', 'secretary', 'treasurer', 'committee'] %}
                    <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 uppercase tracking-wide shrink-0">
                        {{ m.member_role }}
                    </span>
                    {% elseif m.member_role == 'tenant' or m.ownership_type == 'tenant' %}
                    <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-blue-500/15 text-blue-700 dark:text-blue-300 border border-blue-500/30 shrink-0">
                        Tenant
                    </span>
                    {% else %}
                    <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 shrink-0">
                        Owner
                    </span>
                    {% endif %}
                </div>

                <!-- Flat Number with Society & City -->
                <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5 mb-3 text-xs flex items-start gap-2">
                    <i data-lucide="building" class="w-3.5 h-3.5 text-slate-400 dark:text-surface-200/50 shrink-0 mt-0.5"></i>
                    <div class="text-slate-600 dark:text-surface-200/70 truncate leading-relaxed">
                        <strong class="text-slate-900 dark:text-white">{{ m.wing ? m.wing ~ '-' : '' }}{{ m.flat_no ?: 'Unit pending' }}</strong>
                        &middot; {{ m.society_name|default(society.name) }}{% if m.society_city or society.city %}, {{ m.society_city|default(society.city) }}{% endif %}
                    </div>
                </div>

                {% if m.email %}
                <p class="text-xs text-slate-500 dark:text-surface-200/50 truncate mb-1 flex items-center gap-1.5">
                    <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-400 dark:text-surface-200/30 shrink-0"></i>
                    <span class="truncate">{{ m.email }}</span>
                </p>
                {% endif %}
            </div>

            <!-- Call, SMS, WhatsApp Actions -->
            <div class="mt-4 pt-3 border-t border-slate-200/80 dark:border-white/5">
                {% if m.phone %}
                <div class="flex items-center gap-2">
                    <a href="tel:{{ m.phone }}" class="flex-1 py-2 px-3 rounded-xl bg-slate-100 hover:bg-emerald-50 dark:bg-white/5 dark:hover:bg-emerald-500/20 text-slate-700 hover:text-emerald-700 dark:text-white dark:hover:text-emerald-300 border border-slate-200 dark:border-white/10 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-sm" title="Call {{ m.name }}">
                        <i data-lucide="phone" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Call</span>
                    </a>
                    <a href="sms:{{ m.phone }}" class="flex-1 py-2 px-3 rounded-xl bg-slate-100 hover:bg-blue-50 dark:bg-white/5 dark:hover:bg-blue-500/20 text-slate-700 hover:text-blue-700 dark:text-white dark:hover:text-blue-300 border border-slate-200 dark:border-white/10 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-sm" title="Send SMS to {{ m.name }}">
                        <i data-lucide="message-square" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400"></i>
                        <span>SMS</span>
                    </a>
                    <a href="https://api.whatsapp.com/send?phone={{ m.phone|replace({' ': '', '+': '', '-': ''}) }}" target="_blank" class="py-2 px-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-500/15 dark:hover:bg-emerald-500/25 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/30 text-xs font-semibold flex items-center justify-center transition-all shadow-sm" title="WhatsApp {{ m.name }}">
                        <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    </a>
                </div>
                <div class="text-[11px] font-mono text-slate-500 dark:text-surface-200/50 mt-1.5 text-center">
                    {{ m.phone }}
                </div>
                {% else %}
                <span class="text-xs text-slate-400 dark:text-surface-200/40 italic block text-center py-1">No phone number listed</span>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="col-span-full py-16 text-center text-slate-400 dark:text-surface-200/50">
            <i data-lucide="users" class="w-10 h-10 mx-auto mb-2 opacity-40"></i>
            <p class="font-bold text-slate-800 dark:text-white text-base">No resident members found</p>
            <p class="text-xs mt-1">Try searching for a different name, flat number, or check another society.</p>
        </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
