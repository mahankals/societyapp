{% extends "layouts/mobile.html.twig" %}

{% block title %}My Profile | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
            <a href="/resident" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center hover:bg-white/10 text-white/70 hover:text-white transition-all shadow-sm" title="Back to Dashboard">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-white tracking-tight">My Profile</h1>
                <p class="text-sm text-surface-200/60">Manage your personal details, emergency contacts and society residency</p>
            </div>
        </div>
        
        <div class="flex flex-wrap items-center gap-2">
            {% if user.role == 'admin' or userCaps.isAdmin %}
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-brand-500/15 text-brand-300 border border-brand-500/30">
                <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                Administrator
            </span>
            {% elseif isCommittee %}
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30">
                <i data-lucide="shield" class="w-3.5 h-3.5"></i>
                Committee Member
            </span>
            {% else %}
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
                <i data-lucide="user" class="w-3.5 h-3.5"></i>
                Resident
            </span>
            {% endif %}

            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Active Account
            </span>
        </div>
    </div>

    {% if flash %}
    <div class="mb-6 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        <span>{{ flash.message }}</span>
    </div>
    {% endif %}

    <!-- Main Content Layout (Responsive 2-Column on Desktop) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left Column: User Summary & Residency Overview -->
        <div class="lg:col-span-4 space-y-6">
            
            <!-- User Avatar & Identity Card -->
            <div class="glass-panel rounded-2xl p-6 border border-white/10 text-center relative overflow-hidden">
                <div class="absolute -top-16 -right-16 w-32 h-32 bg-brand-500/10 rounded-full blur-2xl pointer-events-none"></div>
                
                <div class="relative inline-block mx-auto mb-4 group">
                    {% if profile.profile_photo %}
                    <img src="{{ profile.profile_photo }}" alt="{{ user.name }}" class="w-24 h-24 rounded-2xl object-cover border-2 border-brand-500/40 shadow-xl shadow-brand-500/10 mx-auto">
                    {% else %}
                    <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center font-bold text-3xl shadow-xl shadow-brand-500/25 border-2 border-brand-500/30 mx-auto">
                        {{ user.name|first|upper }}
                    </div>
                    {% endif %}

                    <!-- Upload Photo Trigger Button -->
                    <label for="profilePhotoInput" class="absolute -bottom-1 -right-1 p-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white shadow-lg cursor-pointer transition-all hover:scale-105" title="Change Profile Photo">
                        <i data-lucide="camera" class="w-4 h-4"></i>
                    </label>
                </div>

                <form id="photoUploadForm" action="/resident/profile/photo" method="POST" enctype="multipart/form-data" class="hidden">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="file" id="profilePhotoInput" name="photo" accept="image/jpeg,image/png,image/webp" onchange="document.getElementById('photoUploadForm').submit()">
                </form>

                <h2 class="text-xl font-bold text-white mb-0.5 truncate">{{ user.name }}</h2>
                <p class="text-xs text-surface-200/50 mb-3 truncate">{{ user.email }}</p>

                {% if profile.phone %}
                <p class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/5 text-xs text-surface-200/70 border border-white/5 mb-4">
                    <i data-lucide="phone" class="w-3.5 h-3.5 text-brand-400"></i>
                    {{ profile.phone }}
                </p>
                {% endif %}

                <div class="pt-4 border-t border-white/10 grid grid-cols-2 gap-2 text-left">
                    <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/5">
                        <span class="block text-[11px] text-surface-200/40">Role</span>
                        <span class="block text-xs font-semibold text-white truncate">{{ user.role|capitalize }}</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/5">
                        <span class="block text-[11px] text-surface-200/40">Status</span>
                        <span class="block text-xs font-semibold text-emerald-400">Verified</span>
                    </div>
                </div>
            </div>

            <!-- Society & Linked Flat Card -->
            <div class="glass-panel rounded-2xl p-6 border border-white/10">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                        <i data-lucide="building-2" class="w-4 h-4 text-brand-400"></i>
                        <span>Residency Details</span>
                    </h3>
                    <a href="/resident/link-flat" class="text-xs text-brand-400 hover:text-brand-300 font-medium">Manage →</a>
                </div>

                {% if myFlats is defined and myFlats|length > 0 %}
                <div class="space-y-3">
                    {% for flat in myFlats %}
                    <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-between">
                        <div>
                            <p class="text-sm font-semibold text-white">{{ flat.wing ? 'Wing ' ~ flat.wing ~ ' - ' : '' }}{{ flat.flat_no }}</p>
                            <p class="text-xs text-surface-200/50">{{ flat.society_name }}</p>
                        </div>
                        <span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-brand-500/20 text-brand-300 border border-brand-500/30">
                            {{ flat.role|default('Resident')|capitalize }}
                        </span>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="p-4 rounded-xl bg-white/[0.02] border border-dashed border-white/15 text-center">
                    <p class="text-xs text-surface-200/60 mb-2">
                        {{ profile.apartment ? 'Apartment: ' ~ profile.apartment : 'No society flat linked to this account yet.' }}
                    </p>
                    <a href="/resident/link-flat" class="inline-flex items-center gap-1.5 text-xs text-brand-400 hover:text-brand-300 font-medium">
                        <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                        <span>Link Your Flat</span>
                    </a>
                </div>
                {% endif %}
            </div>

            <!-- Account & Security Shortcut -->
            <div class="glass-panel rounded-2xl p-6 border border-white/10">
                <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                    <i data-lucide="shield" class="w-4 h-4 text-amber-400"></i>
                    <span>Account Security</span>
                </h3>
                <div class="space-y-2">
                    <a href="/auth/reset-password" class="w-full flex items-center justify-between p-3 rounded-xl bg-white/[0.02] hover:bg-white/5 border border-white/5 text-xs text-surface-200/80 hover:text-white transition-colors">
                        <span class="flex items-center gap-2">
                            <i data-lucide="key-round" class="w-4 h-4 text-surface-200/40"></i>
                            <span>Change Password</span>
                        </span>
                        <i data-lucide="chevron-right" class="w-4 h-4 text-surface-200/30"></i>
                    </a>
                    <a href="/auth/pin-setup" class="w-full flex items-center justify-between p-3 rounded-xl bg-white/[0.02] hover:bg-white/5 border border-white/5 text-xs text-surface-200/80 hover:text-white transition-colors">
                        <span class="flex items-center gap-2">
                            <i data-lucide="lock" class="w-4 h-4 text-surface-200/40"></i>
                            <span>Security PIN</span>
                        </span>
                        <i data-lucide="chevron-right" class="w-4 h-4 text-surface-200/30"></i>
                    </a>
                </div>
            </div>

        </div>

        <!-- Right Column: Personal Information & Emergency Contact Form -->
        <div class="lg:col-span-8">
            <form method="POST" action="/resident/profile" class="space-y-6">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                <!-- Card 1: Personal Information -->
                <div class="glass-panel rounded-2xl p-6 sm:p-7 border border-white/10 shadow-lg">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/10">
                        <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400">
                            <i data-lucide="user-check" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-white">Personal Information</h2>
                            <p class="text-xs text-surface-200/50">Update your primary identity and residential contact information</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                        <div class="space-y-2">
                            <label for="name" class="block text-xs font-semibold text-surface-200/90">
                                Full Name <span class="text-rose-400">*</span>
                            </label>
                            <input type="text" id="name" name="name" value="{{ user.name }}" required
                                class="w-full h-12 bg-white/[0.04] border border-white/10 rounded-xl px-4 text-sm text-white placeholder-surface-200/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                        </div>

                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <label for="email" class="block text-xs font-semibold text-surface-200/90">Email Address</label>
                                <span class="text-[10px] text-surface-200/40 uppercase tracking-wider font-medium">Primary Login</span>
                            </div>
                            <div class="relative">
                                <input type="email" id="email" value="{{ user.email }}" disabled
                                    class="w-full h-12 bg-white/[0.02] border border-white/5 rounded-xl pl-4 pr-10 text-sm text-white/50 cursor-not-allowed">
                                <i data-lucide="lock" class="w-4 h-4 text-white/30 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label for="phone" class="block text-xs font-semibold text-surface-200/90">
                                Phone Number
                            </label>
                            <div class="relative">
                                <input type="tel" id="phone" name="phone" value="{{ profile.phone|default('') }}"
                                    class="w-full h-12 bg-white/[0.04] border border-white/10 rounded-xl px-4 text-sm text-white placeholder-surface-200/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all"
                                    placeholder="+91 9876543210">
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label for="apartment" class="block text-xs font-semibold text-surface-200/90">
                                Apartment / Flat / Unit
                            </label>
                            <input type="text" id="apartment" name="apartment" value="{{ profile.apartment|default('') }}"
                                class="w-full h-12 bg-white/[0.04] border border-white/10 rounded-xl px-4 text-sm text-white placeholder-surface-200/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all"
                                placeholder="e.g. A-101, Block A">
                        </div>
                    </div>

                    <div class="mt-6 space-y-2">
                        <label for="address" class="block text-xs font-semibold text-surface-200/90">
                            Residential / Mailing Address
                        </label>
                        <textarea id="address" name="address" rows="3"
                            class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-surface-200/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all resize-none"
                            placeholder="Enter your complete society flat address or postal address">{{ profile.address|default('') }}</textarea>
                    </div>
                </div>

                <!-- Card 2: Emergency Contact Information -->
                <div class="glass-panel rounded-2xl p-6 sm:p-7 border border-white/10 shadow-lg">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/10">
                        <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400">
                            <i data-lucide="phone-call" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-white">Emergency Contact</h2>
                            <p class="text-xs text-surface-200/50">Designated person or next of kin to reach during society emergencies</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                        <div class="space-y-2">
                            <label for="emergency_contact_name" class="block text-xs font-semibold text-surface-200/90">
                                Contact Person Name
                            </label>
                            <input type="text" id="emergency_contact_name" name="emergency_contact_name" value="{{ profile.emergency_contact_name|default('') }}"
                                class="w-full h-12 bg-white/[0.04] border border-white/10 rounded-xl px-4 text-sm text-white placeholder-surface-200/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all"
                                placeholder="e.g. Spouse, Parent, Relative">
                        </div>

                        <div class="space-y-2">
                            <label for="emergency_contact_phone" class="block text-xs font-semibold text-surface-200/90">
                                Emergency Phone Number
                            </label>
                            <input type="tel" id="emergency_contact_phone" name="emergency_contact_phone" value="{{ profile.emergency_contact_phone|default('') }}"
                                class="w-full h-12 bg-white/[0.04] border border-white/10 rounded-xl px-4 text-sm text-white placeholder-surface-200/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all"
                                placeholder="+91 9876543210">
                        </div>
                    </div>
                </div>

                <!-- Action Button Footer -->
                <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-2">
                    <a href="/resident" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-sm font-medium text-surface-200 hover:text-white text-center transition-all">
                        Cancel
                    </a>
                    <button type="submit" class="btn-primary w-full sm:w-auto !py-3.5 !px-8 !text-sm !rounded-xl shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span>Save Changes</span>
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
