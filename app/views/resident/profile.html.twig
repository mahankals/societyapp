{% extends "layouts/mobile.html.twig" %}

{% block title %}My Profile | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
            <a href="/resident" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-white/10 text-slate-700 dark:text-white/70 hover:text-slate-900 dark:hover:text-white transition-all shadow-sm" title="Back to Dashboard">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">My Profile</h1>
                <p class="text-sm text-slate-500 dark:text-surface-200/60">Manage your personal details, emergency contacts and society residency</p>
            </div>
        </div>
        
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Active Account
            </span>
        </div>
    </div>

    {% if flash %}
    <div class="mb-6 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-600 dark:text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        <span>{{ flash.message }}</span>
    </div>
    {% endif %}

    <!-- 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left Column: Navigation Tabs -->
        <div class="lg:col-span-4">
            <div class="bg-white dark:bg-surface-900 rounded-2xl border border-slate-200 dark:border-white/10 shadow-sm p-3 space-y-1.5">
                <button type="button" onclick="switchProfileTab('personal')" id="tab-btn-personal"
                    class="profile-tab-btn w-full flex items-center justify-between px-4 py-3.5 rounded-xl text-sm font-medium transition-all bg-brand-500/10 text-brand-600 dark:text-brand-300 border border-brand-500/20">
                    <span class="flex items-center gap-3">
                        <i data-lucide="user-check" class="w-4 h-4 text-brand-500"></i>
                        <span>Personal Information</span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-70"></i>
                </button>

                <button type="button" onclick="switchProfileTab('password')" id="tab-btn-password"
                    class="profile-tab-btn w-full flex items-center justify-between px-4 py-3.5 rounded-xl text-sm font-medium transition-all text-slate-600 dark:text-surface-200/70 hover:bg-slate-50 dark:hover:bg-white/5 border border-transparent">
                    <span class="flex items-center gap-3">
                        <i data-lucide="key-round" class="w-4 h-4 text-slate-400"></i>
                        <span>Change Password</span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-70"></i>
                </button>

                <button type="button" onclick="switchProfileTab('emergency')" id="tab-btn-emergency"
                    class="profile-tab-btn w-full flex items-center justify-between px-4 py-3.5 rounded-xl text-sm font-medium transition-all text-slate-600 dark:text-surface-200/70 hover:bg-slate-50 dark:hover:bg-white/5 border border-transparent">
                    <span class="flex items-center gap-3">
                        <i data-lucide="phone-call" class="w-4 h-4 text-rose-400"></i>
                        <span>Emergency Contact</span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-70"></i>
                </button>

                <button type="button" onclick="switchProfileTab('pin')" id="tab-btn-pin"
                    class="profile-tab-btn w-full flex items-center justify-between px-4 py-3.5 rounded-xl text-sm font-medium transition-all text-slate-600 dark:text-surface-200/70 hover:bg-slate-50 dark:hover:bg-white/5 border border-transparent">
                    <span class="flex items-center gap-3">
                        <i data-lucide="lock" class="w-4 h-4 text-amber-400"></i>
                        <span>Security PIN</span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-70"></i>
                </button>

                <button type="button" onclick="switchProfileTab('accounts')" id="tab-btn-accounts"
                    class="profile-tab-btn w-full flex items-center justify-between px-4 py-3.5 rounded-xl text-sm font-medium transition-all text-slate-600 dark:text-surface-200/70 hover:bg-slate-50 dark:hover:bg-white/5 border border-transparent">
                    <span class="flex items-center gap-3">
                        <i data-lucide="share-2" class="w-4 h-4 text-blue-500"></i>
                        <span>Connected Accounts</span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-70"></i>
                </button>
            </div>
        </div>

        <!-- Right Column: Tab Panels -->
        <div class="lg:col-span-8">
            
            <!-- Hidden Photo Upload Form -->
            <form id="photoUploadForm" action="/resident/profile/photo" method="POST" enctype="multipart/form-data" class="hidden">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <input type="file" id="profilePhotoInput" name="photo" accept="image/jpeg,image/png,image/webp" onchange="document.getElementById('photoUploadForm').submit()">
            </form>

            <!-- 1. Personal Information Panel -->
            <div id="tab-panel-personal" class="profile-tab-panel">
                <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-white/10">
                        <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-500">
                            <i data-lucide="user-check" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-slate-900 dark:text-white">Personal Information</h2>
                            <p class="text-xs text-slate-500 dark:text-surface-200/50">Update your primary identity and residential contact information</p>
                        </div>
                    </div>

                    <form id="personalInfoForm" method="POST" action="/user/profile" class="space-y-6">
                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                        <div class="flex flex-col sm:flex-row gap-6 items-start">
                            <!-- Avatar Column -->
                            <div class="flex-shrink-0 mx-auto sm:mx-0">
                                <div class="relative group">
                                    {% if user.profile_photo %}
                                    <img src="{{ user.profile_photo }}" alt="{{ user.name }}" class="w-24 h-24 rounded-2xl object-cover border-2 border-brand-500/40 shadow-md shadow-brand-500/10">
                                    {% else %}
                                    <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center font-bold text-3xl shadow-md shadow-brand-500/25 border-2 border-brand-500/30">
                                        {{ user.name|first|upper }}
                                    </div>
                                    {% endif %}
                                    <label for="profilePhotoInput" class="absolute -bottom-1 -right-1 p-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white shadow-md cursor-pointer transition-all hover:scale-105" title="Change Profile Photo">
                                        <i data-lucide="camera" class="w-4 h-4"></i>
                                    </label>
                                </div>
                            </div>

                            <!-- Fields Column -->
                            <div class="flex-1 w-full space-y-4">
                                <!-- Full Name -->
                                <div class="relative">
                                    <input type="text" id="name" name="name" value="{{ user.name }}" required placeholder=" "
                                        class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                                    <label for="name" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                        Full Name <span class="text-rose-500">*</span>
                                    </label>
                                </div>

                                <!-- Email Address -->
                                <div class="relative">
                                    <input type="email" id="email" value="{{ user.email }}" disabled placeholder=" "
                                        class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-500 dark:text-white/50 bg-slate-100 dark:bg-white/[0.02] border border-slate-200 dark:border-white/5 rounded-xl cursor-not-allowed">
                                    <label for="email" class="absolute text-xs text-slate-400 dark:text-slate-500 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4">
                                        Email Address <span class="text-rose-500">*</span>
                                    </label>
                                    <span class="absolute right-3 top-4 text-[10px] text-slate-400 dark:text-slate-500 font-medium uppercase tracking-wider">Primary Login</span>
                                </div>

                                <!-- Phone Number + WhatsApp -->
                                <div>
                                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
                                        <!-- Country Code -->
                                        <div class="sm:col-span-3 relative">
                                            <input type="text" id="country_code" readonly value="+91 (IND)" placeholder=" "
                                                class="peer block w-full h-[52px] px-3.5 pt-5 pb-2 text-xs font-semibold font-mono text-slate-900 dark:text-white bg-slate-100 dark:bg-white/[0.03] border border-slate-300 dark:border-white/10 rounded-xl cursor-default">
                                            <label for="country_code" class="absolute text-[11px] text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-3.5">
                                                Country Code
                                            </label>
                                        </div>

                                        <!-- Phone Number -->
                                        {% set cleanPhone = profile.phone ? profile.phone|replace({'+91': '', ' ': ''}) : '' %}
                                        <div class="sm:col-span-6 relative">
                                            <input type="tel" id="phone" name="phone" value="{{ cleanPhone }}" pattern="[0-9]{10}" maxlength="10" placeholder=" " required
                                                class="peer block w-full h-[52px] px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all font-mono">
                                            <label for="phone" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                                Mobile Number <span class="text-rose-500">*</span>
                                            </label>
                                        </div>

                                        <!-- WhatsApp Enable -->
                                        <div class="sm:col-span-3">
                                            <label class="flex items-center justify-center gap-2 cursor-pointer select-none h-[52px] px-3.5 rounded-xl border border-slate-300 dark:border-white/10 bg-slate-50 dark:bg-white/[0.02] hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
                                                <input type="checkbox" name="is_whatsapp" value="1" {% if user.is_whatsapp|default(1) %}checked{% endif %}
                                                    class="w-4 h-4 rounded text-emerald-600 border-slate-300 focus:ring-emerald-500">
                                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200">
                                                    <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="currentColor">
                                                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.541 1.761.815 2.791.815 3.178 0 5.766-2.587 5.767-5.767.001-3.182-2.585-5.8-5.767-5.8zm3.376 8.21c-.143.402-.833.774-1.156.822-.317.048-.733.074-2.385-.609-1.996-.826-3.266-2.846-3.366-2.981-.1-.135-.808-1.077-.808-2.054 0-.978.508-1.46.689-1.659.181-.199.397-.249.529-.249.133 0 .265.002.381.008.123.006.287-.046.449.344.168.403.573 1.399.624 1.503.051.103.085.224.017.36-.068.136-.102.221-.203.34-.102.119-.215.265-.308.356-.103.1-.21.209-.091.414.119.205.529.873 1.135 1.414.78.696 1.438.911 1.643 1.013.205.103.326.086.447-.052.12-.138.516-.601.654-.807.137-.206.275-.172.463-.103.189.069 1.196.564 1.402.667.206.103.343.155.394.241.051.086.051.5-.092.902z"/>
                                                    </svg>
                                                    WhatsApp
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100 dark:border-white/10">
                            <button type="reset" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-sm font-medium text-slate-700 dark:text-surface-200/80 hover:bg-slate-100 dark:hover:bg-white/5 transition-all">
                                Cancel
                            </button>
                            <button type="submit" id="savePersonalInfoBtn" disabled
                                class="px-6 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-semibold shadow-md shadow-brand-500/20 hover:bg-brand-500 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 2. Change Password Panel -->
            <div id="tab-panel-password" class="profile-tab-panel hidden">
                <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-white/10">
                        <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 flex items-center justify-center text-slate-700 dark:text-white">
                            <i data-lucide="key-round" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-slate-900 dark:text-white">Change Password</h2>
                            <p class="text-xs text-slate-500 dark:text-surface-200/50">Ensure your account is using a long, random password to stay secure</p>
                        </div>
                    </div>

                    <form id="passwordForm" method="POST" action="/user/profile/password" class="space-y-4 max-w-xl">
                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                        <div class="relative">
                            <input type="password" id="current_password" name="current_password" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                            <label for="current_password" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Current Password
                            </label>
                        </div>

                        <div class="relative">
                            <input type="password" id="new_password" name="new_password" required minlength="6" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                            <label for="new_password" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                New Password (minimum 6 characters)
                            </label>
                        </div>

                        <div class="relative">
                            <input type="password" id="confirm_password" name="confirm_password" required minlength="6" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                            <label for="confirm_password" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Confirm New Password
                            </label>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100 dark:border-white/10">
                            <button type="reset" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-sm font-medium text-slate-700 dark:text-surface-200/80 hover:bg-slate-100 dark:hover:bg-white/5 transition-all">
                                Cancel
                            </button>
                            <button type="submit" id="savePasswordBtn" disabled
                                class="px-6 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-semibold shadow-md shadow-brand-500/20 hover:bg-brand-500 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 3. Emergency Contact Panel -->
            <div id="tab-panel-emergency" class="profile-tab-panel hidden">
                <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-white/10">
                        <div class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-500">
                            <i data-lucide="phone-call" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-slate-900 dark:text-white">Emergency Contact</h2>
                            <p class="text-xs text-slate-500 dark:text-surface-200/50">Designated person or next of kin to reach during society emergencies</p>
                        </div>
                    </div>

                    <form id="emergencyForm" method="POST" action="/user/profile/emergency" class="space-y-4 max-w-xl">
                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                        <div class="relative">
                            <input type="text" id="emergency_contact_name" name="emergency_contact_name" value="{{ user.emergency_contact_name|default('') }}" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                            <label for="emergency_contact_name" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Contact Person Name
                            </label>
                        </div>

                        <div class="relative">
                            <input type="tel" id="emergency_contact_phone" name="emergency_contact_phone" value="{{ user.emergency_contact_phone|default('') }}" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                            <label for="emergency_contact_phone" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Emergency Phone Number
                            </label>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100 dark:border-white/10">
                            <button type="reset" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-sm font-medium text-slate-700 dark:text-surface-200/80 hover:bg-slate-100 dark:hover:bg-white/5 transition-all">
                                Cancel
                            </button>
                            <button type="submit" id="saveEmergencyBtn" disabled
                                class="px-6 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-semibold shadow-md shadow-brand-500/20 hover:bg-brand-500 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 4. Security PIN Panel -->
            <div id="tab-panel-pin" class="profile-tab-panel hidden">
                <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-white/10">
                        <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-500">
                            <i data-lucide="lock" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-slate-900 dark:text-white">Security PIN</h2>
                            <p class="text-xs text-slate-500 dark:text-surface-200/50">Setup a 4-digit PIN for quick transactions and identity verification</p>
                        </div>
                    </div>

                    <form id="pinForm" method="POST" action="/user/profile/pin" class="space-y-4 max-w-xl">
                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                        <div class="relative">
                            <input type="password" id="pin" name="pin" required pattern="[0-9]{4}" maxlength="4" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all text-center tracking-widest text-lg font-bold">
                            <label for="pin" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                4-Digit Security PIN
                            </label>
                        </div>

                        <div class="relative">
                            <input type="password" id="confirm_pin" name="confirm_pin" required pattern="[0-9]{4}" maxlength="4" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all text-center tracking-widest text-lg font-bold">
                            <label for="confirm_pin" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Confirm 4-Digit Security PIN
                            </label>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100 dark:border-white/10">
                            <button type="reset" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-sm font-medium text-slate-700 dark:text-surface-200/80 hover:bg-slate-100 dark:hover:bg-white/5 transition-all">
                                Cancel
                            </button>
                            <button type="submit" id="savePinBtn" disabled
                                class="px-6 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-semibold shadow-md shadow-brand-500/20 hover:bg-brand-500 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 5. Connected Accounts Panel -->
            <div id="tab-panel-accounts" class="profile-tab-panel hidden">
                <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-white/10">
                        <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-500">
                            <i data-lucide="share-2" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-slate-900 dark:text-white">Connected Accounts</h2>
                            <p class="text-xs text-slate-500 dark:text-surface-200/50">Manage Single Sign-On (SSO) authentication providers</p>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/[0.02] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div class="flex items-center gap-3.5">
                                <div class="w-11 h-11 rounded-xl bg-white dark:bg-white/10 border border-slate-200 dark:border-white/10 flex items-center justify-center shrink-0 shadow-sm">
                                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-bold text-slate-900 dark:text-white">Google Account</span>
                                        {% if user.google_id %}
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30">
                                            Linked
                                        </span>
                                        {% else %}
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-200 dark:bg-white/10 text-slate-600 dark:text-surface-200/60">
                                            Not Connected
                                        </span>
                                        {% endif %}
                                    </div>
                                    <p class="text-xs text-slate-500 dark:text-surface-200/50 mt-0.5">
                                        {{ user.google_id ? 'Your account is linked for 1-click Google Sign-In' : 'Link Google to enable fast 1-click Sign-In with your Google credentials' }}
                                    </p>
                                </div>
                            </div>

                            <div class="shrink-0">
                                {% if user.google_id %}
                                <form action="/user/profile/disconnect-google" method="POST" data-confirm="Are you sure you want to unlink your Google account? You will need your password to log in.">
                                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                    <button type="submit" class="px-4 py-2 rounded-xl border border-rose-500/30 text-rose-600 dark:text-rose-400 hover:bg-rose-500/10 text-xs font-semibold transition-all">
                                        Unlink Google
                                    </button>
                                </form>
                                {% else %}
                                <a href="/auth/google" class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold shadow-sm transition-all flex items-center gap-1.5">
                                    <i data-lucide="link" class="w-3.5 h-3.5"></i>
                                    <span>Connect Google</span>
                                </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
function switchProfileTab(tab) {
    document.querySelectorAll('.profile-tab-panel').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.profile-tab-btn').forEach(btn => {
        btn.className = "profile-tab-btn w-full flex items-center justify-between px-4 py-3.5 rounded-xl text-sm font-medium transition-all text-slate-600 dark:text-surface-200/70 hover:bg-slate-50 dark:hover:bg-white/5 border border-transparent";
    });

    const activePanel = document.getElementById('tab-panel-' + tab);
    const activeBtn = document.getElementById('tab-btn-' + tab);
    if (activePanel) activePanel.classList.remove('hidden');
    if (activeBtn) {
        activeBtn.className = "profile-tab-btn w-full flex items-center justify-between px-4 py-3.5 rounded-xl text-sm font-medium transition-all bg-brand-500/10 text-brand-600 dark:text-brand-300 border border-brand-500/20";
    }

    // Update URL parameter without reload
    const url = new URL(window.location.href);
    url.searchParams.set('tab', tab);
    window.history.replaceState({}, '', url);
}

// Watch forms to enable submit buttons only on content change
function setupFormChangeWatcher(formId, submitBtnId) {
    const form = document.getElementById(formId);
    const submitBtn = document.getElementById(submitBtnId);
    if (!form || !submitBtn) return;

    const initialData = new FormData(form);
    const initialValues = {};
    for (let [k, v] of initialData.entries()) initialValues[k] = v;

    function checkChange() {
        const currentData = new FormData(form);
        let hasChanged = false;
        for (let [k, v] of currentData.entries()) {
            if (initialValues[k] !== v) {
                hasChanged = true;
                break;
            }
        }
        submitBtn.disabled = !hasChanged;
    }

    form.addEventListener('input', checkChange);
    form.addEventListener('change', checkChange);
    form.addEventListener('reset', () => {
        setTimeout(() => { submitBtn.disabled = true; }, 50);
    });
}

document.addEventListener('DOMContentLoaded', function() {
    setupFormChangeWatcher('personalInfoForm', 'savePersonalInfoBtn');
    setupFormChangeWatcher('passwordForm', 'savePasswordBtn');
    setupFormChangeWatcher('emergencyForm', 'saveEmergencyBtn');
    setupFormChangeWatcher('pinForm', 'savePinBtn');

    const params = new URLSearchParams(window.location.search);
    const initialTab = params.get('tab') || '{{ activeTab|default("personal") }}';
    if (['personal', 'password', 'emergency', 'pin', 'accounts'].includes(initialTab)) {
        switchProfileTab(initialTab);
    }
    if (window.lucide) lucide.createIcons();
});
</script>
{% endblock %}
