{% extends "layouts/mobile.html.twig" %}

{% block title %}Maintenance Bills & UPI Pay | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Maintenance Bills & Dues</h1>
            <p class="text-xs text-surface-200/60">View itemized dues and pay instantly using UPI or card</p>
        </div>
        <div class="flex items-center gap-2.5 flex-wrap">
            {% if totalPendingAmount > 0 and pendingBills|length > 0 %}
            <button type="button" onclick="openBulkUpiModal('{{ totalPendingAmount }}', '{{ pendingBills|length }}', '{{ pendingBills[0].society_name }}', '{{ pendingBills[0].upi_id ?: 'society@upi' }}', '{{ pendingBills[0].payee_name ?: pendingBills[0].society_name }}')" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-semibold text-white flex items-center gap-1.5 shadow-lg shadow-emerald-600/25 transition">
                <i data-lucide="layers" class="w-4 h-4"></i>
                <span>Bulk Pay with UPI (₹{{ totalPendingAmount|number_format(2) }})</span>
            </button>
            {% endif %}
            <a href="/resident/receipts" class="btn-primary !px-4 !py-2 text-xs font-semibold flex items-center gap-1.5">
                <i data-lucide="file-check-2" class="w-4 h-4"></i>
                <span>Payment Receipts</span>
            </a>
        </div>
    </div>

    {% if flash.success %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-sm flex items-center gap-2.5 font-medium">
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}
    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-800 dark:text-rose-300 text-sm flex items-center gap-2.5 font-medium">
        <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600 dark:text-rose-400 shrink-0"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <!-- Search & Status Filter Bar -->
    <div class="mb-5 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="relative flex-1 sm:max-w-xs">
            <i data-lucide="search" class="w-4 h-4 text-surface-200/40 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input type="text" id="billSearchInput" placeholder="Search bills by #, title, flat..." class="input-glass w-full !pl-10 !py-2 text-xs" oninput="filterResidentBills()">
        </div>
        <div class="flex items-center gap-1.5 overflow-x-auto">
            <button type="button" onclick="setBillStatusFilter('all')" class="bill-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-brand-500/20 text-brand-300" data-filter="all">All</button>
            <button type="button" onclick="setBillStatusFilter('pending')" class="bill-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium text-surface-200 hover:text-white hover:bg-white/5" data-filter="pending">Pending</button>
            <button type="button" onclick="setBillStatusFilter('paid')" class="bill-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium text-surface-200 hover:text-white hover:bg-white/5" data-filter="paid">Paid</button>
        </div>
    </div>

    <div id="residentBillsContainer" class="space-y-4">
        <div id="residentBillsEmptyFilterRow" class="hidden glass-panel rounded-2xl p-8 text-center text-xs text-surface-200/50">
            No bills matching your search or filter.
        </div>
        {% for bill in bills %}
        <div class="resident-bill-card glass-panel rounded-2xl p-5 sm:p-6 border {{ bill.status == 'pending' ? 'border-red-500/30 bg-red-500/[0.03]' : 'border-white/10' }} flex flex-col md:flex-row md:items-center justify-between gap-4" data-status="{{ bill.status }}">
            <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono text-xs text-surface-200/50">#{{ bill.bill_number }}</span>
                    <span class="text-xs px-2.5 py-0.5 rounded-full {{ bill.status == 'paid' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400' }} font-semibold">
                        {{ bill.status|capitalize }}
                    </span>
                    {% if bill.flat_no %}
                    <span class="text-xs font-mono px-2 py-0.5 rounded bg-white/10 text-brand-300">
                        Flat {{ bill.wing ? bill.wing ~ '-' : '' }}{{ bill.flat_no }}
                    </span>
                    {% endif %}
                </div>
                <h3 class="text-lg font-bold text-white">{{ bill.title }}</h3>
                <p class="text-xs text-surface-200/70">{{ bill.particulars ?: 'Standard Monthly Maintenance Charges' }}</p>
                <p class="text-xs text-surface-200/50">
                    {{ bill.society_name }} &middot; Due Date: <b class="text-white">{{ bill.due_date|date('M d, Y') }}</b>
                </p>
            </div>

            <div class="flex items-center gap-4 justify-between md:justify-end pt-3 md:pt-0 border-t md:border-t-0 border-white/5">
                <div class="text-right">
                    <p class="text-xs text-surface-200/50">Amount</p>
                    <p class="text-2xl font-extrabold font-mono text-white">₹{{ bill.amount|number_format(2) }}</p>
                </div>

                {% if bill.status == 'pending' %}
                    {% if bill.upi_id %}
                    <button type="button" onclick="openUpiModal('{{ bill.id }}', '{{ bill.amount }}', '{{ bill.bill_number }}', '{{ bill.society_name }}', '{{ bill.upi_id }}', '{{ bill.payee_name ?: bill.society_name }}')" class="btn-primary !px-5 !py-2.5 text-xs font-semibold flex items-center gap-2 shadow-lg shadow-brand-500/25">
                        <i data-lucide="qr-code" class="w-4 h-4"></i>
                        <span>Pay with UPI</span>
                    </button>
                    {% else %}
                    <span class="text-xs text-slate-500 dark:text-surface-200/50 bg-slate-100 dark:bg-white/5 px-3 py-2 rounded-xl border border-slate-200 dark:border-white/10 flex items-center gap-1.5" title="Committee has not configured society UPI ID yet">
                        <i data-lucide="info" class="w-3.5 h-3.5"></i>
                        <span>UPI Not Registered</span>
                    </span>
                    {% endif %}
                {% else %}
                <div class="text-right">
                    <span class="text-xs text-emerald-400 flex items-center gap-1 font-medium">
                        <i data-lucide="check-check" class="w-4 h-4"></i>
                        Paid on {{ bill.paid_at|date('M d, Y') }}
                    </span>
                </div>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="glass-panel rounded-2xl p-12 text-center border border-white/10">
            <i data-lucide="receipt" class="w-10 h-10 text-surface-200/30 mx-auto mb-2"></i>
            <p class="font-semibold text-white">No maintenance bills found.</p>
            <p class="text-xs text-surface-200/50 mt-1">You are all settled with your housing society.</p>
        </div>
        {% endfor %}
    </div>

</div>

<!-- 1-Click UPI Payment & QR Code Modal -->
<div id="upiModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md">
    <div class="glass-panel rounded-2xl max-w-md w-full p-6 border border-white/10 bg-surface-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
            <div class="flex items-center gap-2">
                <i data-lucide="smartphone" class="w-5 h-5 text-brand-400"></i>
                <h3 class="text-base font-bold text-white">Instant UPI Payment</h3>
            </div>
            <button type="button" onclick="document.getElementById('upiModal').classList.add('hidden')" class="text-surface-200/50 hover:text-white">✕</button>
        </div>

        <div class="text-center mb-5">
            <p class="text-xs text-surface-200/60" id="modalSocName">Society Name</p>
            <p class="text-3xl font-extrabold font-mono text-emerald-400 my-1" id="modalAmount">₹0.00</p>
            <p class="text-[11px] text-surface-200/50 font-mono" id="modalBillNo">Bill #</p>
        </div>

        <!-- Dynamic QR Code & 1-Click UPI Button -->
        <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 text-center mb-5">
            <div class="bg-white p-3 rounded-xl inline-block shadow-md mb-3">
                <img id="upiQrImage" src="" alt="UPI QR Code" class="w-40 h-40 object-contain">
            </div>
            <p class="text-[11px] text-surface-200/60 mb-3">Scan using GPay, PhonePe, Paytm, or BHIM</p>

            <a id="btnUpiIntent" href="#" class="btn-primary w-full !py-2.5 text-xs font-semibold flex items-center justify-center gap-2">
                <i data-lucide="external-link" class="w-4 h-4"></i>
                <span>Open Supported UPI App</span>
            </a>
        </div>

        <!-- Confirm Payment Reference Form -->
        <form id="recordPaymentForm" method="POST" action="">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <input type="hidden" name="payment_method" value="upi">

            <div class="mb-4">
                <label class="block text-xs font-semibold text-surface-200/70 mb-1">UPI Transaction Reference (UTR / Txn ID)</label>
                <input type="text" name="transaction_ref" placeholder="e.g. 238947238947 or GPay Ref" class="input-glass w-full text-xs font-mono" required>
                <p class="text-[10px] text-surface-200/40 mt-1">Enter your 12-digit UPI UTR number from your payment app.</p>
            </div>

            <div class="flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('upiModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-white/10 hover:bg-white/5 text-xs text-surface-200/80">Cancel</button>
                <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-semibold text-white flex items-center gap-1.5 shadow-lg shadow-emerald-600/25">
                    <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    <span>Send for confirmation</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Bulk UPI Payment Modal -->
<div id="bulkUpiModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md">
    <div class="glass-panel rounded-2xl max-w-md w-full p-6 border border-white/10 bg-surface-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
            <div class="flex items-center gap-2">
                <i data-lucide="layers" class="w-5 h-5 text-emerald-400"></i>
                <h3 class="text-base font-bold text-white">Bulk UPI Payment</h3>
            </div>
            <button type="button" onclick="document.getElementById('bulkUpiModal').classList.add('hidden')" class="text-surface-200/50 hover:text-white">✕</button>
        </div>

        <div class="text-center mb-5">
            <p class="text-xs text-surface-200/60" id="bulkModalSocName">Housing Society</p>
            <p class="text-3xl font-extrabold font-mono text-emerald-400 my-1" id="bulkModalAmount">₹0.00</p>
            <p class="text-[11px] text-surface-200/50 font-mono" id="bulkModalCount">0 Pending Bills</p>
        </div>

        <!-- Dynamic QR Code & 1-Click UPI Button -->
        <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 text-center mb-5">
            <div class="bg-white p-3 rounded-xl inline-block shadow-md mb-3">
                <img id="bulkUpiQrImage" src="" alt="Bulk UPI QR Code" class="w-40 h-40 object-contain">
            </div>
            <p class="text-[11px] text-surface-200/60 mb-3">Scan using GPay, PhonePe, Paytm, or BHIM</p>

            <a id="btnBulkUpiIntent" href="#" class="btn-primary w-full !py-2.5 text-xs font-semibold flex items-center justify-center gap-2">
                <i data-lucide="external-link" class="w-4 h-4"></i>
                <span>Open Supported UPI App</span>
            </a>
        </div>

        <!-- Confirm Payment Reference Form -->
        <form method="POST" action="/resident/bills/bulk-pay">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <input type="hidden" name="payment_method" value="upi">

            <div class="mb-4">
                <label class="block text-xs font-semibold text-surface-200/70 mb-1">UPI Transaction Reference (UTR / Txn ID)</label>
                <input type="text" name="transaction_ref" placeholder="e.g. 238947238947 or GPay Ref" class="input-glass w-full text-xs font-mono" required>
                <p class="text-[10px] text-surface-200/40 mt-1">Enter your 12-digit UPI UTR number from your payment app.</p>
            </div>

            <div class="flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('bulkUpiModal').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-white/10 hover:bg-white/5 text-xs text-surface-200/80">Cancel</button>
                <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-semibold text-white flex items-center gap-1.5 shadow-lg shadow-emerald-600/25">
                    <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    <span>Send for confirmation</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openUpiModal(billId, amount, billNo, socName, upiId, payeeName) {
        document.getElementById('modalSocName').textContent = socName;
        document.getElementById('modalAmount').textContent = '₹' + parseFloat(amount).toFixed(2);
        document.getElementById('modalBillNo').textContent = 'Bill: ' + billNo;
        
        // Build UPI Intent URI (Society Mitra Spec)
        const note = 'Maintenance ' + billNo;
        const upiUri = `upi://pay?pa=${encodeURIComponent(upiId)}&pn=${encodeURIComponent(payeeName)}&am=${amount}&tn=${encodeURIComponent(note)}&cu=INR`;
        
        // Set href on button for mobile users
        document.getElementById('btnUpiIntent').href = upiUri;

        // Generate QR code using QR Server API
        const qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + encodeURIComponent(upiUri);
        document.getElementById('upiQrImage').src = qrUrl;

        // Set action on form
        document.getElementById('recordPaymentForm').action = '/resident/bills/' + billId + '/pay';

        document.getElementById('upiModal').classList.remove('hidden');
    }

    function openBulkUpiModal(totalAmount, billCount, socName, upiId, payeeName) {
        document.getElementById('bulkModalSocName').textContent = socName;
        document.getElementById('bulkModalAmount').textContent = '₹' + parseFloat(totalAmount).toFixed(2);
        document.getElementById('bulkModalCount').textContent = billCount + ' Pending Bills Combined';
        
        const note = 'Bulk Maintenance ' + billCount + ' bills';
        const upiUri = `upi://pay?pa=${encodeURIComponent(upiId)}&pn=${encodeURIComponent(payeeName)}&am=${totalAmount}&tn=${encodeURIComponent(note)}&cu=INR`;
        
        document.getElementById('btnBulkUpiIntent').href = upiUri;
        const qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + encodeURIComponent(upiUri);
        document.getElementById('bulkUpiQrImage').src = qrUrl;

        document.getElementById('bulkUpiModal').classList.remove('hidden');
    }

    let currentBillFilter = 'all';
    function setBillStatusFilter(status) {
        currentBillFilter = status;
        document.querySelectorAll('.bill-filter-btn').forEach(btn => {
            if (btn.getAttribute('data-filter') === status) {
                btn.className = 'bill-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-brand-500/20 text-brand-300';
            } else {
                btn.className = 'bill-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium text-surface-200 hover:text-white hover:bg-white/5';
            }
        });
        filterResidentBills();
    }

    function filterResidentBills() {
        const query = (document.getElementById('billSearchInput').value || '').toLowerCase().trim();
        const cards = document.querySelectorAll('.resident-bill-card');
        let visible = 0;
        cards.forEach(card => {
            const status = card.getAttribute('data-status') || '';
            const text = card.textContent.toLowerCase();
            const matchesQuery = !query || text.includes(query);
            const matchesStatus = (currentBillFilter === 'all') || (status === currentBillFilter);

            if (matchesQuery && matchesStatus) {
                card.style.display = '';
                visible++;
            } else {
                card.style.display = 'none';
            }
        });

        const empty = document.getElementById('residentBillsEmptyFilterRow');
        if (empty) {
            empty.style.display = (visible === 0) ? '' : 'none';
        }
    }
</script>
{% endblock %}
