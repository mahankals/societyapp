{% extends "layouts/auth.html.twig" %}

{% block title %}Create Account | SocietyApp{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<style>
    .auth-gradient {
        background: radial-gradient(ellipse at 50% 0%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
                    radial-gradient(ellipse at 80% 50%, rgba(139, 92, 246, 0.1) 0%, transparent 40%),
                    radial-gradient(ellipse at 20% 80%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
    }
</style>

<div class="min-h-screen flex auth-gradient">
    <div class="hidden lg:flex lg:w-1/2 xl:w-2/5 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-brand-900/50 via-surface-950 to-surface-950"></div>
        <div class="absolute inset-0 grid-bg opacity-50"></div>
        
        <div class="relative z-10 flex flex-col justify-center px-16 xl:px-24">
            <div class="mb-12">
                <a href="/" class="inline-flex items-center gap-3 group">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-lg shadow-brand-500/30 group-hover:shadow-brand-500/50 transition-all">
                        <i data-lucide="building-2" class="w-7 h-7 text-white"></i>
                    </div>
                    <span class="text-2xl font-bold text-white">SocietyApp</span>
                </a>
            </div>
            
            <h1 class="text-4xl xl:text-5xl font-bold text-white mb-6 leading-tight">
                Join your<br>
                <span class="gradient-text">digital community</span>
            </h1>
            
            <p class="text-lg text-white/50 max-w-md leading-relaxed">
                Create your account in seconds and start managing your society operations with modern, intuitive tools.
            </p>
            
            <div class="mt-12 space-y-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/20 flex items-center justify-center">
                        <span class="text-lg font-bold text-brand-400">1</span>
                    </div>
                    <div>
                        <h4 class="text-white font-medium">Quick Setup</h4>
                        <p class="text-sm text-white/40">Create your account in under a minute</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/20 flex items-center justify-center">
                        <span class="text-lg font-bold text-brand-400">2</span>
                    </div>
                    <div>
                        <h4 class="text-white font-medium">Verify Your Email</h4>
                        <p class="text-sm text-white/40">Secure your account with email verification</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/20 flex items-center justify-center">
                        <span class="text-lg font-bold text-brand-400">3</span>
                    </div>
                    <div>
                        <h4 class="text-white font-medium">Access Dashboard</h4>
                        <p class="text-sm text-white/40">Start using all features instantly</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="absolute bottom-8 left-8 right-8 flex items-center justify-between text-sm text-white/30">
            <span>&copy; {{ "now"|date("Y") }} SocietyApp</span>
            <span>All rights reserved</span>
        </div>
    </div>
    
    <div class="flex-1 flex items-center justify-center p-6 sm:p-12">
        <div class="w-full max-w-md">
            <div class="lg:hidden mb-8 text-center">
                <a href="/" class="inline-flex items-center gap-3 group mb-6">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-lg shadow-brand-500/25">
                        <i data-lucide="building-2" class="w-6 h-6 text-white"></i>
                    </div>
                    <span class="text-xl font-bold text-white">SocietyApp</span>
                </a>
            </div>
            
            <div class="mb-8">
                <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2">Create your account</h2>
                <p class="text-white/50">Join your society's digital community today</p>
            </div>

            {% if error %}
            <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-center gap-3 animate-fade-in">
                <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0"></i>
                {{ error }}
            </div>
            {% endif %}

            {% if success %}
            <div class="mb-6 p-4 rounded-xl bg-green-500/10 border border-green-500/20 text-green-400 text-sm flex items-center gap-3 animate-fade-in">
                <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0"></i>
                {{ success }}
            </div>
            {% endif %}

            <form method="POST" action="/auth/register" class="space-y-5">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                <div>
                    <label for="name" class="block text-sm font-medium text-white/80 mb-2">Full name</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-lucide="user" class="w-5 h-5 text-white/30"></i>
                        </div>
                        <input type="text" id="name" name="name" required minlength="2" autocomplete="name"
                            class="w-full h-14 bg-white/[0.03] border border-white/[0.08] rounded-xl pl-12 pr-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                            placeholder="John Doe" value="{{ name }}">
                    </div>
                </div>

                <div>
                    <label for="email" class="block text-sm font-medium text-white/80 mb-2">Email address</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-lucide="mail" class="w-5 h-5 text-white/30"></i>
                        </div>
                        <input type="email" id="email" name="email" required autocomplete="email"
                            class="w-full h-14 bg-white/[0.03] border border-white/[0.08] rounded-xl pl-12 pr-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                            placeholder="you@example.com" value="{{ email }}">
                    </div>
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-white/80 mb-2">Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-lucide="lock" class="w-5 h-5 text-white/30"></i>
                        </div>
                        <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password"
                            class="w-full h-14 bg-white/[0.03] border border-white/[0.08] rounded-xl pl-12 pr-14 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                            placeholder="Create a strong password">
                        <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 pr-4 flex items-center text-white/40 hover:text-white/70 transition-colors">
                            <i data-lucide="eye" class="w-5 h-5"></i>
                        </button>
                    </div>
                    <div class="mt-2.5">
                        <div class="h-1.5 rounded-full bg-white/5 overflow-hidden">
                            <div id="password-strength" class="h-full w-0 transition-all duration-300 rounded-full"></div>
                        </div>
                        <p id="password-hint" class="text-xs text-white/30 mt-2">Use 8+ characters with a mix of letters, numbers & symbols</p>
                    </div>
                </div>

                <div>
                    <label for="confirm_password" class="block text-sm font-medium text-white/80 mb-2">Confirm password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i data-lucide="lock" class="w-5 h-5 text-white/30"></i>
                        </div>
                        <input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password"
                            class="w-full h-14 bg-white/[0.03] border border-white/[0.08] rounded-xl pl-12 pr-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                            placeholder="Confirm your password">
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <input type="checkbox" id="terms" name="terms" required class="w-5 h-5 mt-0.5 rounded-lg border-white/20 bg-white/5 text-brand-500 focus:ring-brand-500/30 focus:ring-offset-0 cursor-pointer">
                    <label for="terms" class="text-sm text-white/50 leading-relaxed">
                        I agree to the <a href="#" class="text-brand-400 hover:text-brand-300 transition-colors">Terms of Service</a> and <a href="#" class="text-brand-400 hover:text-brand-300 transition-colors">Privacy Policy</a>
                    </label>
                </div>

                <button type="submit" class="btn-primary w-full !h-14 !text-base !rounded-xl">
                    Create Account
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>

            <div class="relative my-8">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-white/[0.08]"></div>
                </div>
                <div class="relative flex justify-center">
                    <span class="px-4 bg-surface-950 text-xs text-white/30 uppercase tracking-wider">or sign up with</span>
                </div>
            </div>

            <button type="button" onclick="triggerGoogleRegisterPrompt()"
               class="flex items-center justify-center gap-3 w-full h-14 bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.08] rounded-xl text-white font-medium transition-all hover:border-white/[0.15]">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <span>Sign up with Google</span>
            </button>

            <p class="text-center text-sm text-white/50 mt-8">
                Already have an account? 
                <a href="{{ basePath }}auth/login" class="text-brand-400 hover:text-brand-300 font-medium transition-colors">Sign in</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
    
    document.getElementById('toggle-password').addEventListener('click', function() {
        const passwordInput = document.getElementById('password');
        const icon = this.querySelector('i');
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            icon.setAttribute('data-lucide', 'eye-off');
        } else {
            passwordInput.type = 'password';
            icon.setAttribute('data-lucide', 'eye');
        }
        lucide.createIcons();
    });

    document.getElementById('password').addEventListener('input', function() {
        const password = this.value;
        const strengthBar = document.getElementById('password-strength');
        const hint = document.getElementById('password-hint');
        
        let strength = 0;
        let color = 'bg-red-500';
        let text = 'Weak password';
        
        if (password.length >= 8) strength += 25;
        if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength += 25;
        if (/\d/.test(password)) strength += 25;
        if (/[^a-zA-Z0-9]/.test(password)) strength += 25;
        
        if (strength >= 75) {
            color = 'bg-green-500';
            text = 'Strong password';
        } else if (strength >= 50) {
            color = 'bg-yellow-500';
            text = 'Medium password';
        } else if (strength >= 25) {
            color = 'bg-orange-500';
            text = 'Fair password';
        }
        
        strengthBar.style.width = strength + '%';
        strengthBar.className = 'h-full transition-all duration-300 rounded-full ' + color;
        hint.textContent = text;
        hint.className = 'text-xs mt-2 ' + (strength >= 75 ? 'text-green-400' : strength >= 50 ? 'text-yellow-400' : 'text-white/30');
    });
</script>

{% if googleClientId and googleClientId != 'YOUR_GOOGLE_CLIENT_ID' %}
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
    let googleRegisterTokenClient = null;

    function initGoogleAuthRegister() {
        if (!window.google || !google.accounts) return;

        // 1. Initialize One Tap (passive)
        if (google.accounts.id) {
            try {
                google.accounts.id.initialize({
                    client_id: "{{ googleClientId }}",
                    callback: handleGoogleAuthRegisterResponse,
                    auto_select: false,
                    cancel_on_tap_outside: true
                });
                google.accounts.id.prompt((notification) => {
                    if (notification.isNotDisplayed()) {
                        console.log('Google One Tap suppressed:', notification.getNotDisplayedReason());
                    }
                });
            } catch (e) {
                console.warn('Google One Tap init error:', e);
            }
        }

        // 2. Initialize OAuth2 Token Client for button clicks (active popup)
        if (google.accounts.oauth2) {
            try {
                googleRegisterTokenClient = google.accounts.oauth2.initTokenClient({
                    client_id: "{{ googleClientId }}",
                    scope: 'email profile openid',
                    callback: async (tokenResponse) => {
                        if (tokenResponse && tokenResponse.access_token) {
                            await handleGoogleAuthRegisterResponse({ credential: tokenResponse.access_token });
                        } else if (tokenResponse && tokenResponse.error) {
                            console.error('Google token error:', tokenResponse);
                            alert('Google Sign-In was cancelled or failed: ' + (tokenResponse.error_description || tokenResponse.error));
                        }
                    }
                });
            } catch (e) {
                console.warn('Google OAuth2 init error:', e);
            }
        }
    }

    window.addEventListener('load', initGoogleAuthRegister);

    async function handleGoogleAuthRegisterResponse(response) {
        if (!response || !response.credential) return;
        try {
            const res = await fetch('/auth/google-one-tap', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ credential: response.credential })
            });
            const data = await res.json();
            if (data.success) {
                window.location.href = data.redirect || '/resident';
            } else {
                alert(data.error || 'Google Sign-In failed.');
            }
        } catch (err) {
            console.error('Google Auth error:', err);
            alert('An unexpected error occurred during Google Sign-In.');
        }
    }

    function triggerGoogleRegisterPrompt() {
        if (googleRegisterTokenClient) {
            googleRegisterTokenClient.requestAccessToken({ prompt: 'select_account' });
            return;
        }
        if (window.google && google.accounts && google.accounts.oauth2) {
            try {
                googleRegisterTokenClient = google.accounts.oauth2.initTokenClient({
                    client_id: "{{ googleClientId }}",
                    scope: 'email profile openid',
                    callback: async (tokenResponse) => {
                        if (tokenResponse && tokenResponse.access_token) {
                            await handleGoogleAuthRegisterResponse({ credential: tokenResponse.access_token });
                        }
                    }
                });
                googleRegisterTokenClient.requestAccessToken({ prompt: 'select_account' });
                return;
            } catch (e) {
                console.warn('OAuth2 client init error:', e);
            }
        }
        // Fallback to full OAuth redirect with absolute redirect URI
        const redirectUri = encodeURIComponent(window.location.origin + '/auth/google-callback');
        window.location.href = `https://accounts.google.com/o/oauth2/v2/auth?client_id={{ googleClientId }}&redirect_uri=${redirectUri}&response_type=code&scope=email%20profile&access_type=offline`;
    }
</script>
{% else %}
<script>
    function triggerGoogleRegisterPrompt() {
        alert('Google Sign-In is not configured yet on this platform.');
    }
</script>
{% endif %}
{% endblock %}
