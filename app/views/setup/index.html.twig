                    type: 'warning',
                    confirmText: 'Go to Step 5',
                    onConfirm: () => goToStep(5)
                });
                return;
            }

            // Try One Tap prompt
            if (window.google && google.accounts && google.accounts.id) {
                try {
                    google.accounts.id.initialize({
                        client_id: googleClientId,
                        callback: handleGoogleAdminOneTap,
                        auto_select: false,
                        cancel_on_tap_outside: false
                    });
                    google.accounts.id.prompt((notification) => {
                        if (notification.isNotDisplayed() || notification.isSkippedMoment()) {
                            openGoogleTokenClient(googleClientId);
                        }
                    });
                    return;
                } catch (e) {
                    console.warn('GIS prompt error:', e);
                }
            }

            openGoogleTokenClient(googleClientId);
        }

        function openGoogleTokenClient(googleClientId) {
            if (window.google && google.accounts && google.accounts.oauth2) {
                try {
                    const tokenClient = google.accounts.oauth2.initTokenClient({
                        client_id: googleClientId,
                        scope: 'email profile openid',
                        callback: async (tokenResponse) => {
                            if (tokenResponse && tokenResponse.access_token) {
                                try {
                                    const userInfoRes = await fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
                                        headers: { Authorization: `Bearer ${tokenResponse.access_token}` }
                                    });
                                    const profile = await userInfoRes.json();
                                    applyGoogleAdminProfile({
                                        email: profile.email,
                                        name: profile.name || ((profile.given_name || '') + ' ' + (profile.family_name || '')).trim() || profile.email.split('@')[0],
                                        google_id: profile.sub,
                                        picture: profile.picture
                                    });
                                } catch (e) {
                                    console.error('Failed to fetch userinfo from Google:', e);
                                }
                            }
                        }
                    });
                    tokenClient.requestAccessToken({ prompt: 'select_account' });
                } catch (e) {
                    console.warn('oauth2 token client failed:', e);
                }
            }
        }

