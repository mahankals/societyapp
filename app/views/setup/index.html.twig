        // Mobile Number with Country Dropdown & Pattern Restriction
        let phoneInputInitialized = false;
        function initAdminPhoneInput() {
            const hiddenPhone = document.getElementById('admin_phone');
            const countrySelect = document.getElementById('admin_phone_country');
            const nationalInput = document.getElementById('admin_phone_national');
            const badgeEl = document.getElementById('admin_phone_badge');
            const errEl = document.getElementById('admin_phone_error');
            const validIcon = document.getElementById('admin_phone_valid_icon');
            const hintEl = document.getElementById('admin_phone_hint');

            if (!hiddenPhone || !countrySelect || !nationalInput) return;

            // Parse initial value if present (e.g. "+91 9876543210")
            const rawVal = hiddenPhone.value.trim();
            if (rawVal) {
                let matched = false;
                for (const opt of countrySelect.options) {
                    const code = opt.value;
                    if (code && rawVal.startsWith(code)) {
                        countrySelect.value = code;
                        nationalInput.value = rawVal.substring(code.length).replace(/\D/g, '');
                        matched = true;
                        break;
                    }
                }
                if (!matched) {
                    countrySelect.value = '+91';
                    nationalInput.value = rawVal.replace(/\D/g, '').slice(-10);
                }
            } else {
                countrySelect.value = '+91';
            }

            function updatePhoneState() {
                const selectedOpt = countrySelect.options[countrySelect.selectedIndex];
                const countryCode = selectedOpt ? selectedOpt.value : '+91';
                const patternStr = selectedOpt?.getAttribute('data-pattern') || '^[6-9]\\d{9}$';
                const digits = selectedOpt?.getAttribute('data-digits') || '10';
                const placeholder = selectedOpt?.getAttribute('data-placeholder') || '98765 43210';
                const hint = selectedOpt?.getAttribute('data-hint') || '10-digit number starting with 6, 7, 8, or 9';

                nationalInput.placeholder = placeholder;
                nationalInput.maxLength = parseInt(digits, 10) || 15;

                if (badgeEl && selectedOpt) {
                    badgeEl.textContent = selectedOpt.text.split('(')[0].trim() + ' (' + (countryCode || 'Other') + ')';
                }
                if (hintEl && selectedOpt) {
                    hintEl.textContent = countryCode === '+91'
                        ? 'Default: India (+91) • Enter 10-digit mobile number starting with 6, 7, 8, or 9'
                        : `${selectedOpt.text.split('(')[0].trim()} • ${hint}`;
                }

                // Strip non-digits and leading zeros / country code if accidentally pasted
                let rawDigits = nationalInput.value.replace(/\D/g, '');
                if (countryCode === '+91') {
                    if (rawDigits.startsWith('91') && rawDigits.length > 10) {
                        rawDigits = rawDigits.substring(2);
                    } else if (rawDigits.startsWith('0') && rawDigits.length > 10) {
                        rawDigits = rawDigits.substring(1);
                    }
                    if (rawDigits.length > 10) {
                        rawDigits = rawDigits.slice(0, 10);
                    }
                } else if (countryCode === '+1') {
                    if (rawDigits.startsWith('1') && rawDigits.length > 10) {
                        rawDigits = rawDigits.substring(1);
                    }
                    if (rawDigits.length > 10) {
                        rawDigits = rawDigits.slice(0, 10);
                    }
                }
                nationalInput.value = rawDigits;

                const regex = new RegExp(patternStr);
                let isValid = false;

                if (rawDigits.length === 0) {
                    // Optional field: valid when blank
                    hiddenPhone.value = '';
                    if (errEl) {
                        errEl.classList.add('hidden');
                        errEl.innerHTML = '';
                    }
                    if (validIcon) validIcon.classList.add('hidden');
                    isValid = true;
                } else if (regex.test(rawDigits)) {
                    hiddenPhone.value = countryCode ? `${countryCode} ${rawDigits}` : rawDigits;
                    if (errEl) {
                        errEl.classList.add('hidden');
                        errEl.innerHTML = '';
                    }
                    if (validIcon) validIcon.classList.remove('hidden');
                    isValid = true;
                } else {
                    hiddenPhone.value = countryCode ? `${countryCode} ${rawDigits}` : rawDigits;
                    if (validIcon) validIcon.classList.add('hidden');
                    if (errEl) {
                        errEl.classList.remove('hidden');
                        if (countryCode === '+91') {
                            if (!/^[6-9]/.test(rawDigits)) {
                                errEl.innerHTML = '<i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i><span>Indian mobile number must start with 6, 7, 8, or 9</span>';
                            } else if (rawDigits.length < 10) {
                                errEl.innerHTML = `<i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i><span>Must be exactly 10 digits (${rawDigits.length}/10 entered)</span>`;
                            } else {
                                errEl.innerHTML = '<i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i><span>Invalid 10-digit mobile number format</span>';
                            }
                        } else {
                            errEl.innerHTML = `<i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i><span>Please enter a valid mobile number (${hint})</span>`;
                        }
                        lucide.createIcons();
                    }
                    isValid = false;
                }

                checkAdminValidity();
                return isValid;
            }

            if (!phoneInputInitialized) {
                countrySelect.addEventListener('change', updatePhoneState);
                nationalInput.addEventListener('input', updatePhoneState);
                nationalInput.addEventListener('keypress', (e) => {
                    if (!/[\d]/.test(e.key) && !e.ctrlKey && !e.metaKey) {
                        e.preventDefault();
                    }
                });
                nationalInput.addEventListener('paste', (e) => {
                    const pasted = (e.clipboardData || window.clipboardData)?.getData('text') || '';
                    for (const opt of countrySelect.options) {
                        const code = opt.value;
                        if (code && pasted.trim().startsWith(code)) {
                            countrySelect.value = code;
                            setTimeout(() => {
                                nationalInput.value = pasted.trim().substring(code.length).replace(/\D/g, '');
                                updatePhoneState();
                            }, 0);
                            return;
                        }
                    }
                });
                phoneInputInitialized = true;
            }

            updatePhoneState();
        }

        // Toggle password view
        function togglePassVisibility(id) {
            const input = document.getElementById(id);
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        // Copy text helper with visual tick confirmation (replaces icon with check and reverts)
        function copyText(elementId, btn) {
            const el = document.getElementById(elementId);
            if (!el) return;
            const text = (el.value !== undefined ? el.value : el.textContent).trim();
            navigator.clipboard.writeText(text).then(() => {
                if (btn) {
                    const originalHtml = btn.innerHTML;
                    btn.innerHTML = '<i data-lucide="check" class="w-4 h-4 text-emerald-400"></i>';
                    btn.classList.add('!bg-emerald-500/20', '!border-emerald-500/40');
                    lucide.createIcons();
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.classList.remove('!bg-emerald-500/20', '!border-emerald-500/40');
                        lucide.createIcons();
                    }, 2000);
                }
            });
        }

        // Modal Dialog System (replaces default alert & prompt)
        let modalConfirmCallback = null;

        function showModal({
            title = 'Action Required',
            message = '',
            type = 'warning',
            confirmText = 'Understood',
            showCancel = false,
            cancelText = 'Cancel',
            isPrompt = false,
            promptValue = '',
            onConfirm = null
        }) {
            const modal = document.getElementById('systemModal');
            const iconContainer = document.getElementById('modalIconContainer');
            const icon = document.getElementById('modalIcon');
            const titleEl = document.getElementById('modalTitle');
            const msgEl = document.getElementById('modalMessage');
            const confirmBtn = document.getElementById('modalConfirmBtn');
            const cancelBtn = document.getElementById('modalCancelBtn');
            const promptContainer = document.getElementById('modalPromptContainer');
            const promptInput = document.getElementById('modalPromptInput');

            titleEl.textContent = title;
            msgEl.textContent = message;
            confirmBtn.textContent = confirmText;
            cancelBtn.textContent = cancelText;

            if (type === 'error') {
                iconContainer.className = 'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-rose-500/20 text-rose-400';
                icon.setAttribute('data-lucide', 'alert-circle');
            } else if (type === 'success') {
                iconContainer.className = 'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-emerald-500/20 text-emerald-400';
                icon.setAttribute('data-lucide', 'check-circle-2');
            } else if (type === 'info') {
                iconContainer.className = 'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-blue-500/20 text-blue-400';
                icon.setAttribute('data-lucide', 'info');
            } else {
                iconContainer.className = 'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-amber-500/20 text-amber-400';
                icon.setAttribute('data-lucide', 'alert-triangle');
            }

            if (showCancel) {
                cancelBtn.classList.remove('hidden');
            } else {
                cancelBtn.classList.add('hidden');
            }

            if (isPrompt) {
                promptContainer.classList.remove('hidden');
                promptInput.value = promptValue;
                setTimeout(() => promptInput.focus(), 60);
            } else {
                promptContainer.classList.add('hidden');
            }

            modalConfirmCallback = onConfirm;
            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function closeModal() {
            document.getElementById('systemModal')?.classList.add('hidden');
            modalConfirmCallback = null;
        }

        function confirmModal() {
            const inputVal = document.getElementById('modalPromptInput')?.value || '';
            const cb = modalConfirmCallback;
            closeModal();
            if (typeof cb === 'function') {
                cb(inputVal);
            }
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
            if (e.key === 'Enter') {
                const modal = document.getElementById('systemModal');
                if (modal && !modal.classList.contains('hidden') && e.target.id === 'modalPromptInput') {
                    confirmModal();
                }
            }
        });

        document.getElementById('systemModal')?.addEventListener('click', (e) => {
            if (e.target.id === 'systemModal') closeModal();
        });

        // 7. Final Deployment Submission
        async function submitDeployment() {
            const deployBtn = document.getElementById('deployBtn');
            const errBanner = document.getElementById('deployErrorBanner');
            const errText = document.getElementById('deployErrorText');

            errBanner.classList.add('hidden');
            deployBtn.disabled = true;
            deployBtn.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i><span>Deploying & Initializing…</span>';
            lucide.createIcons();

            const form = document.getElementById('setupWizardForm');
            const formData = new FormData(form);
            const currentCsrf = document.getElementById('csrf_token')?.value || '';

            try {
                const res = await fetch('/setup/install', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-CSRF-Token': currentCsrf }
                });
                const data = await res.json();

                if (data.csrf_token || data.new_csrf_token) {
                    const csrfInput = document.getElementById('csrf_token');
                    if (csrfInput) csrfInput.value = data.csrf_token || data.new_csrf_token;
                }

                if (data.success) {
                    deployBtn.innerHTML = '<i data-lucide="check" class="w-5 h-5"></i><span>Deployment Complete!</span>';
                    setTimeout(() => {
                        window.location.href = data.redirect || '/admin';
                    }, 800);
                } else {
                    errText.textContent = data.error || 'Failed to complete deployment.';
                    errBanner.classList.remove('hidden');
                    deployBtn.disabled = false;
                    deployBtn.innerHTML = '<i data-lucide="rocket" class="w-5 h-5"></i><span>Retry Deployment</span>';
                    lucide.createIcons();
                }
            } catch (err) {
                errText.textContent = 'Server request failed: ' + err.message;
                errBanner.classList.remove('hidden');
                deployBtn.disabled = false;
                deployBtn.innerHTML = '<i data-lucide="rocket" class="w-5 h-5"></i><span>Retry Deployment</span>';
                lucide.createIcons();
            }
        }

        // Handle browser Back / Forward buttons
        window.addEventListener('popstate', (e) => {
            const urlParams = new URLSearchParams(window.location.search);
            const stepParam = urlParams.get('step');
            if (stepParam) {
                const stepNum = isNaN(stepParam) ? slugToStep[stepParam.toLowerCase()] : parseInt(stepParam, 10);
                if (stepNum && stepNum >= 1 && stepNum <= totalSteps) {
                    goToStep(stepNum, false);
                    return;
                }
            }
            goToStep(1, false);
        });

        // Initialize state on load
        document.addEventListener('DOMContentLoaded', () => {
            goToStep(currentStep, false);

            checkBrandingValidity();
            checkAdminValidity();

            if (completedSteps.database) {
                dbTestPassed = true;
                const dbBtn = document.getElementById('dbNextBtn');
                if (dbBtn) dbBtn.disabled = false;
                const dbStatus = document.getElementById('dbTestStatus');
                if (dbStatus) dbStatus.innerHTML = '<span class="text-emerald-400 font-semibold">✓ Database verified in database</span>';
            }
            if (completedSteps.email) {
                emailTestPassed = true;
                const emailBtn = document.getElementById('emailNextBtn');
                if (emailBtn) emailBtn.disabled = false;
                const emailStatus = document.getElementById('emailTestStatus');
                if (emailStatus) emailStatus.innerHTML = '<span class="text-emerald-400 font-semibold">✓ SMTP verified in database</span>';
            }
            if (completedSteps.google) {
                googleTestPassed = true;
                const gBtn = document.getElementById('googleNextBtn');
                if (gBtn) gBtn.disabled = false;
                const gStatus = document.getElementById('googleTestStatus');
                if (gStatus) gStatus.innerHTML = '<span class="text-emerald-400 font-semibold">✓ Google SSO verified in database</span>';
            }

            initAdminPhoneInput();
            syncGoogleLinkState();
            updateReviewSummary();
            if (currentStep === 6) {
                initGoogleOneTapInSetup();
            }

            // Ensure URL parameter matches current step if not present
            const urlParams = new URLSearchParams(window.location.search);
            if (!urlParams.get('step')) {
                const slug = stepSlugs[currentStep];
                window.history.replaceState({ step: currentStep, slug: slug }, '', window.location.pathname + '?step=' + slug);
            }

            lucide.createIcons();
        });
    </script>
</body>
</html>
