                                        <div class="mt-0.5 w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 
                                            {% if n.type == 'warning' %}bg-amber-500/20 text-amber-400
                                             {% elseif n.type == 'error' %}bg-red-500/20 text-red-400
                                             {% elseif n.type == 'success' %}bg-emerald-500/20 text-emerald-400
                                             {% elseif n.type == 'announcement' %}bg-purple-500/20 text-purple-400
                                             {% else %}bg-brand-500/20 text-brand-400{% endif %}">
                                            {% if n.type == 'warning' %}<i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>
                                            {% elseif n.type == 'error' %}<i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
                                            {% elseif n.type == 'success' %}<i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                                            {% elseif n.type == 'announcement' %}<i data-lucide="megaphone" class="w-3.5 h-3.5"></i>
                                            {% else %}<i data-lucide="bell" class="w-3.5 h-3.5"></i>{% endif %}
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center justify-between gap-2 mb-0.5">
