<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
    <meta name="description" content="{{ appDesc|default('The premium management platform for modern residential communities.') }}">
    <meta name="theme-color" content="#10b981">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="{{ appName|default('SocietyApp') }}">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="{{ appFavicon|default('/assets/icons/logo.svg') }}">
    <link rel="apple-touch-icon" href="{{ appLogo|default('/assets/icons/logo.svg') }}">
    <title>{% block title %}{{ appName|default('SocietyApp') }}{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Lexend:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="/assets/dist/output.css?v={{ cssVersion }}" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="/assets/js/offline.js"></script>
    <script src="/assets/js/dropdown.js?v={{ cssVersion }}"></script>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('societyapp_theme') || 'system';
            function applyTheme(theme) {
                const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.classList.remove('light', 'dark');
                document.documentElement.classList.add(isDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-color-mode', theme);
            }
            applyTheme(savedTheme);
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
                if ((localStorage.getItem('societyapp_theme') || 'system') === 'system') {
                    applyTheme('system');
                    if (window.updateThemeUI) window.updateThemeUI('system');
                }
            });
        })();
    </script>
    <style>
        body {
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            padding-top: env(safe-area-inset-top);
            padding-bottom: env(safe-area-inset-bottom);
            padding-left: env(safe-area-inset-left);
            padding-right: env(safe-area-inset-right);
        }
        .glass-panel { background: rgba(255,255,255,0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08); }
        .noise-overlay { position: fixed; inset: 0; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E"); opacity: 0.015; pointer-events: none; z-index: 9999; }
        
        /* High-Visibility Input Styling */
        .input-glass {
            display: block;
            width: 100%;
            background-color: rgba(255, 255, 255, 0.07) !important;
            border: 1px solid rgba(255, 255, 255, 0.22) !important;
            border-radius: 0.75rem !important;
            padding: 0.625rem 0.875rem !important;
            color: #ffffff !important;
            font-size: 0.875rem;
            line-height: 1.25rem;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            box-sizing: border-box;
        }
        .input-glass:focus {
            outline: none !important;
            border-color: #10b981 !important;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25) !important;
            background-color: rgba(255, 255, 255, 0.12) !important;
        }
        .input-glass::placeholder {
            color: rgba(255, 255, 255, 0.4) !important;
        }
        html:not(.light) .input-glass option, html:not(.light) select.input-glass option {
            background-color: #0f172a !important;
            color: #ffffff !important;
        }
        input[type="date"].input-glass::-webkit-calendar-picker-indicator,
        input[type="month"].input-glass::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
            opacity: 0.75;
        }
        html.light input[type="date"].input-glass::-webkit-calendar-picker-indicator,
        html.light input[type="month"].input-glass::-webkit-calendar-picker-indicator {
            filter: none;
        }

        #profile-dropdown, #notifications-dropdown, #theme-dropdown {
            opacity: 1 !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }

        /* Dark Mode Dropdowns */
        html.dark #profile-dropdown,
        html.dark #notifications-dropdown,
        html.dark #theme-dropdown,
        html:not(.light) #profile-dropdown,
        html:not(.light) #notifications-dropdown,
        html:not(.light) #theme-dropdown {
            background-color: #0f172a !important;
            background: #0f172a !important;
            border-color: rgba(255, 255, 255, 0.15) !important;
        }
        html.dark #profile-dropdown-header,
        html.dark #notifications-dropdown-header,
        html.dark #notifications-dropdown-footer,
        html:not(.light) #profile-dropdown-header,
        html:not(.light) #notifications-dropdown-header,
        html:not(.light) #notifications-dropdown-footer {
            background-color: #090d16 !important;
            background: #090d16 !important;
            border-color: rgba(255, 255, 255, 0.1) !important;
        }
        html.dark #profile-dropdown-body,
        html.dark #notifications-dropdown-body,
        html.dark #theme-options-list,
        html:not(.light) #profile-dropdown-body,
        html:not(.light) #notifications-dropdown-body,
        html:not(.light) #theme-options-list {
            background-color: #0f172a !important;
            background: #0f172a !important;
        }

        /* Light Mode Dropdowns */
        html.light #profile-dropdown,
        html.light #notifications-dropdown,
        html.light #theme-dropdown,
        [data-theme="light"] #profile-dropdown,
        [data-theme="light"] #notifications-dropdown,
        [data-theme="light"] #theme-dropdown {
            background-color: #ffffff !important;
            background: #ffffff !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
        }
        html.light #profile-dropdown-header,
        html.light #notifications-dropdown-header,
        html.light #notifications-dropdown-footer,
        [data-theme="light"] #profile-dropdown-header,
        [data-theme="light"] #notifications-dropdown-header,
        [data-theme="light"] #notifications-dropdown-footer {
            background-color: #f8fafc !important;
            background: #f8fafc !important;
            border-color: #e2e8f0 !important;
        }
        html.light #profile-dropdown-body,
        html.light #notifications-dropdown-body,
        html.light #theme-options-list,
        [data-theme="light"] #profile-dropdown-body,
        [data-theme="light"] #notifications-dropdown-body,
        [data-theme="light"] #theme-options-list {
            background-color: #ffffff !important;
            background: #ffffff !important;
        }
        html.light #profile-dropdown-header p.text-white,
        [data-theme="light"] #profile-dropdown-header p.text-white {
            color: #0f172a !important;
        }
        html.light #profile-dropdown-header p.text-surface-200\/50,
        [data-theme="light"] #profile-dropdown-header p.text-surface-200\/50 {
            color: #64748b !important;
        }
        html.light #profile-dropdown a,
        [data-theme="light"] #profile-dropdown a {
            color: #334155 !important;
        }
        html.light #profile-dropdown a:hover,
        [data-theme="light"] #profile-dropdown a:hover {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
        }
        html.light #profile-dropdown a[href="/auth/logout"],
        [data-theme="light"] #profile-dropdown a[href="/auth/logout"] {
            color: #dc2626 !important;
        }
        html.light #profile-dropdown a[href="/auth/logout"]:hover,
        [data-theme="light"] #profile-dropdown a[href="/auth/logout"]:hover {
            background-color: #fef2f2 !important;
            color: #b91c1c !important;
        }
        html.light #profile-dropdown .bg-white\/10,
        [data-theme="light"] #profile-dropdown .bg-white\/10 {
            background-color: #e2e8f0 !important;
        }

        /* Society Switcher Dropdown */
        html.dark #society-switcher-dropdown,
        html:not(.light) #society-switcher-dropdown {
            background-color: #0f172a !important;
            background: #0f172a !important;
            border-color: rgba(255, 255, 255, 0.15) !important;
        }
        html.light #society-switcher-dropdown,
        [data-theme="light"] #society-switcher-dropdown {
            background-color: #ffffff !important;
            background: #ffffff !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
        }
        html.light #society-switcher-dropdown a,
        [data-theme="light"] #society-switcher-dropdown a {
            color: #334155 !important;
        }
        html.light #society-switcher-dropdown a:hover,
        [data-theme="light"] #society-switcher-dropdown a:hover {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
        }
        html.light #society-switcher-btn,
        [data-theme="light"] #society-switcher-btn {
            background-color: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

        /* Sidebar Light Mode */
        html.light aside,
        [data-theme="light"] aside {
            background-color: #ffffff !important;
            border-color: #e2e8f0 !important;
            box-shadow: 1px 0 3px 0 rgba(0, 0, 0, 0.05) !important;
        }
        html.light aside a.text-surface-200\/70,
        [data-theme="light"] aside a.text-surface-200\/70 {
            color: #475569 !important;
        }
        html.light aside a:hover,
        [data-theme="light"] aside a:hover {
            color: #0f172a !important;
            background-color: #f1f5f9 !important;
        }

        /* Breadcrumb Bar Light Mode */
        html.light div.breadcrumb-bar,
        [data-theme="light"] div.breadcrumb-bar {
            background-color: rgba(255, 255, 255, 0.95) !important;
            border-bottom: 1px solid #e2e8f0 !important;
        }
        html.light div.breadcrumb-bar span.text-white,
        [data-theme="light"] div.breadcrumb-bar span.text-white {
            color: #0f172a !important;
        }
        html.light div.breadcrumb-bar a,
        [data-theme="light"] div.breadcrumb-bar a {
            color: #475569 !important;
        }

        /* Sidebar Transitions for Desktop + Tablet */
        @media (min-width: 768px) {
            #desktop-sidebar {
                transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            }
            #main-header {
                transition: left 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            }
            #main-content {
                transition: padding-left 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            }
        }

        /* Tablet View (768px to 1023px): Default sidebar menu title is hidden */
        @media (min-width: 768px) and (max-width: 1023px) {
            body:not(.sidebar-expanded) #desktop-sidebar {
                width: 5rem !important;
            }
            body:not(.sidebar-expanded) #main-header {
                left: 5rem !important;
            }
            body:not(.sidebar-expanded) #main-content {
                padding-left: 5rem !important;
            }
            body:not(.sidebar-expanded) #desktop-sidebar .sidebar-label,
            body:not(.sidebar-expanded) #desktop-sidebar .sidebar-badge,
            body:not(.sidebar-expanded) #desktop-sidebar .sidebar-brand-text {
                display: none !important;
            }
            body:not(.sidebar-expanded) #desktop-sidebar .sidebar-item,
            body:not(.sidebar-expanded) #desktop-sidebar .sidebar-brand-container,
            body:not(.sidebar-expanded) #desktop-sidebar .sidebar-footer-link {
                justify-content: center !important;
                padding-left: 0.5rem !important;
                padding-right: 0.5rem !important;
            }
        }

        /* Desktop View (1024px+): Menu titles visible by default, hidden when .sidebar-collapsed */
        @media (min-width: 1024px) {
            body.sidebar-collapsed #desktop-sidebar {
                width: 5rem !important;
            }
            body.sidebar-collapsed #main-header {
                left: 5rem !important;
            }
            body.sidebar-collapsed #main-content {
                padding-left: 5rem !important;
            }
            body.sidebar-collapsed #desktop-sidebar .sidebar-label,
            body.sidebar-collapsed #desktop-sidebar .sidebar-badge,
            body.sidebar-collapsed #desktop-sidebar .sidebar-brand-text {
                display: none !important;
            }
            body.sidebar-collapsed #desktop-sidebar .sidebar-item,
            body.sidebar-collapsed #desktop-sidebar .sidebar-brand-container,
            body.sidebar-collapsed #desktop-sidebar .sidebar-footer-link {
                justify-content: center !important;
                padding-left: 0.5rem !important;
                padding-right: 0.5rem !important;
            }
        }
    </style>
    {% block styles %}{% endblock %}
<body class="min-h-screen flex flex-col bg-surface-950">
    <div class="noise-overlay"></div>

    {% set isAdminView = currentRoute starts with '/admin' %}
    {% set isCommitteeView = currentRoute starts with '/comitee' or currentRoute starts with '/committee' or currentRoute starts with '/committe' %}

    <!-- Desktop Sidebar Navigation -->
    {% if user %}
    <aside id="desktop-sidebar" class="hidden md:flex flex-col fixed inset-y-0 left-0 w-64 bg-surface-950/95 backdrop-blur-xl border-r border-white/10 z-[110]">
        <!-- Brand / Logo Area -->
        <div class="sidebar-brand-container h-16 flex items-center gap-3 px-5 border-b border-white/10 shrink-0">
            <a href="{{ isAdminView ? '/admin' : (isCommitteeView ? '/comitee' : '/resident') }}" class="flex items-center gap-2.5 group">
                <img src="{{ appLogo|default('/assets/icons/logo.svg') }}" alt="{{ appName|default('SocietyApp') }}" class="w-8 h-8 rounded-lg object-contain shrink-0">
                <span class="sidebar-brand-text text-base font-bold text-white tracking-tight">{{ appName|default('SocietyApp') }}</span>
            </a>
            {% if isAdminView %}
            <span class="sidebar-badge ml-auto inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-brand-500/20 text-brand-300 border border-brand-500/30">Admin</span>
            {% elseif isCommitteeView %}
            <span class="sidebar-badge ml-auto inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">Committee</span>
            {% endif %}
        </div>

        <!-- Sidebar Navigation Menu Links -->
        <div class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
            {% if isAdminView %}
                <a href="/admin" title="Dashboard" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute == '/admin' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="layout-dashboard" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Dashboard</span>
                </a>
                <a href="/admin/societies" title="Societies" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/admin/societies' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="building-2" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Societies</span>
                </a>
                <a href="/admin/users" title="Users" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/admin/users' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="users" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Users</span>
                </a>
                <a href="/admin/invitations" title="Invitations" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/admin/invitations' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="mail-plus" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Invitations</span>
                </a>
                <a href="/admin/settings" title="Settings" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/admin/settings' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="settings" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Settings</span>
                </a>
            {% elseif isCommitteeView %}
                <a href="/comitee" title="Dashboard" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute == '/comitee' or currentRoute == '/committee' ? 'bg-amber-500/15 text-amber-300 font-semibold' : 'text-amber-300/80 hover:text-amber-200 hover:bg-amber-500/10' }}">
                    <i data-lucide="shield" class="w-4 h-4 text-amber-400 shrink-0"></i>
                    <span class="sidebar-label">Dashboard</span>
                </a>
                <a href="/comitee/flats" title="Flats" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/comitee/flats' ? 'bg-amber-500/15 text-amber-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="building" class="w-4 h-4 text-amber-400 shrink-0"></i>
                    <span class="sidebar-label">Flats</span>
                </a>
                <a href="/comitee/members" title="Members" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/comitee/members' ? 'bg-amber-500/15 text-amber-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="users" class="w-4 h-4 text-amber-400 shrink-0"></i>
                    <span class="sidebar-label">Members</span>
                </a>
                <a href="/comitee/bills" title="Bills" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/comitee/bills' ? 'bg-amber-500/15 text-amber-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="receipt" class="w-4 h-4 text-amber-400 shrink-0"></i>
                    <span class="sidebar-label">Bills</span>
                </a>
                <a href="/comitee/expenses" title="Expenses" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/comitee/expenses' ? 'bg-amber-500/15 text-amber-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="credit-card" class="w-4 h-4 text-amber-400 shrink-0"></i>
                    <span class="sidebar-label">Expenses</span>
                </a>
                <a href="/comitee/accounting" title="Accounting" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/comitee/accounting' ? 'bg-amber-500/15 text-amber-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="landmark" class="w-4 h-4 text-amber-400 shrink-0"></i>
                    <span class="sidebar-label">Accounting</span>
                </a>
                <a href="/comitee/broadcast" title="Broadcast" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/comitee/broadcast' ? 'bg-amber-500/15 text-amber-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="megaphone" class="w-4 h-4 text-amber-400 shrink-0"></i>
                    <span class="sidebar-label">Broadcast</span>
                </a>
                <a href="/comitee/requests" title="Requests" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/comitee/requests' ? 'bg-amber-500/15 text-amber-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="message-square" class="w-4 h-4 text-amber-400 shrink-0"></i>
                    <span class="sidebar-label">Requests</span>
                </a>
            {% else %}
                <a href="/resident" title="Dashboard" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute == '/resident' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="layout-dashboard" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Dashboard</span>
                </a>
                {% if not (user.user_type == 'tenant' or userCaps.isTenant) %}
                <a href="/resident/bills" title="Bills & Dues" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/resident/bills' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="receipt" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Bills &amp; Dues</span>
                </a>
                <a href="/resident/receipts" title="Receipts" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/resident/receipts' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="file-check-2" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Receipts</span>
                </a>
                {% endif %}
                <a href="/resident/members" title="Members" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all {{ currentRoute starts with '/resident/members' ? 'bg-brand-500/15 text-brand-300 font-semibold' : 'text-surface-200/70 hover:text-white hover:bg-white/5' }}">
                    <i data-lucide="users" class="w-4 h-4 text-brand-400 shrink-0"></i>
                    <span class="sidebar-label">Members</span>
                </a>
            {% endif %}
        </div>

        <!-- Sidebar Footer Quick Links -->
        <div class="p-3 border-t border-white/10 shrink-0 space-y-1">
            <a href="/society/contribute" title="Contribute Society" class="sidebar-footer-link flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium text-surface-200/70 hover:text-white hover:bg-white/5 transition-all">
                <i data-lucide="plus-circle" class="w-4 h-4 text-amber-400 shrink-0"></i>
                <span class="sidebar-label">Contribute Society</span>
            </a>
