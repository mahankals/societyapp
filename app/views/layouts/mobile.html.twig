            {% else %}
                {# Resident Mobile Bottom Items #}
                <a href="/resident" class="flex flex-col items-center gap-1 {{ currentRoute == '/resident' ? 'text-brand-400' : 'text-surface-200/60 hover:text-white' }} transition-colors">
                    <i data-lucide="home" class="w-5 h-5"></i>
                    <span class="text-[10px] font-medium">Home</span>
                </a>
                {% if not (user.user_type == 'tenant' or userCaps.isTenant) %}
                <a href="/resident/bills" class="flex flex-col items-center gap-1 {{ currentRoute starts with '/resident/bills' ? 'text-brand-400' : 'text-surface-200/60 hover:text-white' }} transition-colors">
                    <i data-lucide="receipt" class="w-5 h-5"></i>
                    <span class="text-[10px] font-medium">Bills</span>
                </a>
                <a href="/resident/receipts" class="flex flex-col items-center gap-1 {{ currentRoute starts with '/resident/receipts' ? 'text-brand-400' : 'text-surface-200/60 hover:text-white' }} transition-colors">
                    <i data-lucide="file-check-2" class="w-5 h-5"></i>
                    <span class="text-[10px] font-medium">Receipts</span>
                </a>
                {% endif %}
                <a href="/resident/members" class="flex flex-col items-center gap-1 {{ currentRoute starts with '/resident/members' ? 'text-brand-400' : 'text-surface-200/60 hover:text-white' }} transition-colors">
                    <i data-lucide="users" class="w-5 h-5"></i>
                    <span class="text-[10px] font-medium">Members</span>
                </a>
            {% endif %}
        </div>
    </nav>
    {% endif %}


    <script>
        lucide.createIcons();
        
        const profileBtn = document.getElementById('profile-menu-btn');
        const profileDropdown = document.getElementById('profile-dropdown');
        const notifBtn = document.getElementById('notifications-menu-btn');
        const notifDropdown = document.getElementById('notifications-dropdown');
        const themeBtn = document.getElementById('theme-menu-btn');
        const themeDropdown = document.getElementById('theme-dropdown');
        const socBtn = document.getElementById('society-switcher-btn');
        const socDropdown = document.getElementById('society-switcher-dropdown');

        // Theme Switcher Logic
        window.updateThemeUI = function(theme) {
            const activeIconWrapper = document.getElementById('theme-active-icon-wrapper');
            const activeLabel = document.getElementById('theme-active-label');
            
            if (activeLabel) {
                activeLabel.textContent = theme.charAt(0).toUpperCase() + theme.slice(1);
            }

            if (activeIconWrapper) {
                let iconName = 'monitor';
                let iconClass = 'text-purple-400';
                if (theme === 'light') {
                    iconName = 'sun';
                    iconClass = 'text-amber-400';
                } else if (theme === 'dark') {
                    iconName = 'moon';
                    iconClass = 'text-blue-400';
                }
                activeIconWrapper.className = `flex items-center ${iconClass}`;
                activeIconWrapper.innerHTML = `<i data-lucide="${iconName}" class="w-5 h-5"></i>`;
                if (window.lucide && window.lucide.createIcons) {
                    window.lucide.createIcons();
                }
            }

            document.querySelectorAll('.theme-option-btn').forEach(btn => {
                const checkIcon = btn.querySelector('.theme-check-icon');
                const val = btn.getAttribute('data-theme-value');
                if (checkIcon) {
                    if (val === theme) {
                        checkIcon.classList.remove('hidden');
                        btn.classList.add('bg-white/10', 'font-semibold');
                    } else {
                        checkIcon.classList.add('hidden');
                        btn.classList.remove('bg-white/10', 'font-semibold');
                    }
                }
            });
        };

        window.setAppTheme = function(theme) {
            localStorage.setItem('societyapp_theme', theme);
            const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.remove('light', 'dark');
            document.documentElement.classList.add(isDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-color-mode', theme);
            
            window.updateThemeUI(theme);
            if (themeDropdown) {
                themeDropdown.classList.add('hidden');
            }
        };

        // Initialize UI with saved or default system theme
        const currentSavedTheme = localStorage.getItem('societyapp_theme') || 'system';
        window.updateThemeUI(currentSavedTheme);

        if (themeBtn && themeDropdown) {
            themeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (profileDropdown) profileDropdown.classList.add('hidden');
                if (notifDropdown) notifDropdown.classList.add('hidden');
                if (socDropdown) socDropdown.classList.add('hidden');
                themeDropdown.classList.toggle('hidden');
            });
            themeDropdown.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        }

        if (profileBtn && profileDropdown) {
            profileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (notifDropdown) notifDropdown.classList.add('hidden');
                if (themeDropdown) themeDropdown.classList.add('hidden');
                if (socDropdown) socDropdown.classList.add('hidden');
                profileDropdown.classList.toggle('hidden');
            });
            profileDropdown.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        }

        if (notifBtn && notifDropdown) {
            notifBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (profileDropdown) profileDropdown.classList.add('hidden');
                if (themeDropdown) themeDropdown.classList.add('hidden');
                if (socDropdown) socDropdown.classList.add('hidden');
                notifDropdown.classList.toggle('hidden');
            });
            notifDropdown.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        }

        if (socBtn && socDropdown) {
            socBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (profileDropdown) profileDropdown.classList.add('hidden');
                if (themeDropdown) themeDropdown.classList.add('hidden');
                if (notifDropdown) notifDropdown.classList.add('hidden');
                socDropdown.classList.toggle('hidden');
            });
            socDropdown.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        }

        document.addEventListener('click', () => {
            if (profileDropdown) profileDropdown.classList.add('hidden');
            if (notifDropdown) notifDropdown.classList.add('hidden');
            if (themeDropdown) themeDropdown.classList.add('hidden');
            if (socDropdown) socDropdown.classList.add('hidden');
        });

        // Desktop & Tablet Sidebar Toggler (Collapse / Expand)
        const sidebarToggleBtn = document.getElementById('sidebar-toggle-btn');
        if (sidebarToggleBtn) {
            function isTablet() {
                return window.innerWidth >= 768 && window.innerWidth < 1024;
            }

            function isCollapsed() {
                if (isTablet()) {
                    return !document.body.classList.contains('sidebar-expanded');
                }
                return document.body.classList.contains('sidebar-collapsed');
            }

            function updateSidebarToggleIcon() {
                const collapsed = isCollapsed();
                const icon = document.getElementById('sidebar-toggle-icon');
                if (icon) {
                    icon.setAttribute('data-lucide', collapsed ? 'panel-left-open' : 'panel-left-close');
                    if (window.lucide) { lucide.createIcons(); }
                }
                sidebarToggleBtn.setAttribute('title', collapsed ? 'Expand Sidebar' : 'Collapse Sidebar');
            }

            // Restore explicit user preference if present
            const savedState = localStorage.getItem('sidebar_state');
            if (savedState === 'expanded' && isTablet()) {
                document.body.classList.add('sidebar-expanded');
            } else if (savedState === 'collapsed' && !isTablet()) {
                document.body.classList.add('sidebar-collapsed');
            }
            updateSidebarToggleIcon();

            sidebarToggleBtn.addEventListener('click', () => {
                if (isTablet()) {
                    const expanded = document.body.classList.toggle('sidebar-expanded');
                    localStorage.setItem('sidebar_state', expanded ? 'expanded' : 'collapsed');
                } else {
                    const collapsed = document.body.classList.toggle('sidebar-collapsed');
                    localStorage.setItem('sidebar_state', collapsed ? 'collapsed' : 'expanded');
                }
                updateSidebarToggleIcon();
            });

            window.addEventListener('resize', () => {
                updateSidebarToggleIcon();
            });
        }

        if ('serviceWorker' in navigator) {
            if ('caches' in window) {
                caches.keys().then((keys) => {
                    keys.forEach((key) => {
                        if (key !== 'societyapp-v4') {
                            caches.delete(key);
                        }
                    });
                });
            }

            let hadController = !!navigator.serviceWorker.controller;
            let refreshing = false;
            navigator.serviceWorker.addEventListener('controllerchange', () => {
                if (hadController && !refreshing) {
                    refreshing = true;
                    window.location.reload();
                }
            });

            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then((registration) => {
                        registration.update();
                    })
                    .catch((error) => {
                        console.log('SW registration failed:', error);
                    });
            });
        }

        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
        });

        window.showInstallPrompt = function() {
            const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
            let message = 'To install SocietyApp on your device:\n\n';
            if (isMobile) {
                message += '1. Tap the share / menu button\n2. Select "Add to Home Screen"\n3. Tap "Add" to confirm';
            } else {
                message += '1. Click the install icon in the browser address bar\n2. Select "Install SocietyApp"\n3. Click "Install" to confirm';
            }
            window.appAlert(message, 'Install SocietyApp');
        };

        // Custom Modal & Dialog System (Replaces default confirm/alert)
        let globalCustomModalCallback = null;

        window.appConfirm = function(message, titleOrCallback, onConfirm) {
            let title = 'Confirmation Required';
            let cb = onConfirm;
            if (typeof titleOrCallback === 'function') {
                cb = titleOrCallback;
            } else if (typeof titleOrCallback === 'string') {
                title = titleOrCallback;
            }
            document.getElementById('globalCustomModalTitle').textContent = title;
            document.getElementById('globalCustomModalMessage').textContent = message;
            document.getElementById('globalCustomModalCancelBtn').classList.remove('hidden');
            document.getElementById('globalCustomModalConfirmBtn').textContent = 'Confirm';
            globalCustomModalCallback = cb;
            document.getElementById('globalCustomModal').classList.remove('hidden');
            if (window.lucide) { lucide.createIcons(); }
        };

        window.appAlert = function(message, title) {
            document.getElementById('globalCustomModalTitle').textContent = title || 'Notice';
            document.getElementById('globalCustomModalMessage').textContent = message;
            document.getElementById('globalCustomModalCancelBtn').classList.add('hidden');
            document.getElementById('globalCustomModalConfirmBtn').textContent = 'OK';
            globalCustomModalCallback = null;
            document.getElementById('globalCustomModal').classList.remove('hidden');
            if (window.lucide) { lucide.createIcons(); }
        };

        window.closeGlobalCustomModal = function(confirmed) {
            document.getElementById('globalCustomModal').classList.add('hidden');
            if (confirmed && typeof globalCustomModalCallback === 'function') {
                const cb = globalCustomModalCallback;
                globalCustomModalCallback = null;
                cb();
            }
        };

        window.openHelpModal = function() {
            document.getElementById('helpModal').classList.remove('hidden');
            if (window.lucide) { lucide.createIcons(); }
        };

        window.closeHelpModal = function() {
            document.getElementById('helpModal').classList.add('hidden');
        };

        // Intercept data-confirm on forms for seamless custom confirmation
        document.addEventListener('submit', function(e) {
            const form = e.target;
            const confirmMsg = form.getAttribute('data-confirm');
            if (confirmMsg && !form.dataset.confirmed) {
                e.preventDefault();
                window.appConfirm(confirmMsg, 'Confirm Action', function() {
                    form.dataset.confirmed = 'true';
                    form.submit();
                });
            }
        });
    </script>

    <!-- Global Custom Confirm/Alert Modal -->
    <div id="globalCustomModal" class="hidden fixed inset-0 z-[250] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm">
        <div class="glass-panel rounded-2xl max-w-sm w-full p-6 border border-slate-200/80 dark:border-white/10 bg-white dark:bg-surface-900 shadow-2xl text-center flex flex-col items-center">
            <div id="globalCustomModalIcon" class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center mb-3.5">
                <i data-lucide="help-circle" class="w-6 h-6"></i>
            </div>
            <h3 id="globalCustomModalTitle" class="text-base font-bold text-slate-900 dark:text-white mb-2">Confirmation Required</h3>
            <p id="globalCustomModalMessage" class="text-xs text-slate-600 dark:text-surface-200/70 leading-relaxed mb-6">Are you sure you want to proceed?</p>
            <div class="flex items-center justify-center gap-3 w-full">
                <button type="button" id="globalCustomModalCancelBtn" onclick="closeGlobalCustomModal(false)" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-white/5 text-xs font-semibold text-slate-600 dark:text-surface-200 transition-colors">Cancel</button>
                <button type="button" id="globalCustomModalConfirmBtn" onclick="closeGlobalCustomModal(true)" class="flex-1 btn-primary !px-4 !py-2.5 text-xs font-bold shadow-lg shadow-brand-500/25">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Help & Support / Contact Us Modal -->
    <div id="helpModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm overflow-y-auto">
        <div class="bg-white dark:bg-surface-900 rounded-2xl max-w-lg w-full border border-slate-200 dark:border-white/10 shadow-2xl max-h-[calc(100vh-2rem)] flex flex-col my-auto overflow-hidden">
            <div class="flex items-center justify-between p-5 border-b border-slate-200 dark:border-white/10 shrink-0">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-brand-500/15 text-brand-500 flex items-center justify-center">
                        <i data-lucide="life-buoy" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Help &amp; Support</h3>
                        <p class="text-[11px] text-slate-500 dark:text-surface-200/60">Contact platform administrator &amp; developer</p>
                    </div>
                </div>
                <button type="button" onclick="closeHelpModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:text-surface-200/50 dark:hover:text-white transition-colors">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <form action="/contact" method="POST" class="flex flex-col flex-1 min-h-0 overflow-hidden">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

                <div class="p-6 overflow-y-auto flex-1 space-y-4 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-surface-200/80 mb-1">Your Full Name <span class="text-rose-500">*</span></label>
                        <input type="text" name="name" value="{{ user.name|default('') }}" required placeholder="e.g. Rahul Sharma"
                            class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-700 dark:text-surface-200/80 mb-1">Email Address <span class="text-rose-500">*</span></label>
                            <input type="email" name="email" value="{{ user.email|default('') }}" required placeholder="e.g. rahul@example.com"
                                class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 dark:text-surface-200/80 mb-1">Mobile Number</label>
                            <input type="tel" name="phone" value="{{ user.phone|default('') }}" placeholder="e.g. 9876543210"
                                class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 font-mono">
                        </div>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-surface-200/80 mb-1">Subject / Category <span class="text-rose-500">*</span></label>
                        <select name="subject" required class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <option value="Technical Issue">Technical Issue / Bug Report</option>
                            <option value="Billing &amp; Receipts">Billing &amp; Dues / Receipts Issue</option>
                            <option value="Flat Linking Assistance">Flat Linking / Society Verification Help</option>
                            <option value="Feature Request">Feedback / Feature Request</option>
                            <option value="General Support">General Support</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-surface-200/80 mb-1">Message / Issue Details <span class="text-rose-500">*</span></label>
                        <textarea name="message" rows="3" required placeholder="Describe your issue or query in detail..."
                            class="block w-full px-3.5 py-2.5 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 resize-none"></textarea>
                    </div>

                    <!-- Direct contact alternative -->
                    <div class="p-3 rounded-xl bg-slate-100 dark:bg-white/[0.02] border border-slate-200 dark:border-white/5 flex items-center justify-between gap-3 text-[11px] text-slate-500 dark:text-surface-200/60">
                        <span>Prefer direct messaging?</span>
                        <a href="https://wa.me/919967181952?text=Hello%20SocietyApp%20Support" target="_blank" class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1">
                            <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
                            <span>WhatsApp Developer</span>
                        </a>
                    </div>
                </div>

                <div class="flex justify-end gap-2.5 p-4 border-t border-slate-200 dark:border-white/10 shrink-0 bg-slate-50 dark:bg-surface-900">
                    <button type="button" onclick="closeHelpModal()" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-white/5 text-xs font-semibold text-slate-700 dark:text-surface-200/80">Cancel</button>
                    <button type="submit" class="btn-primary !px-5 !py-2 text-xs font-semibold flex items-center gap-1.5 shadow-md shadow-brand-500/20">
                        <i data-lucide="send" class="w-3.5 h-3.5"></i>
                        <span>Send Message</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    {% block scripts %}{% endblock %}
</body>
</html>
