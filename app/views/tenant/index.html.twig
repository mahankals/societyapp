{% extends "layouts/mobile.html.twig" %}

{% block title %}Dashboard | SocietyApp{% endblock %}

{% block content %}
{% if profileComplete < 100 %}
<div class="mb-6 glass-panel rounded-2xl p-4 border border-amber-500/30 bg-amber-500/10">
    <div class="flex items-center gap-3 mb-3">
        <i data-lucide="alert-circle" class="w-5 h-5 text-amber-400"></i>
        <h3 class="text-amber-400 font-semibold">Complete Your Profile</h3>
    </div>
    <div class="w-full bg-white/10 rounded-full h-2 mb-2">
        <div class="bg-amber-500 h-2 rounded-full" style="width: {{ profileComplete }}%"></div>
    </div>
    <p class="text-sm text-surface-200/60 mb-3">{{ profileComplete }}% complete</p>
    <a href="/tenant/profile" class="text-sm text-amber-400 hover:text-amber-300 font-medium">Complete Now →</a>
</div>
{% endif %}

{% if unpaidBillsCount > 0 %}
<div class="mb-6 glass-panel rounded-2xl p-4 border border-red-500/30 bg-red-500/10">
    <div class="flex items-center justify-between">
        <div>
            <p class="text-sm text-surface-200/60">Unpaid Bills</p>
            <p class="text-2xl font-bold text-white">₹{{ unpaidBillsTotal|number_format(2) }}</p>
            <p class="text-sm text-red-400">{{ unpaidBillsCount }} pending bill{{ unpaidBillsCount > 1 ? 's' : '' }}</p>
        </div>
        <a href="/tenant/bills" class="btn-primary !py-2 !px-4">Pay Now</a>
    </div>
</div>
{% endif %}

<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <a href="/tenant/bills" class="glass-panel rounded-xl p-4 text-center">
        <p class="text-2xl font-bold text-white">{{ unpaidBillsCount }}</p>
        <p class="text-xs text-surface-200/60">Pending Bills</p>
    </a>
    <a href="/tenant/requests" class="glass-panel rounded-xl p-4 text-center">
        <p class="text-2xl font-bold text-white">{{ pendingRequestsCount }}</p>
        <p class="text-xs text-surface-200/60">Open Requests</p>
    </a>
    <a href="/tenant/notifications" class="glass-panel rounded-xl p-4 text-center">
        <p class="text-2xl font-bold text-white">{{ unreadNotifications }}</p>
        <p class="text-xs text-surface-200/60">Notifications</p>
    </a>
    <a href="/tenant/profile" class="glass-panel rounded-xl p-4 text-center">
        <p class="text-2xl font-bold text-white">{{ profileComplete }}%</p>
        <p class="text-xs text-surface-200/60">Profile</p>
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <a href="/tenant/bills" class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center">
                <i data-lucide="receipt" class="w-6 h-6 text-blue-400"></i>
            </div>
            <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Maintenance Bills</h3>
        <p class="text-sm text-surface-200/40">View and pay your monthly bills</p>
    </a>

    <a href="/tenant/documents" class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-purple-500/20 flex items-center justify-center">
                <i data-lucide="file-text" class="w-6 h-6 text-purple-400"></i>
            </div>
            <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">My Documents</h3>
        <p class="text-sm text-surface-200/40">Upload and manage documents</p>
    </a>

    <a href="/tenant/requests" class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-orange-500/20 flex items-center justify-center">
                <i data-lucide="wrench" class="w-6 h-6 text-orange-400"></i>
            </div>
            <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Service Requests</h3>
        <p class="text-sm text-surface-200/40">Submit and track requests</p>
    </a>

    <a href="/tenant/notifications" class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center relative">
                <i data-lucide="bell" class="w-6 h-6 text-green-400"></i>
                {% if unreadNotifications > 0 %}
                <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 rounded-full text-xs text-white flex items-center justify-center">{{ unreadNotifications }}</span>
                {% endif %}
            </div>
            <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Notifications</h3>
        <p class="text-sm text-surface-200/40">View society announcements</p>
    </a>

    <a href="/tenant/profile" class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/20 flex items-center justify-center">
                <i data-lucide="user" class="w-6 h-6 text-cyan-400"></i>
            </div>
            <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">My Profile</h3>
        <p class="text-sm text-surface-200/40">Update your personal info</p>
    </a>

    <div class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
        <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-pink-500/20 flex items-center justify-center">
                <i data-lucide="calendar" class="w-6 h-6 text-pink-400"></i>
            </div>
            <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Events</h3>
        <p class="text-sm text-surface-200/40">Upcoming society events</p>
    </div>
</div>

{% if recentBills or recentRequests %}
<div class="mt-8">
    <h2 class="text-xl font-bold text-white mb-4">Recent Activity</h2>
    
    {% if recentBills %}
    <div class="glass-panel rounded-2xl p-4 mb-4">
        <h3 class="font-semibold text-white mb-3 flex items-center gap-2">
            <i data-lucide="receipt" class="w-4 h-4 text-blue-400"></i>
            Recent Bills
        </h3>
        {% for bill in recentBills %}
        <div class="flex items-center justify-between py-2 border-b border-white/10 last:border-0">
            <div>
                <p class="text-white text-sm">{{ bill.description }}</p>
                <p class="text-surface-200/40 text-xs">{{ bill.created_at|date('M d, Y') }}</p>
            </div>
            <div class="text-right">
                <p class="text-white font-medium">₹{{ bill.amount|number_format(2) }}</p>
                <span class="text-xs px-2 py-0.5 rounded-full {% if bill.status == 'paid' %}bg-green-500/20 text-green-400{% else %}bg-red-500/20 text-red-400{% endif %}">
                    {{ bill.status }}
                </span>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
    
    {% if recentRequests %}
    <div class="glass-panel rounded-2xl p-4">
        <h3 class="font-semibold text-white mb-3 flex items-center gap-2">
            <i data-lucide="wrench" class="w-4 h-4 text-orange-400"></i>
            Recent Requests
        </h3>
        {% for request in recentRequests %}
        <div class="flex items-center justify-between py-2 border-b border-white/10 last:border-0">
            <div>
                <p class="text-white text-sm">{{ request.category }}</p>
                <p class="text-surface-200/40 text-xs">{{ request.created_at|date('M d, Y') }}</p>
            </div>
            <span class="text-xs px-2 py-0.5 rounded-full 
                {% if request.status == 'completed' %}bg-green-500/20 text-green-400
                {% elseif request.status == 'in_progress' %}bg-blue-500/20 text-blue-400
                {% elseif request.status == 'pending' %}bg-yellow-500/20 text-yellow-400
                {% else %}bg-red-500/20 text-red-400{% endif %}">
                {{ request.status|replace({'_': ' '}) }}
            </span>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
