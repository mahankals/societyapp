{% extends "layouts/app.html.twig" %}

{% block title %}My Profile | SocietyApp{% endblock %}

{% block content %}
<div class="px-4 py-4">
    <div class="flex items-center gap-4 mb-4">
        <a href="/tenant" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
        </a>
        <div>
            <h1 class="text-lg font-bold text-white">My Profile</h1>
            <p class="text-sm text-surface-200/40">Manage your personal information</p>
        </div>
    </div>

    {% if flash %}
    <div class="mb-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <form method="POST" action="/tenant/profile" class="space-y-4 max-w-2xl">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        
        <div class="glass-panel rounded-2xl p-6">
            <h2 class="text-lg font-semibold text-white mb-4">Personal Information</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-white/80 mb-2">Full Name</label>
                    <input type="text" id="name" name="name" value="{{ user.name }}" required
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all">
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium text-white/80 mb-2">Email</label>
                    <input type="email" value="{{ user.email }}" disabled
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white/50 placeholder-white/30 cursor-not-allowed">
                </div>
                <div>
                    <label for="phone" class="block text-sm font-medium text-white/80 mb-2">Phone Number</label>
                    <input type="tel" id="phone" name="phone" value="{{ profile.phone|default('') }}"
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                        placeholder="+91 9876543210">
                </div>
                <div>
                    <label for="apartment" class="block text-sm font-medium text-white/80 mb-2">Apartment/Unit</label>
                    <input type="text" id="apartment" name="apartment" value="{{ profile.apartment|default('') }}"
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                        placeholder="A-101, Block A">
                </div>
            </div>
            
            <div class="mt-4">
                <label for="address" class="block text-sm font-medium text-white/80 mb-2">Address</label>
                <textarea id="address" name="address" rows="2"
                    class="w-full bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 py-3 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                    placeholder="Enter your address">{{ profile.address|default('') }}</textarea>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6">
            <h2 class="text-lg font-semibold text-white mb-4">Emergency Contact</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="emergency_contact_name" class="block text-sm font-medium text-white/80 mb-2">Contact Name</label>
                    <input type="text" id="emergency_contact_name" name="emergency_contact_name" value="{{ profile.emergency_contact_name|default('') }}"
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                        placeholder="Emergency contact name">
                </div>
                <div>
                    <label for="emergency_contact_phone" class="block text-sm font-medium text-white/80 mb-2">Contact Phone</label>
                    <input type="tel" id="emergency_contact_phone" name="emergency_contact_phone" value="{{ profile.emergency_contact_phone|default('') }}"
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                        placeholder="+91 9876543210">
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary w-full !h-14 !text-base !rounded-xl">
            <i data-lucide="save" class="w-5 h-5"></i>
            Save Changes
        </button>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
