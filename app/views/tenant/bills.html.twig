{% extends "layouts/mobile.html.twig" %}

{% block title %}Maintenance Bills | SocietyApp{% endblock %}

{% block content %}
<div class="px-4 py-4">
    <div class="flex items-center gap-4 mb-4">
        <a href="/tenant" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
        </a>
        <div>
            <h1 class="text-lg font-bold text-white">Maintenance Bills</h1>
            <p class="text-sm text-surface-200/40">View and pay your bills</p>
        </div>
    </div>

    {% if flash %}
    <div class="mb-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="space-y-3">
        {% for bill in bills %}
        <div class="glass-panel rounded-2xl p-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-white font-medium">{{ bill.month }}</h3>
                    <p class="text-sm text-surface-200/50">Bill #{{ bill.bill_number }}</p>
                </div>
                <div class="text-right">
                    <p class="text-xl font-bold text-white">₹{{ bill.amount }}</p>
                    <span class="px-2 py-1 rounded-lg text-xs font-medium 
                        {% if bill.status == 'paid' %}bg-green-500/20 text-green-400
                        {% elseif bill.status == 'overdue' %}bg-red-500/20 text-red-400
                        {% else %}bg-yellow-500/20 text-yellow-400{% endif %}">
                        {{ bill.status|title }}
                    </span>
                </div>
            </div>
            <div class="flex items-center justify-between mt-4 pt-4 border-t border-white/5">
                <span class="text-sm text-surface-200/40">Due: {{ bill.due_date|date('M d, Y') }}</span>
                {% if bill.status == 'pending' or bill.status == 'overdue' %}
                <button class="btn-primary !py-2 !px-4 !text-sm !rounded-lg">
                    Pay Now
                </button>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="glass-panel rounded-2xl p-8 text-center">
            <div class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="receipt" class="w-8 h-8 text-surface-200/30"></i>
            </div>
            <h3 class="text-white font-medium mb-2">No bills</h3>
            <p class="text-sm text-surface-200/50">You have no pending bills</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
