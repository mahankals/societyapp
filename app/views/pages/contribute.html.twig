{% extends "layouts/mobile.html.twig" %}

{% block title %}Add New Society | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto px-4 sm:px-6">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-white tracking-tight">Add Your Society</h1>
        <p class="text-xs text-surface-200/60">Propose a new housing society to be onboarded onto the SocietyApp platform with founding committee members.</p>
    </div>

    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <form action="/society/contribute" method="POST" class="glass-panel rounded-2xl p-6 sm:p-8 border border-white/10 space-y-6">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">

        <!-- Society Info -->
        <div>
            <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                <i data-lucide="building" class="w-4 h-4 text-brand-400"></i>
                <span>Society Details</span>
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2">
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Society Name <span class="text-brand-400">*</span></label>
                    <input type="text" name="society_name" placeholder="e.g. Sea View Cooperative Housing Society" required class="input-glass w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">City <span class="text-brand-400">*</span></label>
                    <input type="text" name="city" placeholder="e.g. Mumbai, Pune, Thane" required class="input-glass w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-surface-200/70 mb-1">Locality / Address</label>
                    <input type="text" name="address" placeholder="e.g. Sector 19, Palm Beach Rd" class="input-glass w-full text-sm">
                </div>
            </div>
        </div>

        <!-- 4 Committee Persons (Society Mitra Parity) -->
        <div class="pt-4 border-t border-white/5">
            <h3 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                <i data-lucide="users" class="w-4 h-4 text-emerald-400"></i>
                <span>Founding Committee Members</span>
            </h3>
            <p class="text-xs text-surface-200/50 mb-4">Provide at least one primary committee representative to verify onboarding.</p>

            <div class="space-y-3">
                <!-- Person 1 (Primary - prefilled) -->
                <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/5 grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Person 1 (Primary)</label>
                        <input type="text" name="c1_name" value="{{ user.name }}" required class="input-glass w-full text-xs">
                    </div>
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Mobile Number</label>
                        <input type="text" name="c1_phone" value="{{ user.phone }}" required class="input-glass w-full text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Flat No.</label>
                        <input type="text" name="c1_flat" placeholder="A-101" class="input-glass w-full text-xs font-mono">
                    </div>
                </div>

                <!-- Person 2 -->
                <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/5 grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Person 2 (Optional)</label>
                        <input type="text" name="c2_name" placeholder="Member Name" class="input-glass w-full text-xs">
                    </div>
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Mobile Number</label>
                        <input type="text" name="c2_phone" placeholder="+91..." class="input-glass w-full text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Flat No.</label>
                        <input type="text" name="c2_flat" placeholder="A-102" class="input-glass w-full text-xs font-mono">
                    </div>
                </div>

                <!-- Person 3 -->
                <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/5 grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Person 3 (Optional)</label>
                        <input type="text" name="c3_name" placeholder="Member Name" class="input-glass w-full text-xs">
                    </div>
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Mobile Number</label>
                        <input type="text" name="c3_phone" placeholder="+91..." class="input-glass w-full text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Flat No.</label>
                        <input type="text" name="c3_flat" placeholder="B-201" class="input-glass w-full text-xs font-mono">
                    </div>
                </div>

                <!-- Person 4 -->
                <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/5 grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Person 4 (Optional)</label>
                        <input type="text" name="c4_name" placeholder="Member Name" class="input-glass w-full text-xs">
                    </div>
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Mobile Number</label>
                        <input type="text" name="c4_phone" placeholder="+91..." class="input-glass w-full text-xs font-mono">
                    </div>
                    <div>
                        <label class="block text-[11px] text-surface-200/60 mb-1">Flat No.</label>
                        <input type="text" name="c4_flat" placeholder="B-202" class="input-glass w-full text-xs font-mono">
                    </div>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-white/5">
            <a href="/tenant" class="px-5 py-2.5 rounded-xl border border-white/10 hover:bg-white/5 text-xs text-surface-200/70">Cancel</a>
            <button type="submit" class="btn-primary !px-6 !py-2.5 text-xs font-semibold flex items-center gap-2">
                <i data-lucide="check" class="w-4 h-4"></i>
                <span>Submit Society Proposal</span>
            </button>
        </div>
    </form>

</div>
{% endblock %}
