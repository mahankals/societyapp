{% extends "layouts/mobile.html.twig" %}

{% block title %}Add New Society | SocietyApp{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 space-y-8">

    <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Add Your Society</h1>
        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-1">Propose a new housing society to be onboarded onto SocietyApp with founding committee members.</p>
    </div>

    {% if flash.error %}
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    {% if flash.success %}
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-sm flex items-center gap-2">
        <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}

    <!-- Main Proposal Form -->
    <form id="contributeSocietyForm" action="/society/contribute" method="POST" class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm space-y-8">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <input type="hidden" name="members_data_json" id="membersDataJson" value="">

        <!-- 1. Society Details -->
        <div class="space-y-4">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="building" class="w-4 h-4 text-brand-500"></i>
                <span>Society Details</span>
            </h3>

            <!-- Society Name -->
            <div class="relative">
                <input type="text" id="society_name" name="society_name" placeholder=" " required
                    class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                <label for="society_name" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                    Society Name <span class="text-rose-500">*</span>
                </label>
            </div>

            <!-- Full-width Locality / Complete Address -->
            <div class="relative">
                <textarea id="address" name="address" rows="3" placeholder=" " required
                    class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 resize-none transition-all"></textarea>
                <label for="address" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                    Locality / Complete Address <span class="text-rose-500">*</span>
                </label>
            </div>

            <!-- City, State, PIN Code inline -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="relative">
                    <input type="text" id="city" name="city" placeholder=" " required
                        class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                    <label for="city" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                        City <span class="text-rose-500">*</span>
                    </label>
                </div>

                <div class="relative">
                    <input type="text" id="state" name="state" value="Maharashtra" placeholder=" " required
                        class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 transition-all">
                    <label for="state" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                        State <span class="text-rose-500">*</span>
                    </label>
                </div>

                <div class="relative">
                    <input type="text" id="pincode" name="pincode" pattern="[0-9]{6}" maxlength="6" placeholder=" " required
                        class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-slate-800/50 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500 font-mono transition-all">
                    <label for="pincode" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                        PIN Code <span class="text-rose-500">*</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- 2. Founding Committee Members Section -->
        <div class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-4">
            <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="users" class="w-4 h-4 text-emerald-500"></i>
                    <span>Founding Committee Members</span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-surface-200/50 mt-1">You are prefilled as Person 1 (Primary contact) and will be assigned committee access upon approval.</p>
            </div>

            <!-- Search Bar to search users -->
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 space-y-3">
                <div class="flex flex-col sm:flex-row gap-2">
                    <div class="relative flex-1">
                        <input type="text" id="memberSearchQuery" placeholder=" "
                            class="peer block w-full px-4 pt-5 pb-2 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                        <label for="memberSearchQuery" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                            Enter email or mobile number to search
                        </label>
                    </div>
                    <button type="button" onclick="searchPlatformUser()" id="searchUserBtn" class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold text-slate-800 dark:text-white flex items-center justify-center gap-1.5 shrink-0 transition-colors">
                        <i data-lucide="search" class="w-3.5 h-3.5"></i>
                        <span>Search</span>
                    </button>
                </div>

                <div id="searchFeedback" class="hidden text-xs"></div>

                <!-- Add Unit Details Card for Found User / Member -->
                <div id="addMemberUnitCard" class="hidden pt-3 border-t border-slate-200 dark:border-slate-700/60 space-y-3 animate-fade-in">
                    <!-- Row 1: Person Name, Mobile, Add Button -->
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-center">
                        <div class="sm:col-span-5 relative">
                            <input type="text" id="targetMemberName" readonly placeholder=" "
                                class="peer block w-full px-3 pt-4 pb-1.5 text-xs font-semibold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg cursor-not-allowed">
                            <label class="absolute text-[10px] text-slate-500 dark:text-slate-400 top-1 start-3">Person</label>
                        </div>
                        <div class="sm:col-span-5 relative">
                            <input type="text" id="targetMemberPhone" readonly placeholder=" "
                                class="peer block w-full px-3 pt-4 pb-1.5 text-xs font-mono text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg cursor-not-allowed">
                            <label class="absolute text-[10px] text-slate-500 dark:text-slate-400 top-1 start-3">Mobile Number</label>
                        </div>
                        <div class="sm:col-span-2">
                            <button type="button" onclick="confirmAddMember()" class="w-full h-10 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold flex items-center justify-center gap-1 shadow-sm transition">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                <span>Add</span>
                            </button>
                        </div>
                    </div>

                    <!-- Row 2: Wing, Floor, Flat Number, Area (sq. ft.), Flat Type -->
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                        <div class="relative">
                            <input type="text" id="targetMemberWing" value="A" placeholder=" "
                                class="peer block w-full px-3 pt-4 pb-1.5 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                            <label class="absolute text-[10px] text-slate-500 dark:text-slate-400 top-1 start-3">Wing</label>
                        </div>
                        <div class="relative">
                            <input type="text" id="targetMemberFloor" value="1" placeholder=" "
                                class="peer block w-full px-3 pt-4 pb-1.5 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                            <label class="absolute text-[10px] text-slate-500 dark:text-slate-400 top-1 start-3">Floor</label>
                        </div>
                        <div class="relative">
                            <input type="text" id="targetMemberFlat" value="101" placeholder=" "
                                class="peer block w-full px-3 pt-4 pb-1.5 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                            <label class="absolute text-[10px] text-slate-500 dark:text-slate-400 top-1 start-3">Flat Number</label>
                        </div>
                        <div class="relative">
                            <input type="number" step="0.01" id="targetMemberArea" value="850.00" placeholder=" "
                                class="peer block w-full px-3 pt-4 pb-1.5 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                            <label class="absolute text-[10px] text-slate-500 dark:text-slate-400 top-1 start-3">Area (sq. ft.)</label>
                        </div>
                        <div class="relative col-span-2 sm:col-span-1">
                            <select id="targetMemberType" class="block w-full px-3 pt-4 pb-1.5 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                                <option value="1 RK">1 RK</option>
                                <option value="1 BHK">1 BHK</option>
                                <option value="2 BHK" selected>2 BHK</option>
                                <option value="3 BHK">3 BHK</option>
                                <option value="4+ BHK">4+ BHK</option>
                                <option value="Shop/Commercial">Shop/Commercial</option>
                            </select>
                            <label class="absolute text-[10px] text-slate-500 dark:text-slate-400 top-1 start-3">Flat Type</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Committee Members List Table -->
            <div class="border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-200 dark:border-slate-800">
                        <tr>
                            <th class="py-3 px-4">Member</th>
                            <th class="py-3 px-4">Contact</th>
                            <th class="py-3 px-4">Flat Location</th>
                            <th class="py-3 px-4">Specification</th>
                            <th class="py-3 px-4 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody id="membersTableBody" class="divide-y divide-slate-100 dark:divide-slate-800">
                        <!-- Populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Submit & Actions -->
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
            <a href="/resident" class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors">Cancel</a>
            <button type="submit" id="submitSocietyProposalBtn" class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold shadow-md shadow-brand-500/20 transition-all flex items-center gap-2">
                <i data-lucide="check" class="w-4 h-4"></i>
                <span>Submit Society Proposal</span>
            </button>
        </div>
    </form>

    <!-- My Society Proposals Section -->
    {% if myProposals|length > 0 %}
    <div class="space-y-4 pt-4">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <i data-lucide="history" class="w-4 h-4 text-brand-500"></i>
            <span>My Submitted Society Proposals</span>
        </h2>

        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-200 dark:border-slate-800">
                    <tr>
                        <th class="py-3 px-4">Society Name</th>
                        <th class="py-3 px-4">Location</th>
                        <th class="py-3 px-4">Date</th>
                        <th class="py-3 px-4 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    {% for p in myProposals %}
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30">
                        <td class="py-3.5 px-4 font-semibold text-slate-900 dark:text-white">
                            {{ p.society_name }}
                        </td>
                        <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400">
                            {{ p.city }}{% if p.state %}, {{ p.state }}{% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400 font-mono text-[11px]">
                            {{ p.created_at|date('d M Y, h:i A') }}
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            {% if p.status == 'approved' %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                                <i data-lucide="check-circle-2" class="w-3 h-3"></i>
                                Approved
                            </span>
                            {% elseif p.status == 'rejected' %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                                <i data-lucide="x-circle" class="w-3 h-3"></i>
                                Rejected
                            </span>
                            {% else %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                                <i data-lucide="clock" class="w-3 h-3"></i>
                                Pending Review
                            </span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

</div>

<!-- Edit Member Modal -->
<div id="editMemberModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl max-w-md w-full border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col max-h-[calc(100vh-2rem)]">
        <div class="flex items-center justify-between p-4 border-b border-slate-200 dark:border-slate-800 shrink-0">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-500 flex items-center justify-center">
                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">Edit Member Allocation</h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Update flat location and specifications</p>
                </div>
            </div>
            <button type="button" onclick="closeEditMemberModal()" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-white">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <form id="editMemberForm" onsubmit="saveEditedMember(event)" class="p-4 space-y-3 overflow-y-auto flex-1">
            <input type="hidden" id="editMemberIndex" value="">
            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Member</label>
                <input type="text" id="editMemberName" readonly class="block w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg">
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Wing</label>
                    <input type="text" id="editMemberWing" required class="block w-full px-3 py-2 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Floor</label>
                    <input type="text" id="editMemberFloor" required class="block w-full px-3 py-2 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Flat Number</label>
                    <input type="text" id="editMemberFlat" required class="block w-full px-3 py-2 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Area (sq. ft.)</label>
                    <input type="number" step="0.01" id="editMemberArea" required class="block w-full px-3 py-2 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Flat Type</label>
                <select id="editMemberType" class="block w-full px-3 py-2 text-xs text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg focus:outline-none focus:ring-1 focus:ring-brand-500">
                    <option value="1 RK">1 RK</option>
                    <option value="1 BHK">1 BHK</option>
                    <option value="2 BHK">2 BHK</option>
                    <option value="3 BHK">3 BHK</option>
                    <option value="4+ BHK">4+ BHK</option>
                    <option value="Shop/Commercial">Shop/Commercial</option>
                </select>
            </div>
            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200 dark:border-slate-800">
                <button type="button" onclick="closeEditMemberModal()" class="px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg">Cancel</button>
                <button type="submit" class="px-4 py-2 text-xs font-semibold bg-brand-600 hover:bg-brand-500 text-white rounded-lg shadow-sm">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
let committeeMembers = [];
let pendingFoundUser = null;

function renderMembersTable() {
    const tbody = document.getElementById('membersTableBody');
    if (!tbody) return;
    tbody.innerHTML = '';

    if (committeeMembers.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="5" class="py-8 text-center text-slate-400 dark:text-slate-500 text-xs">
                    <i data-lucide="users" class="w-6 h-6 mx-auto mb-2 text-slate-300 dark:text-slate-600"></i>
                    No committee members added yet. Search a registered user above to add them to this proposal.
                </td>
            </tr>
        `;
        document.getElementById('membersDataJson').value = JSON.stringify(committeeMembers);
        if (window.lucide) { lucide.createIcons(); }
        return;
    }

    committeeMembers.forEach((m, idx) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors';

        const phoneDisplay = m.phone ? (m.phone.startsWith('+91') ? m.phone : '+91 ' + m.phone) : '—';
        const flatLoc = (m.wing ? (m.wing + ' wing - ') : '') + 'Floor ' + (m.floor || '1') + '<br><span class="font-semibold text-slate-900 dark:text-white">Flat ' + (m.flat_no || '101') + '</span>';
        const spec = (m.flat_type || '2 BHK') + '<br><span class="text-slate-400 text-[11px] font-mono">' + (m.area_sqft || '850.00') + ' sq. ft</span>';

        const actionHtml = `
            <div class="flex items-center justify-end gap-1.5">
                <button type="button" onclick="editMember(${idx})" class="p-1.5 rounded-lg text-slate-400 hover:text-brand-500 hover:bg-brand-50 dark:hover:bg-brand-950/40 transition-colors" title="Edit Member Allocation">
                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                </button>
                <button type="button" onclick="removeMember(${idx})" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Remove Member">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
            </div>
        `;

        tr.innerHTML = `
            <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">${m.name}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">
                <div>${m.email}</div>
                <div class="text-[11px] font-mono text-slate-400">${phoneDisplay}</div>
            </td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">${flatLoc}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">${spec}</td>
            <td class="py-3 px-4 text-right">${actionHtml}</td>
        `;
        tbody.appendChild(tr);
    });

    document.getElementById('membersDataJson').value = JSON.stringify(committeeMembers);
    if (window.lucide) { lucide.createIcons(); }
}

function editMember(idx) {
    const m = committeeMembers[idx];
    if (!m) return;
    document.getElementById('editMemberIndex').value = idx;
    document.getElementById('editMemberName').value = m.name + (m.email ? ' (' + m.email + ')' : '');
    document.getElementById('editMemberWing').value = m.wing || '';
    document.getElementById('editMemberFloor').value = m.floor || '';
    document.getElementById('editMemberFlat').value = m.flat_no || '';
    document.getElementById('editMemberArea').value = m.area_sqft || '';
    document.getElementById('editMemberType').value = m.flat_type || '2 BHK';
    document.getElementById('editMemberModal').classList.remove('hidden');
    if (window.lucide) { lucide.createIcons(); }
}

function closeEditMemberModal() {
    document.getElementById('editMemberModal').classList.add('hidden');
}

function saveEditedMember(e) {
    e.preventDefault();
    const idx = parseInt(document.getElementById('editMemberIndex').value, 10);
    if (isNaN(idx) || !committeeMembers[idx]) return;

    committeeMembers[idx].wing = (document.getElementById('editMemberWing').value || '').trim();
    committeeMembers[idx].floor = (document.getElementById('editMemberFloor').value || '').trim();
    committeeMembers[idx].flat_no = (document.getElementById('editMemberFlat').value || '').trim();
    committeeMembers[idx].area_sqft = (document.getElementById('editMemberArea').value || '').trim();
    committeeMembers[idx].flat_type = document.getElementById('editMemberType').value;

    closeEditMemberModal();
    renderMembersTable();
}

function removeMember(idx) {
    if (window.appConfirm) {
        window.appConfirm('Are you sure you want to remove this member from the committee proposal?', 'Remove Member', function() {
            committeeMembers.splice(idx, 1);
            renderMembersTable();
        });
    } else {
        committeeMembers.splice(idx, 1);
        renderMembersTable();
    }
}

async function searchPlatformUser() {
    const qInput = document.getElementById('memberSearchQuery');
    const feedback = document.getElementById('searchFeedback');
    const unitCard = document.getElementById('addMemberUnitCard');
    const q = (qInput.value || '').trim();

    feedback.className = 'hidden';
    unitCard.classList.add('hidden');
    pendingFoundUser = null;

    if (!q || q.length < 3) {
        feedback.className = 'text-xs text-rose-500 font-medium';
        feedback.textContent = 'Please enter at least 3 characters to search.';
        return;
    }

    const btn = document.getElementById('searchUserBtn');
    btn.disabled = true;
    btn.innerHTML = '<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i><span>Searching…</span>';
    if (window.lucide) { lucide.createIcons(); }

    try {
        const res = await fetch('/society/contribute/search-user?q=' + encodeURIComponent(q));
        const data = await res.json();

        if (data.success && data.user) {
            // Check if already in list
            const exists = committeeMembers.some(m => m.user_id === data.user.id);
            if (exists) {
                feedback.className = 'text-xs text-amber-500 font-medium';
                feedback.textContent = 'This member has already been added to the committee list.';
                return;
            }

            pendingFoundUser = data.user;
            document.getElementById('targetMemberName').value = data.user.name;
            document.getElementById('targetMemberPhone').value = data.user.phone || 'No Phone';

            // Auto-increment suggested flat
            const lastMember = committeeMembers[committeeMembers.length - 1];
            if (lastMember) {
                document.getElementById('targetMemberWing').value = lastMember.wing || 'A';
                document.getElementById('targetMemberFloor').value = lastMember.floor || '1';
                const nextFlat = (parseInt(lastMember.flat_no, 10) || 100) + 1;
                document.getElementById('targetMemberFlat').value = nextFlat;
            } else {
                document.getElementById('targetMemberWing').value = 'A';
                document.getElementById('targetMemberFloor').value = '1';
                document.getElementById('targetMemberFlat').value = '101';
            }

            feedback.className = 'text-xs text-emerald-500 font-medium';
            feedback.textContent = 'User found! Please review flat allocation and click Add.';
            unitCard.classList.remove('hidden');
        } else {
            feedback.className = 'text-xs text-rose-500 font-medium';
            feedback.textContent = data.error || 'No registered user found.';
        }
    } catch (e) {
        feedback.className = 'text-xs text-rose-500 font-medium';
        feedback.textContent = 'Search failed: ' + e.message;
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="search" class="w-3.5 h-3.5"></i><span>Search</span>';
        if (window.lucide) { lucide.createIcons(); }
    }
}

function confirmAddMember() {
    if (!pendingFoundUser) return;

    const wing = (document.getElementById('targetMemberWing').value || 'A').trim();
    const floor = (document.getElementById('targetMemberFloor').value || '1').trim();
    const flatNo = (document.getElementById('targetMemberFlat').value || '101').trim();
    const area = (document.getElementById('targetMemberArea').value || '850.00').trim();
    const type = document.getElementById('targetMemberType').value || '2 BHK';

    committeeMembers.push({
        user_id: pendingFoundUser.id,
        name: pendingFoundUser.name,
        email: pendingFoundUser.email,
        phone: pendingFoundUser.phone || '',
        wing: wing,
        floor: floor,
        flat_no: flatNo,
        area_sqft: area,
        flat_type: type,
        is_primary: committeeMembers.length === 0
    });

    // Reset search state
    document.getElementById('memberSearchQuery').value = '';
    document.getElementById('searchFeedback').className = 'hidden';
    document.getElementById('addMemberUnitCard').classList.add('hidden');
    pendingFoundUser = null;

    renderMembersTable();
}

document.addEventListener('DOMContentLoaded', function() {
    renderMembersTable();
    if (window.lucide) { lucide.createIcons(); }
});
</script>
{% endblock %}
