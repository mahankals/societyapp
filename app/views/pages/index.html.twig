{% extends "layouts/base.html.twig" %}

{% block title %}SocietyApp — The Modern Resident Portal{% endblock %}

{% block content %}
    <!-- ========== HERO SECTION ========== -->
    <section class="relative min-h-screen flex items-center overflow-hidden pt-28 pb-20">
        <!-- Background Effects -->
        <div class="absolute inset-0 grid-bg"></div>
        <div class="glow-orb w-[600px] h-[600px] bg-brand-600/15 top-[-10%] left-[10%] animate-pulse-slow"></div>
        <div class="glow-orb w-[500px] h-[500px] bg-brand-500/10 bottom-[-15%] right-[5%] animate-pulse-slow" style="animation-delay: 2s;"></div>
        <div class="glow-orb w-[300px] h-[300px] bg-purple-600/10 top-[20%] right-[20%] animate-float"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
            <div class="grid lg:grid-cols-2 gap-16 items-center relative">
                <!-- Left Column: Content -->
                <div class="text-center lg:text-left relative z-20">
                    <!-- Badge -->
                    <div class="inline-flex items-center gap-2.5 section-badge mb-8 animate-fade-in">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
                        </span>
                        <span>Live</span>
                    </div>
                    
                    <!-- Heading -->
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight leading-[1.08] mb-6 animate-fade-up">
                        <span class="text-white">Your Society,</span><br>
                        <span class="gradient-text">Completely Digital.</span>
                    </h1>
                    
                    <!-- Subheading -->
                    <p class="text-lg lg:text-xl text-white/50 leading-relaxed max-w-xl mx-auto lg:mx-0 mb-10 animate-fade-up animate-delay-100">
                        The premium management platform for modern residential communities. Seamless operations, role-based security, always accessible.
                    </p>
                    
                    <!-- CTA Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-fade-up animate-delay-200">
                        {% if user %}
                        <a href="{{ user.role == 'admin' ? '/admin' : '/tenant' }}" class="btn-primary text-lg" id="hero-cta-primary">
                            Go to Dashboard
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </a>
                        {% else %}
                        <a href="/auth/login" class="btn-primary text-lg" id="hero-cta-primary">
                            Get Started
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </a>
                        {% endif %}
                        <a href="#features" class="btn-secondary text-lg" id="hero-cta-secondary">
                            <i data-lucide="play-circle" class="w-5 h-5"></i>
                            View Features
                        </a>
                    </div>

                    <!-- Trust Indicators -->
                    <div class="mt-12 flex flex-col sm:flex-row items-center gap-6 justify-center lg:justify-start animate-fade-up animate-delay-300">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 border-2 border-surface-950 flex items-center justify-center text-xs font-bold text-white">A</div>
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-pink-400 to-pink-600 border-2 border-surface-950 flex items-center justify-center text-xs font-bold text-white">R</div>
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 border-2 border-surface-950 flex items-center justify-center text-xs font-bold text-white">K</div>
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 border-2 border-surface-950 flex items-center justify-center text-xs font-bold text-white">S</div>
                            <div class="w-8 h-8 rounded-full bg-white/10 border-2 border-surface-950 flex items-center justify-center text-xs font-medium text-white/60">+</div>
                        </div>
                        <div class="text-sm text-white/40">
                            <span class="text-white font-semibold">500+</span> societies already onboarded
                        </div>
                    </div>
                </div>

                <!-- Right Column: Dual Device Mockup (Browser + Mobile) -->
                <!-- Sent backward with light fade overlapping current content on mobile/tablet via hero-mockup-wrapper -->
                <div class="hero-mockup-wrapper animate-fade-up animate-delay-300 max-lg:blur-[10px] max-lg:opacity-15 max-lg:pointer-events-none lg:blur-none lg:opacity-100">
                    <!-- Glow behind card -->
                    <div class="absolute -inset-4 bg-gradient-to-r from-brand-500/20 via-purple-500/10 to-brand-600/20 rounded-[2.5rem] blur-2xl"></div>
                    
                    <!-- Dashboard Browser Mockup -->
                    <div class="relative glass-panel rounded-[2rem] p-1.5 shadow-2xl shadow-black/30 w-full max-w-[640px] xl:max-w-[680px]">
                        <div class="bg-surface-900/80 rounded-[1.7rem] overflow-hidden">
                            <!-- Title bar -->
                            <div class="flex items-center gap-2 px-5 py-3.5 border-b border-white/5">
                                <div class="flex gap-1.5">
                                    <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
                                    <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
                                    <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
                                </div>
                                <div class="flex-1 flex justify-center">
                                    <div class="px-4 py-1 bg-white/5 rounded-lg text-xs text-white/30 font-medium">societyapp.ddev.site/dashboard</div>
                                </div>
                            </div>
                            
                            <!-- Dashboard Content -->
                            <div class="p-5 grid grid-cols-12 gap-3" style="aspect-ratio: 4/3;">
                                <!-- Sidebar -->
                                <div class="col-span-3 space-y-3">
                                    <div class="h-7 bg-white/5 rounded-lg w-4/5"></div>
                                    <div class="space-y-1.5 mt-4">
                                        <div class="h-8 bg-brand-500/15 border border-brand-500/20 rounded-lg flex items-center px-3">
                                            <div class="w-3 h-3 rounded bg-brand-500/40 mr-2"></div>
                                            <div class="h-2.5 bg-brand-400/30 rounded w-16"></div>
                                        </div>
                                        <div class="h-8 bg-white/3 rounded-lg"></div>
                                        <div class="h-8 bg-white/3 rounded-lg"></div>
                                        <div class="h-8 bg-white/3 rounded-lg"></div>
                                        <div class="h-8 bg-white/3 rounded-lg"></div>
                                    </div>
                                </div>
                                
                                <!-- Main -->
                                <div class="col-span-9 space-y-3">
                                    <!-- Stats Row -->
                                    <div class="grid grid-cols-3 gap-3">
                                        <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                                            <div class="h-2 bg-white/10 rounded w-12 mb-2"></div>
                                            <div class="h-5 bg-gradient-to-r from-brand-500/30 to-brand-400/20 rounded w-16"></div>
                                        </div>
                                        <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                                            <div class="h-2 bg-white/10 rounded w-12 mb-2"></div>
                                            <div class="h-5 bg-gradient-to-r from-emerald-500/30 to-emerald-400/20 rounded w-14"></div>
                                        </div>
                                        <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                                            <div class="h-2 bg-white/10 rounded w-12 mb-2"></div>
                                            <div class="h-5 bg-gradient-to-r from-amber-500/30 to-amber-400/20 rounded w-10"></div>
                                        </div>
                                    </div>
                                    
                                    <!-- Chart Area -->
                                    <div class="bg-white/5 rounded-xl p-4 border border-white/5 flex-1" style="min-height: 120px;">
                                        <div class="h-2.5 bg-white/10 rounded w-24 mb-4"></div>
                                        <div class="flex items-end gap-2 h-16">
                                            <div class="flex-1 bg-brand-500/20 rounded-t-md" style="height: 40%;"></div>
                                            <div class="flex-1 bg-brand-500/25 rounded-t-md" style="height: 60%;"></div>
                                            <div class="flex-1 bg-brand-500/30 rounded-t-md" style="height: 45%;"></div>
                                            <div class="flex-1 bg-brand-500/35 rounded-t-md" style="height: 80%;"></div>
                                            <div class="flex-1 bg-brand-500/40 rounded-t-md" style="height: 55%;"></div>
                                            <div class="flex-1 bg-brand-500/45 rounded-t-md" style="height: 90%;"></div>
                                            <div class="flex-1 bg-brand-500/50 rounded-t-md" style="height: 70%;"></div>
                                            <div class="flex-1 bg-brand-500/40 rounded-t-md" style="height: 65%;"></div>
                                        </div>
                                    </div>

                                    <!-- Bottom Cards -->
                                    <div class="grid grid-cols-2 gap-3">
                                        <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                                            <div class="h-2 bg-white/10 rounded w-16 mb-2"></div>
                                            <div class="space-y-1.5">
                                                <div class="h-2 bg-white/5 rounded w-full"></div>
                                                <div class="h-2 bg-white/5 rounded w-4/5"></div>
                                                <div class="h-2 bg-white/5 rounded w-3/5"></div>
                                            </div>
                                        </div>
                                        <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                                            <div class="h-2 bg-white/10 rounded w-16 mb-2"></div>
                                            <div class="flex gap-2 mt-1">
                                                <div class="w-8 h-8 rounded-full bg-brand-500/15 border border-brand-500/20"></div>
                                                <div class="w-8 h-8 rounded-full bg-emerald-500/15 border border-emerald-500/20"></div>
                                                <div class="w-8 h-8 rounded-full bg-amber-500/15 border border-amber-500/20"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Smartphone Mockup (Overlapping Front Right, Heightened & Proportional) -->
                    <div class="absolute -bottom-8 -right-3 sm:-right-6 w-[215px] sm:w-[235px] rounded-[2.4rem] bg-surface-950 p-2 border-4 border-surface-700/60 shadow-2xl shadow-black/80 z-20 transition-transform duration-300 hover:scale-105">
                        <div class="rounded-[1.9rem] bg-surface-900 border border-white/10 overflow-hidden flex flex-col text-left">
                            <!-- Dynamic Island / Speaker -->
                            <div class="pt-2 pb-1.5 flex justify-center bg-surface-950/80 border-b border-white/5">
                                <div class="w-16 h-2.5 bg-surface-800 rounded-full flex items-center justify-center gap-1">
                                    <div class="w-1 h-1 rounded-full bg-surface-600"></div>
                                </div>
                            </div>

                            <!-- Mobile Top Bar -->
                            <div class="px-3 py-1.5 flex items-center justify-between border-b border-white/5 bg-surface-900/90">
                                <div class="flex items-center gap-1">
                                    <div class="w-4 h-4 rounded-md bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center">
                                        <i data-lucide="building-2" class="w-2.5 h-2.5 text-white"></i>
                                    </div>
                                    <span class="text-[10px] font-bold text-white">SocietyApp</span>
                                </div>
                                <span class="text-[8px] px-1.5 py-0.5 rounded-full bg-white/10 text-white/70 font-semibold border border-white/10">Flat 402</span>
                            </div>

                            <!-- Mobile App Content -->
                            <div class="p-2.5 space-y-2 bg-gradient-to-b from-surface-900 to-surface-950">
                                <!-- Maintenance Card -->
                                <div class="p-2 rounded-xl bg-gradient-to-br from-brand-500/20 to-purple-600/10 border border-brand-500/25">
                                    <div class="flex justify-between items-center mb-0.5">
                                        <span class="text-[8px] uppercase tracking-wider text-surface-200/60 font-semibold">Maintenance</span>
                                        <span class="text-[8px] font-bold text-amber-400">Due in 3d</span>
                                    </div>
                                    <div class="text-xs font-extrabold text-white">₹3,500<span class="text-[9px] text-surface-200/50 font-normal"> /mo</span></div>
                                    <div class="mt-1.5 flex items-center justify-center gap-1 py-1 px-2 rounded-lg bg-brand-500 hover:bg-brand-600 text-white text-[9px] font-bold shadow-md shadow-brand-500/30">
                                        <i data-lucide="zap" class="w-2.5 h-2.5"></i>
                                        <span>Pay with UPI</span>
                                    </div>
                                </div>

                                <!-- Quick Actions -->
                                <div class="grid grid-cols-3 gap-1 text-center">
                                    <div class="p-1 rounded-lg bg-white/5 border border-white/5">
                                        <i data-lucide="receipt" class="w-3 h-3 text-brand-400 mx-auto mb-0.5"></i>
                                        <span class="text-[7px] text-surface-200/70 block leading-tight font-medium">Receipts</span>
                                    </div>
                                    <div class="p-1 rounded-lg bg-white/5 border border-white/5">
                                        <i data-lucide="bell" class="w-3 h-3 text-emerald-400 mx-auto mb-0.5"></i>
                                        <span class="text-[7px] text-surface-200/70 block leading-tight font-medium">Notices</span>
                                    </div>
                                    <div class="p-1 rounded-lg bg-white/5 border border-white/5">
                                        <i data-lucide="message-square" class="w-3 h-3 text-amber-400 mx-auto mb-0.5"></i>
                                        <span class="text-[7px] text-surface-200/70 block leading-tight font-medium">Tickets</span>
                                    </div>
                                </div>

                                <!-- Activity Items -->
                                <div class="p-1.5 rounded-lg bg-white/[0.03] border border-white/5 flex items-center gap-1.5">
                                    <div class="w-4 h-4 rounded-md bg-emerald-500/20 flex items-center justify-center shrink-0">
                                        <i data-lucide="check" class="w-2.5 h-2.5 text-emerald-400"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-[8px] font-semibold text-white truncate">Water Tank Cleaned</p>
                                        <p class="text-[7px] text-surface-200/40">Today, 10:30 AM</p>
                                    </div>
                                </div>
                                <div class="p-1.5 rounded-lg bg-white/[0.03] border border-white/5 flex items-center gap-1.5">
                                    <div class="w-4 h-4 rounded-md bg-brand-500/20 flex items-center justify-center shrink-0">
                                        <i data-lucide="bell" class="w-2.5 h-2.5 text-brand-400"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-[8px] font-semibold text-white truncate">AGM Notice Posted</p>
                                        <p class="text-[7px] text-surface-200/40">Yesterday, 4:15 PM</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Bottom Bar -->
                            <div class="py-1 flex justify-center bg-surface-950">
                                <div class="w-10 h-0.5 bg-surface-700 rounded-full"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Floating notification card -->
                    <div class="absolute -bottom-6 -left-6 glass-panel-light rounded-xl p-3 pr-6 animate-float shadow-xl shadow-black/20 hidden sm:block" style="animation-delay: 1s;">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 flex items-center justify-center">
                                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i>
                            </div>
                            <div>
                                <div class="text-xs font-semibold text-white">Payment Received</div>
                                <div class="text-[10px] text-white/40">₹5,000 • Maintenance Fee</div>
                            </div>
                        </div>
                    </div>

                    <!-- Floating badge -->
                    <div class="absolute -top-3 -right-3 glass-panel-light rounded-xl px-4 py-2.5 animate-float shadow-xl shadow-black/20" style="animation-delay: 3s;">
                        <div class="flex items-center gap-2">
                            <i data-lucide="shield-check" class="w-4 h-4 text-brand-400"></i>
                            <span class="text-xs font-semibold text-white">SSL/TLS Secured</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in animate-delay-700">
            <span class="text-xs text-white/20 uppercase tracking-widest font-medium">Scroll</span>
            <div class="w-5 h-8 rounded-full border border-white/10 flex items-start justify-center p-1">
                <div class="w-1 h-2 rounded-full bg-white/30 animate-bounce"></div>
            </div>
        </div>
    </section>

    <!-- ========== FEATURES SECTION ========== -->
    <section id="features" class="relative py-28 overflow-hidden">
        <div class="glow-orb w-[500px] h-[500px] bg-brand-600/8 top-1/2 -translate-y-1/2 -left-48"></div>
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <!-- Section Header -->
            <div class="text-center mb-20" data-animate>
                <div class="section-badge mb-5 inline-flex">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                    Core Capabilities
                </div>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-5 tracking-tight">
                    Built for <span class="gradient-text">Excellence</span>
                </h2>
                <p class="text-white/40 max-w-2xl mx-auto text-lg leading-relaxed">
                    Everything your residential community needs, unified in one powerful platform with cutting-edge technology.
                </p>
            </div>

            <!-- Feature Cards Grid (4 Core Pillars) -->
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Feature 1: Cloud Portal -->
                <div class="feature-card group" data-animate>
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/15 flex items-center justify-center mb-6 group-hover:from-brand-500/30 group-hover:to-brand-600/20 group-hover:border-brand-500/25 transition-all">
                        <i data-lucide="zap" class="w-6 h-6 text-brand-400"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 tracking-tight">Instant Cloud Portal</h3>
                    <p class="text-white/40 leading-relaxed text-sm">Lightning-fast performance and seamless access on any device. Manage your society anywhere, anytime with responsive speed.</p>
                </div>

                <!-- Feature 2: Offline -->
                <div class="feature-card group" data-animate>
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500/20 to-emerald-600/10 border border-emerald-500/15 flex items-center justify-center mb-6 group-hover:from-emerald-500/30 group-hover:to-emerald-600/20 group-hover:border-emerald-500/25 transition-all">
                        <i data-lucide="wifi-off" class="w-6 h-6 text-emerald-400"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 tracking-tight">Offline Persistence</h3>
                    <p class="text-white/40 leading-relaxed text-sm">Access critical documents, digital IDs, and recent notices even without internet. Syncs automatically when you're back online.</p>
                </div>

                <!-- Feature 3: Security -->
                <div class="feature-card group" data-animate>
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-600/10 border border-amber-500/15 flex items-center justify-center mb-6 group-hover:from-amber-500/30 group-hover:to-amber-600/20 group-hover:border-amber-500/25 transition-all">
                        <i data-lucide="shield-check" class="w-6 h-6 text-amber-400"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 tracking-tight">Enterprise Security</h3>
                    <p class="text-white/40 leading-relaxed text-sm">Role-based access control with end-to-end SSL/TLS encryption, Bcrypt password protection, and CSRF guard on all actions.</p>
                </div>

                <!-- Feature 4: UPI Payments -->
                <div class="feature-card group" data-animate>
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-500/20 to-pink-600/10 border border-pink-500/15 flex items-center justify-center mb-6 group-hover:from-pink-500/30 group-hover:to-pink-600/20 group-hover:border-pink-500/25 transition-all">
                        <i data-lucide="indian-rupee" class="w-6 h-6 text-pink-400"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 tracking-tight">UPI Payments</h3>
                    <p class="text-white/40 leading-relaxed text-sm">Instant UPI & QR code payments for maintenance fees and community dues. Automated payment reconciliation and receipts.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== HOW IT WORKS SECTION ========== -->
    <section id="how-it-works" class="relative py-28 overflow-hidden">
        <div class="glow-orb w-[400px] h-[400px] bg-brand-500/8 top-0 right-0"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-20" data-animate>
                <div class="section-badge mb-5 inline-flex">
                    <i data-lucide="rocket" class="w-3.5 h-3.5"></i>
                    Get Started
                </div>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-5 tracking-tight">
                    Up and Running in <span class="gradient-text">Minutes</span>
                </h2>
                <p class="text-white/40 max-w-2xl mx-auto text-lg leading-relaxed">
                    Three simple steps to digitize your entire society operations.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8 relative">
                <!-- Connecting line -->
                <div class="hidden md:block absolute top-16 left-[20%] right-[20%] h-px bg-gradient-to-r from-transparent via-brand-500/20 to-transparent"></div>

                <!-- Step 1 -->
                <div class="relative text-center" data-animate>
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-6 relative z-10">
                        <span class="text-xl font-bold text-brand-400">1</span>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-3">Register Your Society</h3>
                    <p class="text-white/40 text-sm leading-relaxed max-w-xs mx-auto">Sign up with your society details and configure roles — admin, committee member, or resident.</p>
                </div>

                <!-- Step 2 -->
                <div class="relative text-center" data-animate>
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-6 relative z-10">
                        <span class="text-xl font-bold text-brand-400">2</span>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-3">Invite Members</h3>
                    <p class="text-white/40 text-sm leading-relaxed max-w-xs mx-auto">Send digital invites to all residents. They join instantly with a simple link — no paperwork needed.</p>
                </div>

                <!-- Step 3 -->
                <div class="relative text-center" data-animate>
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500/20 to-brand-600/10 border border-brand-500/20 flex items-center justify-center mx-auto mb-6 relative z-10">
                        <span class="text-xl font-bold text-brand-400">3</span>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-3">Go Digital</h3>
                    <p class="text-white/40 text-sm leading-relaxed max-w-xs mx-auto">Start managing payments, complaints, notices, visitor logs, and more — all from one unified dashboard.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== STATS SECTION ========== -->
    <section id="stats" class="relative py-24 overflow-hidden">
        <!-- Background -->
        <div class="absolute inset-0 bg-gradient-to-b from-surface-950 via-brand-950/20 to-surface-950"></div>
        <div class="glow-orb w-[500px] h-[500px] bg-brand-600/10 top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="glass-panel rounded-3xl p-10 md:p-16" data-animate>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-4">
                    <div class="stat-card relative">
                        <div class="stat-value gradient-text" data-count="500" data-suffix="+">0</div>
                        <div class="stat-label">Societies</div>
                    </div>
                    <div class="stat-card relative">
                        <div class="stat-value gradient-text" data-count="50000" data-suffix="+">0</div>
                        <div class="stat-label">Residents</div>
                    </div>
                    <div class="stat-card relative">
                        <div class="stat-value gradient-text" data-count="99.9" data-suffix="%">0</div>
                        <div class="stat-label">Uptime</div>
                    </div>
                    <div class="stat-card relative">
                        <div class="stat-value gradient-text">24/7</div>
                        <div class="stat-label">Support</div>
                    </div>
                </div>

                <!-- Divider with trust logos -->
                <div class="mt-12 pt-10 border-t border-white/5 flex flex-col sm:flex-row items-center justify-center gap-6 text-white/20">
                    <span class="text-xs uppercase tracking-widest font-medium">Trusted by communities across</span>
                    <div class="flex items-center gap-6">
                        <span class="text-sm font-semibold">Mumbai</span>
                        <span class="w-1 h-1 rounded-full bg-white/20"></span>
                        <span class="text-sm font-semibold">Pune</span>
                        <span class="w-1 h-1 rounded-full bg-white/20"></span>
                        <span class="text-sm font-semibold">Bangalore</span>
                        <span class="w-1 h-1 rounded-full bg-white/20"></span>
                        <span class="text-sm font-semibold">Delhi</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== CTA SECTION ========== -->
    <section class="relative py-28 overflow-hidden">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="relative rounded-[2.5rem] overflow-hidden" data-animate>
                <!-- CTA Background -->
                <div class="absolute inset-0 bg-gradient-to-br from-brand-600 via-brand-700 to-purple-800"></div>
                <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.15) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(255,255,255,0.08) 0%, transparent 50%);"></div>
                
                <!-- Decorative orbs -->
                <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
                <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full blur-2xl translate-y-1/3 -translate-x-1/4"></div>

                <div class="relative z-10 p-10 md:p-16 lg:p-20 text-center">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/15 mb-8">
                        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-white/70"></i>
                        <span class="text-xs font-bold text-white/80 uppercase tracking-wider">Free for small communities</span>
                    </div>

                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 tracking-tight leading-tight">
                        Ready to modernize<br class="hidden sm:block"> your community?
                    </h2>
                    <p class="text-white/60 text-lg mb-10 max-w-xl mx-auto leading-relaxed">
                        Join hundreds of housing societies already using SocietyApp to streamline their daily operations and enhance resident experience.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row justify-center gap-4">
                        {% if user %}
                        <a href="{{ user.role == 'admin' ? '/admin' : '/tenant' }}" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-brand-700 rounded-2xl font-bold text-lg hover:bg-white/90 hover:shadow-2xl transition-all active:scale-95" id="cta-primary">
                            Go to Dashboard
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </a>
                        {% else %}
                        <a href="/auth/login" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-brand-700 rounded-2xl font-bold text-lg hover:bg-white/90 hover:shadow-2xl transition-all active:scale-95" id="cta-primary">
                            Get Started
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </a>
                        {% endif %}
                        <a href="#" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 text-white border border-white/15 rounded-2xl font-bold text-lg hover:bg-white/15 transition-all" id="cta-demo">
                            <i data-lucide="calendar" class="w-5 h-5"></i>
                            Schedule a Demo
                        </a>
                    </div>

                    <p class="mt-6 text-sm text-white/30">No credit card required • Setup in 2 minutes</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
