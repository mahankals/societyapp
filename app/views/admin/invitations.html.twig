{% extends "layouts/base.html.twig" %}

{% block title %}Send Invitations | SocietyApp{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="min-h-screen px-4">
    <nav class="glass-panel mx-4 mt-4 rounded-2xl px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <a href="/admin" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
            </a>
            <div>
                <h1 class="text-lg font-bold text-white">Send Invitations</h1>
                <p class="text-sm text-surface-200/40">Invite new residents to join</p>
            </div>
        </div>
    </nav>

    {% if flash %}
    <div class="mx-4 mt-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <form method="POST" action="/admin/invitations" class="mt-4 space-y-4 mx-4 max-w-2xl">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        
        <div class="glass-panel rounded-2xl p-6">
            <h2 class="text-lg font-semibold text-white mb-4">New Invitation</h2>
            
            <div class="space-y-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-white/80 mb-2">Resident Name</label>
                    <input type="text" id="name" name="name" required
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                        placeholder="John Doe">
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium text-white/80 mb-2">Email Address</label>
                    <input type="email" id="email" name="email" required
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all"
                        placeholder="john@example.com">
                </div>
            </div>

            <div class="mt-6 p-4 rounded-xl bg-blue-500/10 border border-blue-500/20">
                <div class="flex items-start gap-3">
                    <i data-lucide="info" class="w-5 h-5 text-blue-400 flex-shrink-0 mt-0.5"></i>
                    <p class="text-sm text-blue-200">
                        An invitation link will be generated and logged. The link will be valid for 7 days. The user can use it to register directly.
                    </p>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary w-full !h-14 !text-base !rounded-xl">
            <i data-lucide="send" class="w-5 h-5"></i>
            Send Invitation
        </button>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
