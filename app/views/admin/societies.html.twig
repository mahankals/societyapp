{% extends "layouts/mobile.html.twig" %}

{% block title %}Societies Management | Admin{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/admin" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">&larr; Platform Dashboard</a>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Societies Management</h1>
            <p class="text-xs text-slate-500 dark:text-surface-200/60">{{ societies|length }} Housing Societies on Platform</p>
        </div>

        <div class="flex items-center gap-2">
            <a href="/admin/societies/pending" class="px-4 py-2.5 rounded-xl border border-amber-500/30 bg-amber-500/10 hover:bg-amber-500/20 text-xs font-semibold text-amber-700 dark:text-amber-300 flex items-center gap-2 transition-all shadow-sm">
                <i data-lucide="inbox" class="w-4 h-4 text-amber-600 dark:text-amber-400"></i>
                <span>Pending Proposals</span>
                {% if pendingRequestsCount > 0 %}
                <span class="px-2 py-0.5 rounded-full bg-amber-500 text-slate-900 font-bold text-[10px]">
                    {{ pendingRequestsCount }}
                </span>
                {% endif %}
            </a>
        </div>
    </div>

    {% if flash.success %}
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-sm flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4"></i>
        <span>{{ flash.success }}</span>
    </div>
    {% endif %}
    {% if flash.error %}
    <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-300 text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>{{ flash.error }}</span>
    </div>
    {% endif %}

    <!-- Real-time Search Filter Bar -->
    <div class="mb-4 flex items-center justify-between gap-4">
        <div class="relative max-w-sm w-full">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-surface-200/40 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input type="text" id="societySearchInput" placeholder="Search society by name, code, or city..." class="input-glass w-full !pl-10 !py-2 text-xs" oninput="filterSocietiesTable()">
        </div>
    </div>

    <!-- Societies Table -->
    <div class="bg-white dark:bg-surface-900 rounded-2xl overflow-hidden border border-slate-200 dark:border-white/10 shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700 dark:text-surface-200/80">
                <thead class="text-xs uppercase bg-slate-50 dark:bg-white/[0.03] text-slate-500 dark:text-surface-200/60 border-b border-slate-200 dark:border-white/5">
                    <tr>
                        <th class="py-3.5 px-4 font-semibold">Society Name</th>
                        <th class="py-3.5 px-4 font-semibold">Code / Reg No</th>
                        <th class="py-3.5 px-4 font-semibold">Location</th>
                        <th class="py-3.5 px-4 font-semibold">Flats &amp; Members</th>
                        <th class="py-3.5 px-4 font-semibold">Status</th>
                        <th class="py-3.5 px-4 text-right font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody id="societiesTableBody" class="divide-y divide-slate-100 dark:divide-white/5">
                    <tr id="societiesEmptySearchRow" style="display: none;">
                        <td colspan="6" class="py-8 text-center text-xs text-slate-400 dark:text-surface-200/40">
                            No matching societies found.
                        </td>
                    </tr>
                    {% for s in societies %}
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-white/[0.02] transition-colors">
                        <td class="py-3.5 px-4">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-brand-500/15 text-brand-600 dark:text-brand-300 flex items-center justify-center font-bold text-xs">
                                    {{ s.name|first|upper }}
                                </div>
                                <div>
                                    <p class="font-semibold text-slate-900 dark:text-white">{{ s.name }}</p>
                                    <span class="text-[11px] text-slate-400 dark:text-surface-200/40">Created {{ s.created_at|date('d M Y') }}</span>
                                </div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 text-xs font-mono">
                            <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-800 dark:text-white font-bold">{{ s.society_code }}</span>
                            {% if s.registration_no %}
                            <p class="text-[11px] text-slate-400 dark:text-surface-200/40 mt-1">Reg: {{ s.registration_no }}</p>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-xs">
                            <p class="text-slate-900 dark:text-white font-medium">{{ s.city ?: 'City N/A' }}{% if s.state %}, {{ s.state }}{% endif %}</p>
                            <p class="text-slate-400 dark:text-surface-200/40 truncate max-w-xs">{{ s.address ?: '-' }}</p>
                        </td>
                        <td class="py-3.5 px-4 text-xs font-medium">
                            <p class="text-brand-600 dark:text-brand-300 font-semibold">{{ s.total_flats }} Flats</p>
                            <p class="text-slate-500 dark:text-surface-200/50">{{ s.total_members }} Active Members</p>
                        </td>
                        <td class="py-3.5 px-4">
                            {% if s.is_active|default(1) %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
                                Active
                            </span>
                            {% else %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-500/15 text-rose-700 dark:text-rose-400 border border-rose-500/20">
                                Disabled
                            </span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <button type="button" 
                                    onclick='openViewSocietyModal({{ s|json_encode|raw }})' 
                                    class="px-2.5 py-1 rounded-lg border border-slate-300 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-white/5 text-slate-700 dark:text-surface-200/80 text-xs font-medium transition-colors" 
                                    title="View Full Details">
                                    Show
                                </button>
                                
                                <form action="/admin/societies/{{ s.id }}/toggle-status" method="POST" class="inline">
                                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                    <button type="submit" 
                                        class="px-2.5 py-1 rounded-lg text-xs font-semibold border transition-colors {{ s.is_active|default(1) ? 'border-amber-500/30 text-amber-700 dark:text-amber-300 hover:bg-amber-500/10' : 'border-emerald-500/30 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-500/10' }}">
                                        {{ s.is_active|default(1) ? 'Disable' : 'Enable' }}
                                    </button>
                                </form>

                                <form action="/admin/societies/{{ s.id }}/delete" method="POST" onsubmit="event.preventDefault(); window.appConfirm('Are you sure you want to delete society {{ s.name }}? This will remove all associated units.', () => this.submit());">
                                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                    <button type="submit" class="p-1.5 rounded-lg hover:bg-rose-500/10 text-slate-400 hover:text-rose-500 transition-colors" title="Delete Society">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="py-8 text-center text-slate-400 dark:text-surface-200/50">No societies found. New societies are created via user proposals.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- View Society Details Modal (Show) -->
<div id="viewSocietyModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm overflow-y-auto">
    <div class="bg-white dark:bg-surface-900 rounded-2xl max-w-lg w-full border border-slate-200 dark:border-white/10 shadow-2xl max-h-[calc(100vh-2rem)] flex flex-col my-auto overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b border-slate-200 dark:border-white/10 shrink-0">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="building-2" class="w-4 h-4 text-brand-500"></i>
                <span id="viewSocTitle">Society Details</span>
            </h3>
            <button type="button" onclick="document.getElementById('viewSocietyModal').classList.add('hidden')" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:text-surface-200/50 dark:hover:text-white transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div class="p-6 overflow-y-auto flex-1 space-y-4 text-sm">
            <div class="grid grid-cols-2 gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200 dark:border-white/5">
                <div>
                    <span class="block text-xs text-slate-500 dark:text-surface-200/50 font-medium">Society Code</span>
                    <span id="viewSocCode" class="font-mono font-bold text-slate-900 dark:text-white"></span>
                </div>
                <div>
                    <span class="block text-xs text-slate-500 dark:text-surface-200/50 font-medium">Registration No</span>
                    <span id="viewSocReg" class="font-medium text-slate-900 dark:text-white"></span>
                </div>
            </div>

            <div>
                <span class="block text-xs text-slate-500 dark:text-surface-200/50 font-medium mb-1">Premises Address &amp; Location</span>
                <p id="viewSocAddress" class="text-slate-900 dark:text-white leading-relaxed"></p>
                <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-1" id="viewSocCityState"></p>
            </div>

            <div class="grid grid-cols-2 gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200 dark:border-white/5">
                <div>
                    <span class="block text-xs text-slate-500 dark:text-surface-200/50 font-medium">Total Flats</span>
                    <span id="viewSocFlats" class="font-bold text-brand-600 dark:text-brand-300"></span>
                </div>
                <div>
                    <span class="block text-xs text-slate-500 dark:text-surface-200/50 font-medium">Active Members</span>
                    <span id="viewSocMembers" class="font-bold text-emerald-600 dark:text-emerald-400"></span>
                </div>
            </div>
        </div>

        <div class="flex justify-end p-4 border-t border-slate-200 dark:border-white/10 shrink-0 bg-slate-50 dark:bg-surface-900">
            <button type="button" onclick="document.getElementById('viewSocietyModal').classList.add('hidden')" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold transition-all">Close</button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    function openViewSocietyModal(soc) {
        if (!soc) return;
        document.getElementById('viewSocTitle').textContent = soc.name || 'Society Details';
        document.getElementById('viewSocCode').textContent = soc.society_code || '-';
        document.getElementById('viewSocReg').textContent = soc.registration_no || 'Not Registered';
        document.getElementById('viewSocAddress').textContent = soc.address || 'Address not specified';
        document.getElementById('viewSocCityState').textContent = (soc.city || '') + (soc.state ? ', ' + soc.state : '') + (soc.pincode ? ' - ' + soc.pincode : '');
        document.getElementById('viewSocFlats').textContent = (soc.total_flats || 0) + ' Flats';
        document.getElementById('viewSocMembers').textContent = (soc.total_members || 0) + ' Members';
        document.getElementById('viewSocietyModal').classList.remove('hidden');
        if (window.lucide) { lucide.createIcons(); }
    }

    function filterSocietiesTable() {
        const q = (document.getElementById('societySearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#societiesTableBody tr');
        let visible = 0;
        rows.forEach(r => {
            if (r.id === 'societiesEmptySearchRow') return;
            const text = r.textContent.toLowerCase();
            if (!q || text.includes(q)) {
                r.style.display = '';
                visible++;
            } else {
                r.style.display = 'none';
            }
        });
        const emptyRow = document.getElementById('societiesEmptySearchRow');
        if (emptyRow) {
            emptyRow.style.display = (visible === 0) ? '' : 'none';
        }
    }
</script>
{% endblock %}
