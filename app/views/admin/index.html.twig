{% extends "layouts/mobile.html.twig" %}

{% block title %}Admin Dashboard | SocietyApp{% endblock %}

{% block content %}
{% if flash %}
<div class="mx-4 mt-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
    <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
    {{ flash.message }}
</div>
{% endif %}

<div class="p-4">
    <h2 class="text-xl font-bold text-white mb-4">Revenue Overview</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-2">
                <div class="w-10 h-10 rounded-xl bg-green-500/20 flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-5 h-5 text-green-400"></i>
                </div>
            </div>
            <p class="text-2xl font-bold text-white">₹{{ revenueStats.totalCollected|number_format }}</p>
            <p class="text-xs text-surface-200/60">Total Collected</p>
        </div>
        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-2">
                <div class="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center">
                    <i data-lucide="trending-down" class="w-5 h-5 text-red-400"></i>
                </div>
            </div>
            <p class="text-2xl font-bold text-white">₹{{ revenueStats.totalPending|number_format }}</p>
            <p class="text-xs text-surface-200/60">Pending Payment</p>
        </div>
        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-2">
                <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center">
                    <i data-lucide="wallet" class="w-5 h-5 text-blue-400"></i>
                </div>
            </div>
            <p class="text-2xl font-bold text-white">₹{{ monthlyRevenue|number_format }}</p>
            <p class="text-xs text-surface-200/60">This Month</p>
        </div>
    </div>

    <h2 class="text-xl font-bold text-white mb-4">Quick Stats</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <a href="/admin/users" class="glass-panel rounded-2xl p-4 text-center hover:bg-white/5 transition-all">
            <p class="text-2xl font-bold text-white">{{ stats.totalUsers }}</p>
            <p class="text-xs text-surface-200/60">Total Residents</p>
        </a>
        <a href="/admin/bills" class="glass-panel rounded-2xl p-4 text-center hover:bg-white/5 transition-all">
            <p class="text-2xl font-bold text-red-400">{{ stats.unpaidBills }}</p>
            <p class="text-xs text-surface-200/60">Pending Bills</p>
        </a>
        <a href="/admin/requests" class="glass-panel rounded-2xl p-4 text-center hover:bg-white/5 transition-all">
            <p class="text-2xl font-bold text-orange-400">{{ stats.pendingRequests }}</p>
            <p class="text-xs text-surface-200/60">Open Requests</p>
        </a>
        <div class="glass-panel rounded-2xl p-4 text-center">
            <p class="text-2xl font-bold text-brand-400">{{ stats.activeUsers }}</p>
            <p class="text-xs text-surface-200/60">Active Users</p>
        </div>
    </div>
</div>

<div class="p-4 grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div class="glass-panel rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-white">Quick Actions</h3>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <a href="/admin/users" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                <i data-lucide="user-plus" class="w-5 h-5 text-brand-400"></i>
                <span class="text-sm text-surface-200">Manage Users</span>
            </a>
            <a href="/admin/invitations" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                <i data-lucide="mail" class="w-5 h-5 text-brand-400"></i>
                <span class="text-sm text-surface-200">Send Invites</span>
            </a>
            <a href="/admin/bills" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                <i data-lucide="file-text" class="w-5 h-5 text-brand-400"></i>
                <span class="text-sm text-surface-200">Generate Bills</span>
            </a>
            <a href="/admin/notifications" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                <i data-lucide="megaphone" class="w-5 h-5 text-brand-400"></i>
                <span class="text-sm text-surface-200">Broadcast Notice</span>
            </a>
        </div>
    </div>

    <div class="glass-panel rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-white">Recent Requests</h3>
            <a href="/admin/requests" class="text-sm text-brand-400 hover:text-brand-300">View All</a>
        </div>
        <div class="space-y-3">
            {% for request in recentRequests %}
            <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center
                        {% if request.priority == 'urgent' %}bg-red-500/20 text-red-400
                        {% elseif request.priority == 'high' %}bg-orange-500/20 text-orange-400
                        {% else %}bg-blue-500/20 text-blue-400{% endif %}">
                        <i data-lucide="wrench" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <p class="text-sm text-white">{{ request.category }}</p>
                        <p class="text-xs text-surface-200/40">{{ request.user_name }}</p>
                    </div>
                </div>
                <span class="px-2 py-1 rounded-lg text-xs font-medium
                    {% if request.status == 'completed' %}bg-green-500/20 text-green-400
                    {% elseif request.status == 'in_progress' %}bg-blue-500/20 text-blue-400
                    {% else %}bg-yellow-500/20 text-yellow-400{% endif %}">
                    {{ request.status|replace({'_': ' '})|title }}
                </span>
            </div>
            {% else %}
            <p class="text-sm text-surface-200/40 text-center py-4">No requests yet</p>
            {% endfor %}
        </div>
    </div>
</div>

<div class="p-4">
    <div class="glass-panel rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-white">Recent Members</h3>
            <a href="/admin/users" class="text-sm text-brand-400 hover:text-brand-300">View All</a>
        </div>
        <div class="space-y-3">
            {% for user in recentUsers %}
            <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-brand-500/20 flex items-center justify-center">
                        <i data-lucide="user" class="w-5 h-5 text-brand-400"></i>
                    </div>
                    <div>
                        <p class="text-sm text-white">{{ user.name }}</p>
                        <p class="text-xs text-surface-200/40">{{ user.email }}</p>
                    </div>
                </div>
                <span class="text-xs text-surface-200/40">{{ user.created_at|date('M d') }}</span>
            </div>
            {% else %}
            <p class="text-sm text-surface-200/40 text-center py-4">No users yet</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
