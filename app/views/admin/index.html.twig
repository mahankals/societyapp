{% extends "layouts/base.html.twig" %}

{% block title %}Admin Dashboard | SocietyApp{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="min-h-screen pt-20">
    <nav class="glass-panel mx-4 mt-4 rounded-2xl px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center">
                <i data-lucide="shield" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-white">Admin Panel</h1>
                <p class="text-sm text-surface-200/40">{{ user.name }}</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ basePath }}client" class="flex items-center gap-2 px-4 py-2 text-sm text-surface-200/60 hover:text-white hover:bg-white/5 rounded-lg transition-all">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                Client View
            </a>
            <a href="{{ basePath }}auth/logout" class="flex items-center gap-2 px-4 py-2 text-sm text-surface-200/60 hover:text-white hover:bg-white/5 rounded-lg transition-all">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                Sign out
            </a>
        </div>
    </nav>

    {% if flash %}
    <div class="mx-4 mt-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center">
                    <i data-lucide="users" class="w-6 h-6 text-blue-400"></i>
                </div>
                <span class="text-xs text-surface-200/40">Total</span>
            </div>
            <h3 class="text-3xl font-bold text-white mb-1">156</h3>
            <p class="text-sm text-surface-200/60">Registered Residents</p>
        </div>

        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center">
                    <i data-lucide="credit-card" class="w-6 h-6 text-green-400"></i>
                </div>
                <span class="text-xs text-surface-200/40">This Month</span>
            </div>
            <h3 class="text-3xl font-bold text-white mb-1">₹4.2L</h3>
            <p class="text-sm text-surface-200/60">Collections</p>
        </div>

        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-orange-500/20 flex items-center justify-center">
                    <i data-lucide="wrench" class="w-6 h-6 text-orange-400"></i>
                </div>
                <span class="text-xs text-surface-200/40">Pending</span>
            </div>
            <h3 class="text-3xl font-bold text-white mb-1">12</h3>
            <p class="text-sm text-surface-200/60">Service Requests</p>
        </div>

        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-red-500/20 flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-red-400"></i>
                </div>
                <span class="text-xs text-surface-200/40">Open</span>
            </div>
            <h3 class="text-3xl font-bold text-white mb-1">5</h3>
            <p class="text-sm text-surface-200/60">Complaints</p>
        </div>
    </div>

    <div class="p-4 grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="glass-panel rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Quick Actions</h3>
            <div class="grid grid-cols-2 gap-3">
                <a href="#" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                    <i data-lucide="user-plus" class="w-5 h-5 text-brand-400"></i>
                    <span class="text-sm text-surface-200">Add Resident</span>
                </a>
                <a href="#" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                    <i data-lucide="file-text" class="w-5 h-5 text-brand-400"></i>
                    <span class="text-sm text-surface-200">Generate Bill</span>
                </a>
                <a href="#" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                    <i data-lucide="megaphone" class="w-5 h-5 text-brand-400"></i>
                    <span class="text-sm text-surface-200">Post Notice</span>
                </a>
                <a href="#" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                    <i data-lucide="mail" class="w-5 h-5 text-brand-400"></i>
                    <span class="text-sm text-surface-200">Email Requests</span>
                </a>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Recent Activity</h3>
            <div class="space-y-4">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                        <i data-lucide="user-plus" class="w-4 h-4 text-green-400"></i>
                    </div>
                    <div>
                        <p class="text-sm text-surface-200">New resident <strong class="text-white">Rahul Sharma</strong> registered</p>
                        <p class="text-xs text-surface-200/40 mt-1">2 hours ago</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                        <i data-lucide="credit-card" class="w-4 h-4 text-blue-400"></i>
                    </div>
                    <div>
                        <p class="text-sm text-surface-200">Payment received from <strong class="text-white">Apt 101</strong></p>
                        <p class="text-xs text-surface-200/40 mt-1">5 hours ago</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-full bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                        <i data-lucide="wrench" class="w-4 h-4 text-orange-400"></i>
                    </div>
                    <div>
                        <p class="text-sm text-surface-200">Service request #234 marked complete</p>
                        <p class="text-xs text-surface-200/40 mt-1">Yesterday</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
