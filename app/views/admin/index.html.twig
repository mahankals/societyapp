{% extends "layouts/base.html.twig" %}

{% block title %}Admin Dashboard | SocietyApp{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="min-h-screen">
    <nav class="glass-panel mx-4 mt-4 rounded-2xl px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center">
                <i data-lucide="shield" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-white">Admin Panel</h1>
                <p class="text-sm text-surface-200/40">{{ user.name }}</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="/client" class="flex items-center gap-2 px-4 py-2 text-sm text-surface-200/60 hover:text-white hover:bg-white/5 rounded-lg transition-all">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                Client View
            </a>
            <a href="/auth/logout" class="flex items-center gap-2 px-4 py-2 text-sm text-surface-200/60 hover:text-white hover:bg-white/5 rounded-lg transition-all">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                Sign out
            </a>
        </div>
    </nav>

    {% if flash %}
    <div class="mx-4 mt-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/admin/users" class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-blue-500/20 flex items-center justify-center">
                    <i data-lucide="users" class="w-6 h-6 text-blue-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-3xl font-bold text-white mb-1">{{ stats.totalUsers }}</h3>
            <p class="text-sm text-surface-200/60">Total Residents</p>
        </a>

        <a href="/admin/bills" class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-green-500/20 flex items-center justify-center">
                    <i data-lucide="credit-card" class="w-6 h-6 text-green-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-3xl font-bold text-white mb-1">{{ stats.unpaidBills }}</h3>
            <p class="text-sm text-surface-200/60">Pending Bills</p>
        </a>

        <a href="/admin/requests" class="glass-panel rounded-2xl p-6 hover:bg-white/5 transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-orange-500/20 flex items-center justify-center">
                    <i data-lucide="wrench" class="w-6 h-6 text-orange-400"></i>
                </div>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white/20 group-hover:text-brand-400 transition-colors"></i>
            </div>
            <h3 class="text-3xl font-bold text-white mb-1">{{ stats.pendingRequests }}</h3>
            <p class="text-sm text-surface-200/60">Open Requests</p>
        </a>

        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-brand-500/20 flex items-center justify-center">
                    <i data-lucide="user-check" class="w-6 h-6 text-brand-400"></i>
                </div>
            </div>
            <h3 class="text-3xl font-bold text-white mb-1">{{ stats.activeUsers }}</h3>
            <p class="text-sm text-surface-200/60">Active Users</p>
        </div>
    </div>

    <div class="p-4 grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-white">Quick Actions</h3>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <a href="/admin/users" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                    <i data-lucide="user-plus" class="w-5 h-5 text-brand-400"></i>
                    <span class="text-sm text-surface-200">Manage Users</span>
                </a>
                <a href="/admin/invitations" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                    <i data-lucide="mail" class="w-5 h-5 text-brand-400"></i>
                    <span class="text-sm text-surface-200">Send Invites</span>
                </a>
                <a href="/admin/bills" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                    <i data-lucide="file-text" class="w-5 h-5 text-brand-400"></i>
                    <span class="text-sm text-surface-200">Generate Bills</span>
                </a>
                <a href="/admin/notifications" class="flex items-center gap-3 p-4 bg-white/5 hover:bg-white/10 rounded-xl transition-colors">
                    <i data-lucide="megaphone" class="w-5 h-5 text-brand-400"></i>
                    <span class="text-sm text-surface-200">Broadcast Notice</span>
                </a>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-white">Recent Requests</h3>
                <a href="/admin/requests" class="text-sm text-brand-400 hover:text-brand-300">View All</a>
            </div>
            <div class="space-y-3">
                {% for request in recentRequests %}
                <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center
                            {% if request.priority == 'urgent' %}bg-red-500/20 text-red-400
                            {% elseif request.priority == 'high' %}bg-orange-500/20 text-orange-400
                            {% else %}bg-blue-500/20 text-blue-400{% endif %}">
                            <i data-lucide="wrench" class="w-4 h-4"></i>
                        </div>
                        <div>
                            <p class="text-sm text-white">{{ request.category }}</p>
                            <p class="text-xs text-surface-200/40">{{ request.user_name }}</p>
                        </div>
                    </div>
                    <span class="px-2 py-1 rounded-lg text-xs font-medium
                        {% if request.status == 'completed' %}bg-green-500/20 text-green-400
                        {% elseif request.status == 'in_progress' %}bg-blue-500/20 text-blue-400
                        {% else %}bg-yellow-500/20 text-yellow-400{% endif %}">
                        {{ request.status|replace({'_': ' '})|title }}
                    </span>
                </div>
                {% else %}
                <p class="text-sm text-surface-200/40 text-center py-4">No requests yet</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
