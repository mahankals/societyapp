{% extends "layouts/mobile.html.twig" %}

{% block title %}Manage Admin Users | SocietyApp{% endblock %}

{% block content %}
<div class="px-4 py-4 max-w-7xl mx-auto">
    <div class="flex items-center gap-4 mb-4">
        <a href="/admin" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
        </a>
        <div>
            <h1 class="text-xl font-bold text-white tracking-tight">Manage Admin Users</h1>
            <p class="text-xs text-surface-200/50">{{ users|length }} platform administrator{{ users|length == 1 ? '' : 's' }} authorized for admin pages</p>
        </div>
    </div>

    <!-- Notice -->
    <div class="mb-4 p-3.5 rounded-xl bg-blue-500/10 border border-blue-500/20 text-xs text-blue-300 flex items-start gap-2.5">
        <i data-lucide="shield-alert" class="w-4 h-4 text-blue-400 shrink-0 mt-0.5"></i>
        <span>Only admin type users are listed here. Resident and tenant members are managed within their respective housing societies.</span>
    </div>

    <form method="GET" class="mb-4 glass-panel rounded-xl p-4">
        <div class="flex flex-col md:flex-row gap-3">
            <div class="flex-1">
                <input type="text" name="search" value="{{ search }}" placeholder="Search by name, email..." 
                    class="input-glass w-full text-sm">
            </div>
            <select name="status" class="input-glass text-sm">
                <option value="">All Status</option>
                <option value="active" {% if status == 'active' %}selected{% endif %}>Active</option>
                <option value="inactive" {% if status == 'inactive' %}selected{% endif %}>Inactive</option>
            </select>
            <button type="submit" class="btn-primary !py-2 !px-5 text-xs font-semibold">Search</button>
        </div>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full glass-panel rounded-2xl overflow-hidden text-left text-sm text-surface-200/80">
            <thead class="bg-white/5 text-xs uppercase tracking-wider text-surface-200/60 border-b border-white/5">
                <tr>
                    <th class="px-6 py-4 font-semibold">Administrator</th>
                    <th class="px-6 py-4 font-semibold">Email</th>
                    <th class="px-6 py-4 font-semibold">User Type</th>
                    <th class="px-6 py-4 font-semibold">Status</th>
                    <th class="px-6 py-4 font-semibold">Created</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                {% for u in users %}
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="px-6 py-4">
                        <a href="/admin/users/{{ u.id }}" class="text-white font-medium hover:text-brand-400 flex items-center gap-2">
                            <i data-lucide="shield-check" class="w-4 h-4 text-brand-400"></i>
                            <span>{{ u.name }}</span>
                        </a>
                    </td>
                    <td class="px-6 py-4 text-surface-200/70">{{ u.email }}</td>
                    <td class="px-6 py-4">
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-500/15 text-red-400 border border-red-500/30">
                            Admin
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold {% if u.is_active %}bg-emerald-500/15 text-emerald-400 border border-emerald-500/30{% else %}bg-rose-500/15 text-rose-400 border border-rose-500/30{% endif %}">
                            {{ u.is_active ? 'Active' : 'Inactive' }}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-surface-200/40 text-xs font-mono">{{ u.created_at|date('M d, Y') }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-8 text-center text-surface-200/40">No administrator accounts found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
