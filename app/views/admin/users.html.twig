{% extends "layouts/app.html.twig" %}

{% block title %}Manage Users | SocietyApp{% endblock %}

{% block content %}
<div class="px-4 py-4">
    <div class="flex items-center gap-4 mb-4">
        <a href="/admin" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
        </a>
        <div>
            <h1 class="text-lg font-bold text-white">Manage Users</h1>
            <p class="text-sm text-surface-200/40">{{ users|length }} residents</p>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full glass-panel rounded-2xl overflow-hidden">
            <thead class="bg-white/5">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase tracking-wider">Email</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase tracking-wider">Apartment</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase tracking-wider">Role</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase tracking-wider">Joined</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                {% for u in users %}
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="px-6 py-4">
                        <a href="/admin/users/{{ u.id }}" class="text-white font-medium hover:text-brand-400">{{ u.name }}</a>
                    </td>
                    <td class="px-6 py-4 text-surface-200/60">{{ u.email }}</td>
                    <td class="px-6 py-4 text-surface-200/60">{{ u.apartment|default('-') }}</td>
                    <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-lg text-xs font-medium {% if u.role == 'admin' %}bg-red-500/20 text-red-400{% else %}bg-blue-500/20 text-blue-400{% endif %}">
                            {{ u.role|title }}
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-lg text-xs font-medium {% if u.is_active %}bg-green-500/20 text-green-400{% else %}bg-red-500/20 text-red-400{% endif %}">
                            {{ u.is_active ? 'Active' : 'Inactive' }}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-surface-200/40 text-sm">{{ u.created_at|date('M d, Y') }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-surface-200/40">No users found</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
