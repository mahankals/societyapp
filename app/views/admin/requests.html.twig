{% extends "layouts/mobile.html.twig" %}

{% block title %}Service Requests | SocietyApp{% endblock %}

{% block content %}
<div class="px-4 py-4">
    <div class="flex items-center gap-4 mb-4">
        <a href="/admin" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
        </a>
        <div>
            <h1 class="text-lg font-bold text-white">Service Requests</h1>
            <p class="text-sm text-surface-200/40">{{ requests|length }} requests</p>
        </div>
    </div>

    <div class="space-y-3">
        {% for request in requests %}
        <div class="glass-panel rounded-2xl p-4">
            <form method="POST" action="/admin/requests/{{ request.id }}" class="flex items-start justify-between">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0
                        {% if request.priority == 'urgent' %}bg-red-500/20 text-red-400
                        {% elseif request.priority == 'high' %}bg-orange-500/20 text-orange-400
                        {% else %}bg-blue-500/20 text-blue-400{% endif %}">
                        <i data-lucide="wrench" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-medium">{{ request.category }}</h3>
                        <p class="text-sm text-surface-200/50 mt-1">{{ request.description }}</p>
                        <p class="text-xs text-surface-200/30 mt-2">
                            {{ request.user_name }} ({{ request.user_email }}) • {{ request.created_at|date('M d, Y h:i A') }}
                        </p>
                    </div>
                </div>
                <div class="flex flex-col items-end gap-2">
                    <select name="status" onchange="this.form.submit()" class="text-sm bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-white">
                        <option value="pending" {% if request.status == 'pending' %}selected{% endif %} class="text-surface-900">Pending</option>
                        <option value="in_progress" {% if request.status == 'in_progress' %}selected{% endif %} class="text-surface-900">In Progress</option>
                        <option value="completed" {% if request.status == 'completed' %}selected{% endif %} class="text-surface-900">Completed</option>
                        <option value="cancelled" {% if request.status == 'cancelled' %}selected{% endif %} class="text-surface-900">Cancelled</option>
                    </select>
                </div>
            </form>
        </div>
        {% else %}
        <div class="glass-panel rounded-2xl p-8 text-center">
            <p class="text-surface-200/40">No service requests yet</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
