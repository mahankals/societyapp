{% extends "layouts/base.html.twig" %}

{% block title %}Edit User | SocietyApp{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="min-h-screen px-4">
    <nav class="glass-panel mx-4 mt-4 rounded-2xl px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <a href="/admin/users" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
            </a>
            <div>
                <h1 class="text-lg font-bold text-white">Edit User</h1>
                <p class="text-sm text-surface-200/40">{{ targetUser.email }}</p>
            </div>
        </div>
    </nav>

    {% if flash %}
    <div class="mx-4 mt-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <form method="POST" action="/admin/users/{{ targetUser.id }}" class="mt-4 space-y-4 mx-4 max-w-2xl">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        
        <div class="glass-panel rounded-2xl p-6">
            <h2 class="text-lg font-semibold text-white mb-4">User Information</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-white/80 mb-2">Full Name</label>
                    <input type="text" id="name" name="name" value="{{ targetUser.name }}" required
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all">
                </div>
                <div>
                    <label for="role" class="block text-sm font-medium text-white/80 mb-2">Role</label>
                    <select id="role" name="role"
                        class="w-full h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white focus:outline-none focus:ring-2 focus:ring-brand-500/50 focus:border-brand-500/30 transition-all">
                        <option value="resident" {% if targetUser.role == 'resident' %}selected{% endif %} class="text-surface-900">Resident</option>
                        <option value="admin" {% if targetUser.role == 'admin' %}selected{% endif %} class="text-surface-900">Admin</option>
                    </select>
                </div>
            </div>

            <div class="mt-4">
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="is_active" {% if targetUser.is_active %}checked{% endif %} class="w-5 h-5 rounded-lg border-white/20 bg-white/5 text-brand-500 focus:ring-brand-500/30">
                    <span class="text-sm text-white/80">Active Account</span>
                </label>
            </div>
        </div>

        <div class="glass-panel rounded-2xl p-6">
            <h2 class="text-lg font-semibold text-white mb-4">Additional Info</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <p class="text-sm text-surface-200/40 mb-1">Phone</p>
                    <p class="text-white">{{ targetUser.phone|default('-') }}</p>
                </div>
                <div>
                    <p class="text-sm text-surface-200/40 mb-1">Apartment</p>
                    <p class="text-white">{{ targetUser.apartment|default('-') }}</p>
                </div>
                <div>
                    <p class="text-sm text-surface-200/40 mb-1">Emergency Contact</p>
                    <p class="text-white">{{ targetUser.emergency_contact_name|default('-') }}</p>
                </div>
                <div>
                    <p class="text-sm text-surface-200/40 mb-1">Emergency Phone</p>
                    <p class="text-white">{{ targetUser.emergency_contact_phone|default('-') }}</p>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary w-full !h-14 !text-base !rounded-xl">
            <i data-lucide="save" class="w-5 h-5"></i>
            Save Changes
        </button>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
