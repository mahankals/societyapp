{% extends "layouts/mobile.html.twig" %}

{% block title %}Maintenance Bills | SocietyApp{% endblock %}

{% block content %}
<div class="px-4 py-4">
    <div class="flex items-center gap-4 mb-4">
        <a href="/admin" class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5 text-white"></i>
        </a>
        <div>
            <h1 class="text-lg font-bold text-white">Maintenance Bills</h1>
            <p class="text-sm text-surface-200/40">Generate and manage bills</p>
        </div>
    </div>

    {% if flash %}
    <div class="mb-4 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="glass-panel rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-white">{{ stats.total }}</p>
            <p class="text-xs text-surface-200/60">Total Bills</p>
        </div>
        <div class="glass-panel rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-green-400">{{ stats.paid }}</p>
            <p class="text-xs text-surface-200/60">Paid</p>
        </div>
        <div class="glass-panel rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-red-400">{{ stats.pending }}</p>
            <p class="text-xs text-surface-200/60">Pending</p>
        </div>
        <div class="glass-panel rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-brand-400">₹{{ stats.paidAmount|number_format }}</p>
            <p class="text-xs text-surface-200/60">Collected</p>
        </div>
    </div>

    <form method="GET" class="mb-4 glass-panel rounded-xl p-4">
        <div class="flex gap-3">
            <select name="status" onchange="this.form.submit()" class="bg-white/5 border border-white/10 rounded-lg px-4 py-2 text-white text-sm">
                <option value="">All Status</option>
                <option value="paid" {% if statusFilter == 'paid' %}selected{% endif %}>Paid</option>
                <option value="pending" {% if statusFilter == 'pending' %}selected{% endif %}>Pending</option>
                <option value="overdue" {% if statusFilter == 'overdue' %}selected{% endif %}>Overdue</option>
            </select>
        </div>
    </form>

    <div class="glass-panel rounded-2xl p-6 mb-6">
        <h2 class="text-lg font-semibold text-white mb-4">Generate New Bill</h2>
        <form method="POST" action="/admin/bills" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
            <input type="number" name="user_id" placeholder="User ID" required
                class="h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50">
            <input type="number" name="amount" placeholder="Amount" step="0.01" required
                class="h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50">
            <input type="text" name="month" placeholder="YYYY-MM" required pattern="\d{4}-\d{2}"
                class="h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-brand-500/50">
            <input type="date" name="due_date" required
                class="h-12 bg-white/[0.03] border border-white/[0.08] rounded-xl px-4 text-white focus:outline-none focus:ring-2 focus:ring-brand-500/50">
            <button type="submit" class="btn-primary !h-12 !rounded-xl md:col-span-4">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Generate Bill
            </button>
        </form>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full glass-panel rounded-2xl overflow-hidden">
            <thead class="bg-white/5">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase">Bill #</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase">User</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase">Amount</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase">Month</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase">Due Date</th>
                    <th class="px-6 py-4 text-left text-xs font-medium text-surface-200/60 uppercase">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                {% for bill in bills %}
                <tr class="hover:bg-white/5">
                    <td class="px-6 py-4 text-white font-medium">{{ bill.bill_number }}</td>
                    <td class="px-6 py-4 text-surface-200/60">{{ bill.user_name }}</td>
                    <td class="px-6 py-4 text-white">₹{{ bill.amount }}</td>
                    <td class="px-6 py-4 text-surface-200/60">{{ bill.month }}</td>
                    <td class="px-6 py-4 text-surface-200/60">{{ bill.due_date|date('M d, Y') }}</td>
                    <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-lg text-xs font-medium
                            {% if bill.status == 'paid' %}bg-green-500/20 text-green-400
                            {% elseif bill.status == 'overdue' %}bg-red-500/20 text-red-400
                            {% else %}bg-yellow-500/20 text-yellow-400{% endif %}">
                            {{ bill.status|title }}
                        </span>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-surface-200/40">No bills found</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    lucide.createIcons();
</script>
{% endblock %}
