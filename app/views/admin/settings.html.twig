{% extends "layouts/mobile.html.twig" %}

{% block title %}System Settings | SocietyApp Admin{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">

    {% if flash %}
    <div class="mb-6 p-4 rounded-xl {% if flash.type == 'error' %}bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-400{% else %}bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        <span>{{ flash.message }}</span>
    </div>
    {% endif %}

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">System Settings &amp; Configuration</h1>
            <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Control platform infrastructure, branding, authentication, email delivery, and maintenance mode</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/admin" class="px-3.5 py-2 rounded-xl bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 border border-slate-200 dark:border-white/10 text-xs font-semibold text-slate-700 dark:text-surface-200 hover:text-slate-900 dark:hover:text-white transition-all shadow-sm">
                &larr; Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Layout: Left Vertical Tabs + Right Content Panels -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left Vertical Tabs -->
        <div class="lg:col-span-4">
            <div class="bg-white dark:bg-surface-900 rounded-2xl border border-slate-200 dark:border-white/10 shadow-sm p-3 space-y-1.5">
                <button type="button" onclick="switchSettingsTab('prerequisites')" id="tab-btn-prerequisites"
                    class="settings-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold transition-all">
                    <span class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-[11px]">1</span>
                        <span class="text-left">
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Prerequisites</span>
                            <span class="block text-[11px] text-slate-500 dark:text-surface-200/50 font-normal">Environment &amp; Extensions</span>
                        </span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-50"></i>
                </button>

                <button type="button" onclick="switchSettingsTab('database')" id="tab-btn-database"
                    class="settings-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold transition-all">
                    <span class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-lg bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-[11px]">2</span>
                        <span class="text-left">
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Database Setup</span>
                            <span class="block text-[11px] text-slate-500 dark:text-surface-200/50 font-normal">MySQL / MariaDB Connection</span>
                        </span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-50"></i>
                </button>

                <button type="button" onclick="switchSettingsTab('branding')" id="tab-btn-branding"
                    class="settings-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold transition-all">
                    <span class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-lg bg-purple-500/15 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-[11px]">3</span>
                        <span class="text-left">
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Branding</span>
                            <span class="block text-[11px] text-slate-500 dark:text-surface-200/50 font-normal">App Name, Tagline &amp; Theme</span>
                        </span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-50"></i>
                </button>

                <button type="button" onclick="switchSettingsTab('email')" id="tab-btn-email"
                    class="settings-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold transition-all">
                    <span class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-[11px]">4</span>
                        <span class="text-left">
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">SMTP Email</span>
                            <span class="block text-[11px] text-slate-500 dark:text-surface-200/50 font-normal">Mail Server &amp; Notifications</span>
                        </span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-50"></i>
                </button>

                <button type="button" onclick="switchSettingsTab('google')" id="tab-btn-google"
                    class="settings-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold transition-all">
                    <span class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-lg bg-rose-500/15 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold text-[11px]">5</span>
                        <span class="text-left">
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Google Sign-In</span>
                            <span class="block text-[11px] text-slate-500 dark:text-surface-200/50 font-normal">OAuth 2.0 Credentials</span>
                        </span>
                    </span>
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-50"></i>
                </button>

                <button type="button" onclick="switchSettingsTab('maintenance')" id="tab-btn-maintenance"
                    class="settings-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold transition-all">
                    <span class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-lg bg-orange-500/15 text-orange-600 dark:text-orange-400 flex items-center justify-center font-bold text-[11px]">6</span>
                        <span class="text-left">
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Maintenance Mode</span>
                            <span class="block text-[11px] text-slate-500 dark:text-surface-200/50 font-normal">Offline Banner &amp; Bypass</span>
                        </span>
                    </span>
                    {% if isMaintenanceOn %}
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                    {% else %}
                    <i data-lucide="chevron-right" class="w-4 h-4 opacity-50"></i>
                    {% endif %}
                </button>
            </div>
        </div>

        <!-- Right Content Panels -->
        <div class="lg:col-span-8">

            <!-- 1. PREREQUISITES PANEL -->
            <div id="settings-panel-prerequisites" class="settings-tab-panel">
                <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm space-y-6">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Server &amp; Environment Readiness</h2>
                        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Verifying that your runtime and PHP extensions meet platform requirements.</p>
                    </div>

                    <div class="space-y-3">
                        {% for key, pre in prerequisites %}
                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/5 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg {{ pre.status ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400' : 'bg-rose-500/15 text-rose-600 dark:text-rose-400' }} flex items-center justify-center">
                                    <i data-lucide="{{ pre.status ? 'check' : 'x' }}" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ pre.name }}</p>
                                    <p class="text-[11px] text-slate-500 dark:text-surface-200/50">{{ pre.status ? 'Requirement satisfied' : 'Action required' }}</p>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-lg text-xs font-mono font-semibold {{ pre.status ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-700 dark:text-rose-300 border border-rose-500/20' }}">
                                {{ pre.value }}
                            </span>
                        </div>
                        {% endfor %}
                    </div>

                    <div class="pt-4 border-t border-slate-100 dark:border-white/5 flex justify-end">
                        <button type="button" onclick="switchSettingsTab('database')" class="btn-primary !px-5 !py-2.5 text-xs font-semibold flex items-center gap-2">
                            <span>Continue to Database</span>
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. DATABASE SETUP PANEL -->
            <div id="settings-panel-database" class="settings-tab-panel hidden">
                <div class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Database Setup</h2>
                            <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">MySQL / MariaDB platform connection credentials</p>
                        </div>
                        <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 text-xs font-mono font-bold">
                            {{ diagnostics.databaseVersion }}
                        </span>
                    </div>

                    <div id="dbTestResult" class="hidden p-3.5 rounded-xl text-xs font-medium"></div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="relative">
                            <input type="text" id="db_host" value="{{ dbConfig.host }}" readonly placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-100 dark:bg-white/[0.03] border border-slate-300 dark:border-white/10 rounded-xl font-mono">
                            <label for="db_host" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Database Host
                            </label>
                        </div>

                        <div class="relative">
                            <input type="number" id="db_port" value="{{ dbConfig.port }}" readonly placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-100 dark:bg-white/[0.03] border border-slate-300 dark:border-white/10 rounded-xl font-mono">
                            <label for="db_port" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Port
                            </label>
                        </div>

                        <div class="relative">
                            <input type="text" id="db_name" value="{{ dbConfig.name }}" readonly placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-100 dark:bg-white/[0.03] border border-slate-300 dark:border-white/10 rounded-xl font-mono">
                            <label for="db_name" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Database Name
                            </label>
                        </div>

                        <div class="relative">
                            <input type="text" id="db_user" value="{{ dbConfig.user }}" readonly placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-100 dark:bg-white/[0.03] border border-slate-300 dark:border-white/10 rounded-xl font-mono">
                            <label for="db_user" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Username
                            </label>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-surface-200/50">Credentials managed in server <code>.env</code> file</span>
                        <button type="button" id="testDbBtn" onclick="testDatabaseConnection()" class="px-4 py-2 rounded-xl border border-brand-500/30 bg-brand-500/10 hover:bg-brand-500/20 text-brand-700 dark:text-brand-300 text-xs font-semibold flex items-center gap-2 transition-all">
                            <i data-lucide="zap" class="w-4 h-4"></i>
                            <span>Test DB Connection</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 3. BRANDING PANEL -->
            <div id="settings-panel-branding" class="settings-tab-panel hidden">
                <form id="brandingForm" action="/admin/settings" method="POST" class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm space-y-6">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="hidden" name="active_tab" value="branding">

                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Branding &amp; Identity</h2>
                        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Personalize application name, descriptions, and user interface preferences</p>
                    </div>

                    <div class="space-y-4">
                        <div class="relative">
                            <input type="text" id="app_name" name="app_name" value="{{ settings.app_name|default('SocietyApp') }}" required placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="app_name" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Application Name <span class="text-rose-500">*</span>
                            </label>
                        </div>

                        <div class="relative">
                            <textarea id="app_desc" name="app_desc" rows="2" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 resize-none">{{ settings.app_desc|default('The premium management platform for modern residential communities.') }}</textarea>
                            <label for="app_desc" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Application Description / Tagline
                            </label>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="relative">
                                <input type="email" id="support_email" name="support_email" value="{{ settings.support_email|default('support@societyapp.ddev.site') }}" placeholder=" "
                                    class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                                <label for="support_email" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                    Support Email
                                </label>
                            </div>

                            <div class="relative">
                                <select id="default_theme" name="default_theme"
                                    class="block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                                    <option value="system" {{ (settings.default_theme|default('system') == 'system') ? 'selected' : '' }}>System (Adaptive)</option>
                                    <option value="light" {{ (settings.default_theme|default('') == 'light') ? 'selected' : '' }}>Light Mode</option>
                                    <option value="dark" {{ (settings.default_theme|default('') == 'dark') ? 'selected' : '' }}>Dark Mode</option>
                                </select>
                                <label for="default_theme" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4">
                                    Default Color Theme
                                </label>
                            </div>
                        </div>

                        <div class="relative">
                            <input type="text" id="session_lifetime" name="session_lifetime" value="{{ settings.session_lifetime|default(diagnostics.sessionLifetime|default('60min')) }}" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="session_lifetime" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Session Lifetime (e.g. 60min, 120min, 24h)
                            </label>
                            <p class="text-[11px] text-slate-500 dark:text-surface-200/50 mt-1">Configures idle session expiration for logged-in users. Automatically updates <code>SESSION_LIFETIME</code> in server <code>.env</code>.</p>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100 dark:border-white/5 flex justify-end">
                        <button type="submit" id="saveBrandingBtn" disabled class="btn-primary !px-6 !py-2.5 text-xs font-semibold disabled:opacity-50 disabled:cursor-not-allowed">
                            Save Branding Changes
                        </button>
                    </div>
                </form>
            </div>

            <!-- 4. SMTP EMAIL PANEL -->
            <div id="settings-panel-email" class="settings-tab-panel hidden">
                <form id="emailForm" action="/admin/settings" method="POST" class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm space-y-6">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="hidden" name="active_tab" value="email">

                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">SMTP Email Server</h2>
                        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Outgoing mail transfer agent for billing notices, OTPs, and resident communications</p>
                    </div>

                    <div id="smtpTestResult" class="hidden p-3.5 rounded-xl text-xs font-medium"></div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="relative">
                            <input type="text" id="mail_host" name="mail_host" value="{{ settings.mail_host|default('localhost') }}" required placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="mail_host" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                SMTP Host <span class="text-rose-500">*</span>
                            </label>
                        </div>

                        <div class="relative">
                            <input type="number" id="mail_port" name="mail_port" value="{{ settings.mail_port|default(1025) }}" required placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="mail_port" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                SMTP Port <span class="text-rose-500">*</span>
                            </label>
                        </div>

                        <div class="relative">
                            <input type="text" id="mail_username" name="mail_username" value="{{ settings.mail_username|default('') }}" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="mail_username" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                SMTP Username
                            </label>
                        </div>

                        <div class="relative">
                            <input type="password" id="mail_password" name="mail_password" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="mail_password" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Password (leave blank to retain)
                            </label>
                        </div>

                        <div class="relative">
                            <input type="email" id="mail_from_address" name="mail_from_address" value="{{ settings.mail_from_address|default('noreply@societyapp.ddev.site') }}" required placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="mail_from_address" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Sender From Email <span class="text-rose-500">*</span>
                            </label>
                        </div>

                        <div class="relative">
                            <input type="text" id="mail_from_name" name="mail_from_name" value="{{ settings.mail_from_name|default('SocietyApp Notifications') }}" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="mail_from_name" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Sender From Name
                            </label>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100 dark:border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <input type="email" id="test_recipient_email" placeholder="recipient@example.com" value="{{ user.email }}"
                                class="px-3 py-2 text-xs text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono">
                            <button type="button" id="testSmtpBtn" onclick="testSmtpConnection()" class="px-3.5 py-2 rounded-xl border border-blue-500/30 bg-blue-500/10 hover:bg-blue-500/20 text-blue-700 dark:text-blue-300 text-xs font-semibold flex items-center gap-1.5 transition-all">
                                <i data-lucide="send" class="w-3.5 h-3.5"></i>
                                <span>Send Test Email</span>
                            </button>
                        </div>

                        <button type="submit" id="saveEmailBtn" disabled class="btn-primary !px-6 !py-2.5 text-xs font-semibold disabled:opacity-50 disabled:cursor-not-allowed">
                            Save Email Settings
                        </button>
                    </div>
                </form>
            </div>

            <!-- 5. GOOGLE SIGN-IN PANEL -->
            <div id="settings-panel-google" class="settings-tab-panel hidden">
                <form id="googleForm" action="/admin/settings" method="POST" class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm space-y-6">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="hidden" name="active_tab" value="google">

                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Google Sign-In Credentials</h2>
                        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Configure Google Cloud OAuth 2.0 Web Client credentials</p>
                    </div>

                    <div class="space-y-4">
                        <div class="relative">
                            <input type="text" id="google_client_id" name="google_client_id" value="{{ settings.google_client_id|default('') }}" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="google_client_id" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Google Client ID (.apps.googleusercontent.com)
                            </label>
                        </div>

                        <div class="relative">
                            <input type="password" id="google_client_secret" name="google_client_secret" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="google_client_secret" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Google Client Secret (leave blank to retain)
                            </label>
                        </div>

                        <div class="relative">
                            <input type="url" id="google_redirect_uri" name="google_redirect_uri" value="{{ settings.google_redirect_uri|default('https://societyapp.ddev.site/auth/google/callback') }}" readonly placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-600 dark:text-white/60 bg-slate-100 dark:bg-white/[0.02] border border-slate-200 dark:border-white/5 rounded-xl font-mono cursor-not-allowed">
                            <label for="google_redirect_uri" class="absolute text-xs text-slate-400 dark:text-slate-500 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4">
                                Authorized Redirect URI (Whitelist in Google Cloud Console)
                            </label>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100 dark:border-white/5 flex justify-end">
                        <button type="submit" id="saveGoogleBtn" disabled class="btn-primary !px-6 !py-2.5 text-xs font-semibold disabled:opacity-50 disabled:cursor-not-allowed">
                            Save Google Settings
                        </button>
                    </div>
                </form>
            </div>

            <!-- 6. MAINTENANCE MODE PANEL -->
            <div id="settings-panel-maintenance" class="settings-tab-panel hidden">
                <form id="maintenanceForm" action="/admin/settings" method="POST" class="bg-white dark:bg-surface-900 rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-white/10 shadow-sm space-y-6">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                    <input type="hidden" name="active_tab" value="maintenance">

                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Platform Maintenance Mode</h2>
                            <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Redirect public traffic to an offline splash page during scheduled infrastructure updates</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="maintenance_enabled" value="1" {{ isMaintenanceOn ? 'checked' : '' }} class="sr-only peer">
                            <div class="w-12 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-white/10 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                        </label>
                    </div>

                    <div class="space-y-4">
                        <div class="relative">
                            <input type="text" id="maintenance_title" name="maintenance_title" value="{{ maintenance.title|default('Scheduled System Maintenance') }}" required placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                            <label for="maintenance_title" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Notice Title
                            </label>
                        </div>

                        <div class="relative">
                            <textarea id="maintenance_message" name="maintenance_message" rows="3" placeholder=" "
                                class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50 resize-none">{{ maintenance.message|default('Our engineering team is performing scheduled improvements. Please check back shortly.') }}</textarea>
                            <label for="maintenance_message" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                Visitor Announcement Message
                            </label>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="relative">
                                <input type="text" id="maintenance_bypass_key" name="maintenance_bypass_key" value="{{ maintenance.bypass_key|default('') }}" placeholder=" "
                                    class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                                <label for="maintenance_bypass_key" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                    Secret Bypass Key (e.g. ?bypass=SECRET)
                                </label>
                            </div>

                            <div class="relative">
                                <input type="datetime-local" id="maintenance_estimated_end" name="maintenance_estimated_end" value="{{ maintenance.estimated_end|default('') }}" placeholder=" "
                                    class="peer block w-full px-4 pt-5 pb-2 text-sm text-slate-900 dark:text-white bg-slate-50 dark:bg-white/[0.04] border border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/50">
                                <label for="maintenance_estimated_end" class="absolute text-xs text-slate-500 dark:text-slate-400 duration-200 transform -translate-y-2.5 scale-75 top-4 z-10 origin-[0] start-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-2.5 peer-focus:text-brand-500">
                                    Estimated End Time
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100 dark:border-white/5 flex justify-end">
                        <button type="submit" id="saveMaintenanceBtn" disabled class="btn-primary !px-6 !py-2.5 text-xs font-semibold disabled:opacity-50 disabled:cursor-not-allowed">
                            Save Maintenance Settings
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
const VALID_SETTINGS_TABS = ['prerequisites', 'database', 'branding', 'email', 'google', 'maintenance'];

function switchSettingsTab(tab) {
    if (!VALID_SETTINGS_TABS.includes(tab)) tab = 'prerequisites';

    document.querySelectorAll('.settings-tab-panel').forEach(p => p.classList.add('hidden'));
    document.querySelectorAll('.settings-nav-btn').forEach(btn => {
        btn.className = "settings-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold transition-all text-slate-600 dark:text-surface-200/70 hover:bg-slate-50 dark:hover:bg-white/5 border border-transparent";
    });

    const activePanel = document.getElementById('settings-panel-' + tab);
    const activeBtn = document.getElementById('tab-btn-' + tab);
    if (activePanel) activePanel.classList.remove('hidden');
    if (activeBtn) {
        activeBtn.className = "settings-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-xl text-xs font-semibold transition-all bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/25";
    }

    const url = new URL(window.location.href);
    url.searchParams.set('tab', tab);
    window.history.replaceState({}, '', url);
}

function setupFormWatcher(formId, submitBtnId) {
    const form = document.getElementById(formId);
    const submitBtn = document.getElementById(submitBtnId);
    if (!form || !submitBtn) return;

    form.addEventListener('input', () => { submitBtn.disabled = false; });
    form.addEventListener('change', () => { submitBtn.disabled = false; });
    form.addEventListener('reset', () => { setTimeout(() => { submitBtn.disabled = true; }, 50); });
}

function testDatabaseConnection() {
    const btn = document.getElementById('testDbBtn');
    const resultBox = document.getElementById('dbTestResult');
    btn.disabled = true;
    btn.innerHTML = '<span class="inline-block animate-spin mr-1.5">⏳</span> Testing...';
    resultBox.classList.add('hidden');

    const formData = new FormData();
    formData.append('csrf_token', '{{ csrfToken }}');

    fetch('/admin/settings/test-db', {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.json())
    .then(data => {
        resultBox.classList.remove('hidden');
        if (data.success) {
            resultBox.className = 'p-3.5 rounded-xl text-xs font-medium bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300';
            resultBox.textContent = data.message;
        } else {
            resultBox.className = 'p-3.5 rounded-xl text-xs font-medium bg-rose-500/10 border border-rose-500/20 text-rose-800 dark:text-rose-300';
            resultBox.textContent = 'Connection failed: ' + (data.error || 'Unable to connect to database.');
        }
    })
    .catch(err => {
        resultBox.classList.remove('hidden');
        resultBox.className = 'p-3.5 rounded-xl text-xs font-medium bg-rose-500/10 border border-rose-500/20 text-rose-800 dark:text-rose-300';
        resultBox.textContent = 'Network error testing database connection.';
    })
    .finally(() => {
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="zap" class="w-4 h-4"></i><span>Test DB Connection</span>';
        if (window.lucide) { lucide.createIcons(); }
    });
}

function testSmtpConnection() {
    const btn = document.getElementById('testSmtpBtn');
    const resultBox = document.getElementById('smtpTestResult');
    const recipient = document.getElementById('test_recipient_email').value;

    btn.disabled = true;
    btn.innerHTML = '<span class="inline-block animate-spin mr-1.5">⏳</span> Testing...';
    resultBox.classList.add('hidden');

    const form = document.getElementById('emailForm');
    const formData = new FormData(form);
    formData.append('test_recipient_email', recipient);

    fetch('/admin/settings/test-email', {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.json())
    .then(data => {
        resultBox.classList.remove('hidden');
        if (data.success) {
            resultBox.className = 'p-3.5 rounded-xl text-xs font-medium bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300';
            resultBox.textContent = '✓ Test email dispatched successfully to ' + recipient;
        } else {
            resultBox.className = 'p-3.5 rounded-xl text-xs font-medium bg-rose-500/10 border border-rose-500/20 text-rose-800 dark:text-rose-300';
            resultBox.textContent = 'SMTP test failed: ' + (data.message || 'Unable to dispatch test email.');
        }
    })
    .catch(err => {
        resultBox.classList.remove('hidden');
        resultBox.className = 'p-3.5 rounded-xl text-xs font-medium bg-rose-500/10 border border-rose-500/20 text-rose-800 dark:text-rose-300';
        resultBox.textContent = 'Network error testing SMTP delivery.';
    })
    .finally(() => {
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="send" class="w-3.5 h-3.5"></i><span>Send Test Email</span>';
        if (window.lucide) { lucide.createIcons(); }
    });
}

document.addEventListener('DOMContentLoaded', function() {
    setupFormWatcher('brandingForm', 'saveBrandingBtn');
    setupFormWatcher('emailForm', 'saveEmailBtn');
    setupFormWatcher('googleForm', 'saveGoogleBtn');
    setupFormWatcher('maintenanceForm', 'saveMaintenanceBtn');

    const params = new URLSearchParams(window.location.search);
    const initialTab = params.get('tab') || '{{ activeTab|default("prerequisites") }}';
    switchSettingsTab(initialTab);

    if (window.lucide) { lucide.createIcons(); }
});
</script>
{% endblock %}
