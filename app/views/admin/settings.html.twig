{% extends "layouts/mobile.html.twig" %}

{% block title %}System Settings & Maintenance | SocietyApp Admin{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto px-4 sm:px-6">

    {% if flash %}
    <div class="mb-6 p-4 rounded-xl {% if flash.type == 'error' %}bg-red-500/10 border border-red-500/20 text-red-500 dark:text-red-400{% else %}bg-green-500/10 border border-green-500/20 text-green-600 dark:text-green-400{% endif %} text-sm flex items-center gap-3">
        <i data-lucide="{% if flash.type == 'error' %}alert-circle{% else %}check-circle{% endif %}" class="w-5 h-5 flex-shrink-0"></i>
        <span>{{ flash.message }}</span>
    </div>
    {% endif %}

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">System Settings & Configuration</h1>
            <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Control platform-wide maintenance mode, branding, email delivery, and server diagnostics</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/admin" class="px-3.5 py-2 rounded-xl bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 border border-slate-200 dark:border-white/10 text-xs font-medium text-slate-700 dark:text-surface-200 hover:text-slate-900 dark:hover:text-white transition-all shadow-sm">
                Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Hidden Form for Instant Maintenance Toggle -->
    <form id="toggle-maintenance-form" action="/admin/settings/toggle-maintenance" method="POST" class="hidden">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
    </form>

    <!-- Tab Navigation -->
    <div class="inline-flex items-center gap-1.5 p-1.5 rounded-2xl bg-slate-100 dark:bg-white/[0.04] border border-slate-200 dark:border-white/10 mb-6 shadow-sm overflow-x-auto max-w-full">
        <button type="button" data-tab="general" class="settings-tab-btn px-4 py-2 rounded-xl text-xs font-semibold inline-flex items-center gap-2 transition-all whitespace-nowrap {{ (activeTab|default('general') == 'general') ? 'bg-brand-500 shadow-md shadow-brand-500/25' : 'text-slate-600 dark:text-surface-200/70 hover:text-slate-900 dark:hover:text-white hover:bg-white/60 dark:hover:bg-white/5' }}" {% if (activeTab|default('general') == 'general') %}style="color: #ffffff !important;"{% endif %}>
            <i data-lucide="sliders" class="w-4 h-4"></i>
            <span>General</span>
        </button>
        <button type="button" data-tab="email" class="settings-tab-btn px-4 py-2 rounded-xl text-xs font-semibold inline-flex items-center gap-2 transition-all whitespace-nowrap {{ (activeTab|default('general') == 'email') ? 'bg-brand-500 shadow-md shadow-brand-500/25' : 'text-slate-600 dark:text-surface-200/70 hover:text-slate-900 dark:hover:text-white hover:bg-white/60 dark:hover:bg-white/5' }}" {% if (activeTab|default('general') == 'email') %}style="color: #ffffff !important;"{% endif %}>
            <i data-lucide="mail" class="w-4 h-4"></i>
            <span>Email</span>
        </button>
        <button type="button" data-tab="maintenance" class="settings-tab-btn px-4 py-2 rounded-xl text-xs font-semibold inline-flex items-center gap-2 transition-all whitespace-nowrap {{ (activeTab|default('general') == 'maintenance') ? 'bg-brand-500 shadow-md shadow-brand-500/25' : 'text-slate-600 dark:text-surface-200/70 hover:text-slate-900 dark:hover:text-white hover:bg-white/60 dark:hover:bg-white/5' }}" {% if (activeTab|default('general') == 'maintenance') %}style="color: #ffffff !important;"{% endif %}>
            <i data-lucide="wrench" class="w-4 h-4"></i>
            <span>Maintenance</span>
            {% if isMaintenanceOn %}
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse ml-0.5"></span>
            {% endif %}
        </button>
    </div>

    <!-- Main Settings Form -->
    <form action="/admin/settings" method="POST" id="settings-form">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        <input type="hidden" name="active_tab" id="active_tab_input" value="{{ activeTab|default('general') }}">

        <!-- ==================== TAB PANEL 1: GENERAL ==================== -->
        <div id="tab-panel-general" class="space-y-6 {{ (activeTab|default('general') == 'general') ? '' : 'hidden' }}">
            <div class="glass-panel rounded-2xl p-6 border border-slate-200 dark:border-white/10 shadow-xl">
                <div class="flex items-center gap-3 pb-5 mb-5 border-b border-slate-200 dark:border-white/10">
                    <div class="w-10 h-10 rounded-xl bg-brand-500/15 text-brand-500 dark:text-brand-400 border border-brand-500/25 flex items-center justify-center shrink-0 shadow-sm">
                        <i data-lucide="sliders" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-slate-900 dark:text-white">General Platform Configuration</h2>
                        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Branding, platform metadata, and interface preferences</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Application Name</label>
                        <input type="text" name="app_name" value="{{ settings.app_name|default('SocietyApp') }}" class="input-glass" required>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Support Email</label>
                        <input type="email" name="support_email" value="{{ settings.support_email|default('support@societyapp.ddev.site') }}" class="input-glass">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Default Theme</label>
                        <select name="default_theme" class="input-glass">
                            <option value="system" {{ (settings.default_theme|default('system') == 'system') ? 'selected' : '' }}>System (Default)</option>
                            <option value="light" {{ (settings.default_theme|default('') == 'light') ? 'selected' : '' }}>Light Mode</option>
                            <option value="dark" {{ (settings.default_theme|default('') == 'dark') ? 'selected' : '' }}>Dark Mode</option>
                        </select>
                    </div>
                </div>

                <div class="mb-5">
                    <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Application Description / Tagline</label>
                    <input type="text" name="app_desc" value="{{ settings.app_desc|default('The premium management platform for modern residential communities.') }}" class="input-glass">
                    <p class="text-[11px] text-slate-500 dark:text-surface-200/40 mt-1">Default tagline used across social media link previews, WhatsApp metadata, and app headers.</p>
                </div>
            </div>

            <!-- Server Diagnostics Card -->
            <div class="glass-panel rounded-2xl p-6 border border-slate-200 dark:border-white/10">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                    <i data-lucide="activity" class="w-4 h-4 text-purple-500"></i>
                    <span>Server & Environment Diagnostics</span>
                </h3>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5">
                        <span class="text-[11px] text-slate-500 dark:text-surface-200/50 block">PHP Version</span>
                        <strong class="text-xs text-slate-900 dark:text-white font-mono mt-1 block">{{ diagnostics.phpVersion }}</strong>
                    </div>
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5">
                        <span class="text-[11px] text-slate-500 dark:text-surface-200/50 block">Database</span>
                        <strong class="text-xs text-emerald-600 dark:text-emerald-400 font-mono mt-1 block truncate">{{ diagnostics.databaseVersion }}</strong>
                    </div>
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5">
                        <span class="text-[11px] text-slate-500 dark:text-surface-200/50 block">.env File</span>
                        <strong class="text-xs {{ diagnostics.envFileExists ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400' }} mt-1 block">
                            {{ diagnostics.envFileExists ? 'Present (Active)' : 'Missing' }}
                        </strong>
                    </div>
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5">
                        <span class="text-[11px] text-slate-500 dark:text-surface-200/50 block">.maintenance File</span>
                        <strong class="text-xs {{ diagnostics.maintenanceFileExists ? 'text-amber-600 dark:text-amber-400' : 'text-slate-500 dark:text-surface-200/50' }} mt-1 block">
                            {{ diagnostics.maintenanceFileExists ? 'Present (Active)' : 'Not present' }}
                        </strong>
                    </div>
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5">
                        <span class="text-[11px] text-slate-500 dark:text-surface-200/50 block">Session Lifetime</span>
                        <strong class="text-xs text-slate-900 dark:text-white mt-1 block">{{ diagnostics.sessionLifetime }}</strong>
                    </div>
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5">
                        <span class="text-[11px] text-slate-500 dark:text-surface-200/50 block">Server Software</span>
                        <strong class="text-xs text-slate-700 dark:text-surface-200/80 mt-1 block truncate">{{ diagnostics.serverSoftware }}</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== TAB PANEL 2: EMAIL ==================== -->
        <div id="tab-panel-email" class="space-y-6 {{ (activeTab|default('general') == 'email') ? '' : 'hidden' }}">
            <div class="glass-panel rounded-2xl p-6 border border-slate-200 dark:border-white/10 shadow-xl">
                <div class="flex items-center gap-3 pb-5 mb-5 border-b border-slate-200 dark:border-white/10">
                    <div class="w-10 h-10 rounded-xl bg-blue-500/15 text-blue-500 dark:text-blue-400 border border-blue-500/25 flex items-center justify-center shrink-0 shadow-sm">
                        <i data-lucide="mail" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-slate-900 dark:text-white">Email & SMTP Delivery</h2>
                        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Configure outgoing mail server for resident invitations, OTPs, and notifications</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">SMTP Host</label>
                        <input type="text" name="mail_host" value="{{ settings.mail_host|default('127.0.0.1') }}" class="input-glass">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">SMTP Port</label>
                        <input type="text" name="mail_port" value="{{ settings.mail_port|default('1025') }}" class="input-glass">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">SMTP Username</label>
                        <input type="text" name="mail_username" value="{{ settings.mail_username|default('') }}" class="input-glass" placeholder="(Optional for Mailpit)">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">SMTP Password</label>
                        <input type="password" name="mail_password" value="" class="input-glass" placeholder="Leave empty to keep existing">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">From Address</label>
                        <input type="email" name="mail_from_address" value="{{ settings.mail_from_address|default('no-reply@societyapp.ddev.site') }}" class="input-glass">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">From Display Name</label>
                        <input type="text" name="mail_from_name" value="{{ settings.mail_from_name|default('SocietyApp Notifications') }}" class="input-glass">
                    </div>
                </div>

                <div class="p-4 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5 flex items-start gap-3 text-xs text-slate-600 dark:text-surface-200/70">
                    <i data-lucide="info" class="w-4 h-4 text-brand-500 shrink-0 mt-0.5"></i>
                    <div>
                        <strong class="text-slate-900 dark:text-white">SMTP Relay Tip:</strong> In local development with DDEV, emails are trapped by Mailpit at port 1025. For production deployments, enter your authenticated SMTP credentials (e.g. Gmail App Password, SendGrid, Amazon SES).
                    </div>
                </div>
            </div>

            <!-- Send Test Email Card -->
            <div class="glass-panel rounded-2xl p-6 border border-slate-200 dark:border-white/10 shadow-xl">
                <div class="flex items-center gap-3 pb-4 mb-4 border-b border-slate-200 dark:border-white/10">
                    <div class="w-10 h-10 rounded-xl bg-purple-500/15 text-purple-600 dark:text-purple-400 border border-purple-500/25 flex items-center justify-center shrink-0 shadow-sm">
                        <i data-lucide="send" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white">Send Test Email</h3>
                        <p class="text-xs text-slate-500 dark:text-surface-200/60 mt-0.5">Verify your SMTP connection and test live email deliverability</p>
                    </div>
                </div>

                <div id="test-email-alert" class="hidden mb-4 p-4 rounded-xl text-xs flex items-start gap-3">
                    <i id="test-email-alert-icon" data-lucide="info" class="w-4 h-4 shrink-0 mt-0.5"></i>
                    <div id="test-email-alert-text" class="flex-1 font-medium leading-relaxed"></div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Recipient Email Address</label>
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                            <div class="flex-1">
                                <input type="email" id="test_recipient_email" name="test_recipient_email" value="{{ user.email|default('admin@societyapp.ddev.site') }}" placeholder="recipient@example.com" class="input-glass">
                            </div>
                            <button type="button" id="btn-send-test-email" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-xs font-bold transition-all inline-flex items-center justify-center gap-2 whitespace-nowrap shadow-md shadow-blue-600/25 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" style="color: #ffffff !important;">
                                <i data-lucide="send" class="w-4 h-4 shrink-0"></i>
                                <span id="btn-send-test-email-label">Send Test Email</span>
                            </button>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-500 dark:text-surface-200/50">
                        This sends a verification message using the SMTP credentials provided above. Any unsaved edits in the form fields above will also be tested.
                    </p>
                </div>
            </div>
        </div>

        <!-- ==================== TAB PANEL 3: MAINTENANCE ==================== -->
        <div id="tab-panel-maintenance" class="space-y-6 {{ (activeTab|default('general') == 'maintenance') ? '' : 'hidden' }}">
            <!-- Master Status Banner -->
            <div class="glass-panel rounded-2xl p-6 border {% if isMaintenanceOn %}border-amber-500/40 bg-amber-500/[0.04]{% else %}border-emerald-500/30 bg-emerald-500/[0.02]{% endif %} shadow-xl transition-all">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 pb-6 border-b border-slate-200 dark:border-white/10">
                    <div class="flex items-start gap-3.5 min-w-0 flex-1">
                        <div class="w-11 h-11 rounded-2xl shrink-0 {% if isMaintenanceOn %}bg-amber-500/15 text-amber-500 dark:text-amber-400 border border-amber-500/30{% else %}bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30{% endif %} flex items-center justify-center shadow-sm">
                            <i data-lucide="{% if isMaintenanceOn %}wrench{% else %}shield-check{% endif %}" class="w-5 h-5"></i>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2.5">
                                <h2 class="text-base font-bold text-slate-900 dark:text-white">Maintenance Mode Status</h2>
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider whitespace-nowrap shrink-0 {% if isMaintenanceOn %}bg-amber-500/15 text-amber-600 dark:text-amber-300 border border-amber-500/30{% else %}bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30{% endif %}">
                                    <span class="w-2 h-2 rounded-full shrink-0 {% if isMaintenanceOn %}bg-amber-500 animate-pulse{% else %}bg-emerald-500{% endif %}"></span>
                                    <span>{{ isMaintenanceOn ? 'ACTIVE (RESTRICTED)' : 'INACTIVE (SITE LIVE)' }}</span>
                                </span>
                            </div>
                            <p class="text-xs text-slate-600 dark:text-surface-200/70 mt-1 max-w-2xl leading-relaxed">
                                {% if isMaintenanceOn %}
                                <strong class="text-amber-600 dark:text-amber-300">Only Administrator accounts can log in and browse admin tools.</strong> All regular resident portals, committee routes, and dashboard pages redirect to the maintenance screen. The public landing page remains visible.
                                {% else %}
                                The platform is fully live. All residents, committee members, and visitors can access their accounts normally.
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <!-- Instant Toggle & Preview Buttons -->
                    <div class="shrink-0 sm:self-center flex flex-wrap items-center gap-2.5">
                        <a href="/maintenance" target="_blank" class="px-4 py-2.5 rounded-xl bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 border border-slate-200 dark:border-white/10 text-xs font-semibold text-slate-800 dark:text-white inline-flex items-center gap-2 transition-all shadow-sm">
                            <i data-lucide="external-link" class="w-4 h-4 text-brand-500"></i>
                            <span>Preview Maintenance Page</span>
                        </a>
                        <button type="submit" form="toggle-maintenance-form" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all inline-flex items-center justify-center gap-2 whitespace-nowrap {% if isMaintenanceOn %}bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-600/30{% else %}bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold shadow-md shadow-amber-500/30{% endif %}" {% if isMaintenanceOn %}style="color: #ffffff !important;"{% endif %}>
                            <i data-lucide="power" class="w-4 h-4 shrink-0"></i>
                            <span>{{ isMaintenanceOn ? 'Switch OFF Maintenance Mode' : 'Switch ON Maintenance Mode' }}</span>
                        </button>
                    </div>
                </div>

                <!-- Maintenance Form Fields -->
                <div class="pt-6">
                    <div class="mb-5 flex items-center justify-between p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-200/70 dark:border-white/10">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" id="maintenance_enabled" name="maintenance_enabled" value="1" {{ isMaintenanceOn ? 'checked' : '' }} class="w-4 h-4 rounded text-brand-500 focus:ring-brand-500 bg-white dark:bg-white/10 border-slate-300 dark:border-white/20">
                            <label for="maintenance_enabled" class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-white cursor-pointer select-none">
                                Keep Maintenance Mode Enabled upon saving
                            </label>
                        </div>
                        <span class="text-[11px] text-slate-500 dark:text-surface-200/50">Stored in <code class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-black/40 text-slate-800 dark:text-surface-200">.maintenance</code></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Maintenance Notice Title</label>
                            <input type="text" name="maintenance_title" value="{{ maintenance.title|default('Scheduled System Maintenance') }}" class="input-glass" placeholder="e.g. Scheduled System Upgrade">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Estimated Resumption Time (Optional)</label>
                            <input type="text" name="maintenance_estimated_end" value="{{ maintenance.estimated_end|default('') }}" class="input-glass" placeholder="e.g. 10 Oct, 04:00 AM IST or Within 30 Mins">
                            <p class="text-[10px] text-slate-500 dark:text-surface-200/40 mt-1">Leave empty if unconfirmed. When left blank, no Estimated Resumption card will be shown.</p>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Resident Announcement Message</label>
                        <textarea name="maintenance_message" rows="3" class="input-glass" placeholder="Enter message explaining the maintenance reasons...">{{ maintenance.message|default('Our engineering team is performing scheduled infrastructure improvements and database optimizations. Normal operations will resume shortly.') }}</textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Developer Secret Bypass Key (Optional)</label>
                            <input type="text" name="maintenance_bypass_key" value="{{ maintenance.bypass_key|default('') }}" class="input-glass font-mono text-xs" placeholder="e.g. secret_bypass_2026">
                            <p class="text-[10px] text-slate-500 dark:text-surface-200/40 mt-1">Allows visiting any URL with <code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-black/40 text-brand-600 dark:text-brand-300">?bypass=YOUR_KEY</code> to test pages during maintenance.</p>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 dark:text-surface-200/80 mb-1.5">Interactive Skyline Arcade Game</label>
                            <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-200/70 dark:border-white/10 flex items-center justify-between">
                                <span class="text-xs text-slate-800 dark:text-white flex items-center gap-2">
                                    <span>🕹️</span>
                                    <span>Skyline Arcade with Fullscreen</span>
                                </span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-brand-500/15 text-brand-600 dark:text-brand-300 border border-brand-500/25">Active</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit & Actions Footer -->
        <div class="mt-8 pt-5 border-t border-slate-200 dark:border-white/10 flex items-center justify-end gap-3">
            <a href="/admin" class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-white/5 hover:bg-slate-200 dark:hover:bg-white/10 text-xs font-medium text-slate-700 dark:text-surface-200 hover:text-slate-900 dark:hover:text-white transition-all">
                Cancel
            </a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 !text-white text-xs font-bold shadow-md shadow-brand-500/20 transition-all flex items-center gap-2" style="color: #ffffff !important;">
                <i data-lucide="check" class="w-4 h-4"></i>
                <span>Save All Settings</span>
            </button>
        </div>
    </form>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const tabBtns = document.querySelectorAll('.settings-tab-btn');
    const tabPanels = {
        general: document.getElementById('tab-panel-general'),
        email: document.getElementById('tab-panel-email'),
        maintenance: document.getElementById('tab-panel-maintenance')
    };
    const activeTabInput = document.getElementById('active_tab_input');

    function switchTab(tabName) {
        if (!tabPanels[tabName]) tabName = 'general';

        tabBtns.forEach(btn => {
            const isTarget = btn.getAttribute('data-tab') === tabName;
            if (isTarget) {
                btn.className = 'settings-tab-btn px-4 py-2 rounded-xl text-xs font-semibold inline-flex items-center gap-2 transition-all whitespace-nowrap bg-brand-500 shadow-md shadow-brand-500/25';
                btn.style.color = '#ffffff';
            } else {
                btn.className = 'settings-tab-btn px-4 py-2 rounded-xl text-xs font-semibold inline-flex items-center gap-2 transition-all whitespace-nowrap text-slate-600 dark:text-surface-200/70 hover:text-slate-900 dark:hover:text-white hover:bg-white/60 dark:hover:bg-white/5';
                btn.style.color = '';
            }
        });

        Object.keys(tabPanels).forEach(key => {
            if (tabPanels[key]) {
                if (key === tabName) {
                    tabPanels[key].classList.remove('hidden');
                } else {
                    tabPanels[key].classList.add('hidden');
                }
            }
        });

        if (activeTabInput) {
            activeTabInput.value = tabName;
        }

        const url = new URL(window.location);
        url.searchParams.set('tab', tabName);
        window.history.replaceState({}, '', url);

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    tabBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const target = this.getAttribute('data-tab');
            switchTab(target);
        });
    });

    // Check URL query param or hash on initial load
    const urlParams = new URLSearchParams(window.location.search);
    const hash = window.location.hash.replace('#', '');
    const initialTab = urlParams.get('tab') || (hash && tabPanels[hash] ? hash : null);
    if (initialTab && tabPanels[initialTab]) {
        switchTab(initialTab);
    }

    // Test Email Sending Handler
    const testEmailBtn = document.getElementById('btn-send-test-email');
    const testEmailLabel = document.getElementById('btn-send-test-email-label');
    const testRecipientInput = document.getElementById('test_recipient_email');
    const testAlert = document.getElementById('test-email-alert');
    const testAlertText = document.getElementById('test-email-alert-text');
    const testAlertIcon = document.getElementById('test-email-alert-icon');

    function showEmailAlert(isSuccess, message) {
        if (!testAlert || !testAlertText) return;
        testAlert.classList.remove('hidden');
        if (isSuccess) {
            testAlert.className = 'mb-4 p-4 rounded-xl text-xs flex items-start gap-3 bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-300';
            if (testAlertIcon) testAlertIcon.setAttribute('data-lucide', 'check-circle');
        } else {
            testAlert.className = 'mb-4 p-4 rounded-xl text-xs flex items-start gap-3 bg-red-500/10 border border-red-500/25 text-red-600 dark:text-red-400';
            if (testAlertIcon) testAlertIcon.setAttribute('data-lucide', 'alert-triangle');
        }
        testAlertText.textContent = message;
        if (window.lucide) window.lucide.createIcons();
    }

    if (testEmailBtn) {
        testEmailBtn.addEventListener('click', async function() {
            const recipient = (testRecipientInput ? testRecipientInput.value : '').trim();
            if (!recipient) {
                showEmailAlert(false, 'Please enter a valid recipient email address.');
                return;
            }

            const formData = new FormData();
            formData.append('csrf_token', '{{ csrfToken }}');
            formData.append('test_recipient_email', recipient);

            const form = document.getElementById('settings-form');
            if (form) {
                ['mail_host', 'mail_port', 'mail_username', 'mail_password', 'mail_from_address', 'mail_from_name'].forEach(name => {
                    const el = form.querySelector(`[name="${name}"]`);
                    if (el) formData.append(name, el.value);
                });
            }

            testEmailBtn.disabled = true;
            if (testEmailLabel) testEmailLabel.textContent = 'Sending...';
            if (testAlert) testAlert.classList.add('hidden');

            try {
                const res = await fetch('/admin/settings/test-email', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    showEmailAlert(true, data.message || 'Test email dispatched successfully! Check recipient inbox or Mailpit.');
                } else {
                    showEmailAlert(false, data.message || 'Failed to dispatch test email.');
                }
            } catch (err) {
                showEmailAlert(false, 'Network or server error while sending test email: ' + err.message);
            } finally {
                testEmailBtn.disabled = false;
                if (testEmailLabel) testEmailLabel.textContent = 'Send Test Email';
                if (window.lucide) window.lucide.createIcons();
            }
        });
    }
});
</script>
{% endblock %}
