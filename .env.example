# ===========================================
# SocietyApp Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_URL=http://societyapp.localhost.test

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=societyapp
DB_USER=root
DB_PASS=

# --- Docker Database (uncomment when using docker) ---
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=societyapp
# DB_USER=societyapp
# DB_PASS=societyapp
# DB_ROOT_PASS=root

# --- Google OAuth --- (optional - for Google Sign In)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Session ---
SESSION_LIFETIME=3600

# --- Docker Ports ---
APP_PORT=8080
DB_PORT=3306
MAIL_PORT=1025
MAIL_UI_PORT=8025
